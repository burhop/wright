# LLM API configuration. Leave these blank when using WRIGHT_LLM_CONFIG_FILE
# or the browser setup flow.
LLM_API_URL=https://your-llm-endpoint/v1
LLM_API_KEY=sk-your-key-here
LLM_API_MODEL=your-default-model

# Optional provider seed for repeatable Docker tests. Mount the file read-only
# and point this variable at the path inside the container.
# WRIGHT_LLM_CONFIG_FILE=/run/secrets/wright/llm-seed.yaml
# WRIGHT_LLM_PROVIDER=openai-codex
# WRIGHT_LLM_AUTH_FILE=/run/secrets/wright/hermes-auth.json

# Application Environment (development, production)
WRIGHT_ENV=production
WRIGHT_API_TOKEN=replace-with-output-of-openssl-rand-hex-32
WRIGHT_AUTH_MODE=enforced
# Add the exact LAN URL, for example http://192.168.1.163:8080, when binding
# the container for remote browser access.
WRIGHT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
WRIGHT_SECRETS_PATH=/home/agent/.config/wright/credentials.json
# Optional read-only mounted secret directory
WRIGHT_SECRETS_DIR=/run/secrets/wright

# UI Theme Config (light, dark)
UI_THEME=dark
