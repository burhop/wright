      "required": true,
      "title": "Truthful execution modes and provenance",
      "evaluator": "EVAL_PROD_03",
      "assertions": [
        {
          "assertion_id": "PROD-03-A01",
          "requirement": "Validate-only, fixture, unconnected, and live modes are unmistakable in UI/history/export/dashboard; current-run evidence alone drives findings; no fixture-specific semantic result is applied to arbitrary input."
        }
      ],
      "freshness": {
        "maximum_age_seconds": 86400,
        "invalidation_triggers": [
