      "evaluator": "EVAL_PROD_04",
      "assertions": [
        {
          "assertion_id": "PROD-04-A01",
          "requirement": "Definition, preflight, semantic needs-input, mapping/schema, approval, execution, outcome, and cleanup are distinct; dependents report why they did not run; each non-success has a bounded recovery or explicit external intervention."
        }
