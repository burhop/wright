{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/oracle-manifest.schema.json",
  "title": "Engineering Process Oracle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "oracle_id", "revision", "status", "process_id", "process_revision",
    "input_set_digest", "expected_output_refs", "applicability", "authoritative_sources",
    "invariants", "positive_controls", "negative_controls", "uncertainty_policy",
    "disagreement_policy", "quarantine_policy", "authors", "approval", "content_digest",
    "observed_at", "maximum_age_hours", "stale_triggers"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "oracle_id": { "type": "string", "pattern": "^ORC-[A-Za-z0-9._:-]{3,160}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "reviewed", "approved", "stale", "quarantined", "rejected", "retired"] },
    "process_id": { "type": "string", "pattern": "^PROC-[0-9]{3}$" },
    "process_revision": { "type": "integer", "minimum": 1 },
    "input_set_digest": { "$ref": "#/$defs/digest" },
    "expected_output_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "disallowed_conditions", "supported_profiles"],
      "properties": {
        "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "disallowed_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supported_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "authoritative_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "authority", "revision", "locator_or_record", "license_id", "content_digest"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "locator_or_record": { "type": "string", "minLength": 1 },
          "license_id": { "type": "string", "minLength": 1 },
          "content_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "description", "output_refs", "assertion_type", "units", "coordinate_system", "tolerance", "validator"],
        "properties": {
          "invariant_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "output_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "assertion_type": { "enum": ["exact", "schema", "semantic", "geometric", "topological", "numerical", "metamorphic", "reference_tool", "qualified_human"] },
          "units": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
          "coordinate_system": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
          "tolerance": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["expression", "rationale"],
                "properties": {
                  "expression": { "type": "string", "minLength": 1 },
                  "rationale": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "validator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "positive_controls": { "$ref": "#/$defs/controls" },
    "negative_controls": { "$ref": "#/$defs/controls" },
    "uncertainty_policy": { "type": "string", "minLength": 1 },
    "disagreement_policy": { "type": "string", "minLength": 1 },
    "quarantine_policy": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_author", "expected_result_author", "independent_reviewer", "independence_attested", "conflicts"],
      "properties": {
        "oracle_author": { "type": "string", "minLength": 1 },
        "expected_result_author": { "type": "string", "minLength": 1 },
        "independent_reviewer": { "type": "string", "minLength": 1 },
        "independence_attested": { "const": true },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "record_digest", "decision", "approved_subject_digest"],
      "properties": {
        "record": { "type": "string", "minLength": 1 },
        "record_digest": { "$ref": "#/$defs/digest" },
        "decision": { "enum": ["approved", "approved_with_conditions", "rejected"] },
        "approved_subject_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "content_digest": { "$ref": "#/$defs/digest" },
    "observed_at": { "type": "string", "format": "date-time" },
    "maximum_age_hours": { "type": "integer", "minimum": 1, "maximum": 8760 },
    "stale_triggers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "input_digest", "expected_detection", "validator_digest", "evidence_digest", "result"],
        "properties": {
          "control_id": { "type": "string", "minLength": 1 },
          "input_digest": { "$ref": "#/$defs/digest" },
          "expected_detection": { "type": "string", "minLength": 1 },
          "validator_digest": { "$ref": "#/$defs/digest" },
          "evidence_digest": { "$ref": "#/$defs/digest" },
          "result": { "enum": ["passed", "failed", "not_tested", "inconclusive"] }
        }
      }
    }
  }
}
