{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/epp-f02-verification-evidence.schema.json",
  "title": "EPP-F02 Process Definition View Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "program_id", "feature_id", "kind", "subject", "actor", "created_at", "verdict", "checks", "original_failure_refs", "findings", "rollback_subject", "delivery_relation"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "evidence_id": { "type": "string", "pattern": "^VER-EPP-F02-[A-Z0-9-]{2,80}$" },
    "program_id": { "const": "EPP-2026" },
    "feature_id": { "const": "EPP-F02" },
    "kind": { "enum": ["candidate", "independent"] },
    "subject": { "$ref": "#/$defs/subject" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role", "independent"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "enum": ["feature_owner", "independent_verifier"] },
        "independent": { "type": "boolean" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["passed", "failed", "blocked", "inconclusive"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "method", "environment", "duration_ms", "result", "evidence"],
        "properties": {
          "check_id": { "$ref": "#/$defs/code" },
          "method": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "environment": { "type": "string", "minLength": 1, "maxLength": 500 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "result": { "enum": ["passed", "failed", "blocked", "skipped", "not_tested", "inconclusive"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
        }
      }
    },
    "original_failure_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "artifact", "disposition"],
        "properties": {
          "code": { "$ref": "#/$defs/code" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "artifact": { "type": "string", "minLength": 1, "maxLength": 500 },
          "disposition": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "rollback_subject": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "delivery_relation": { "type": "null" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "candidate" } }, "required": ["kind"] },
      "then": { "properties": { "actor": { "properties": { "role": { "const": "feature_owner" }, "independent": { "const": false } } } } },
      "else": { "properties": { "actor": { "properties": { "role": { "const": "independent_verifier" }, "independent": { "const": true } } } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,99}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "git_tree", "artifact_digests"],
      "properties": {
        "git_commit": { "$ref": "#/$defs/commit" },
        "git_tree": { "$ref": "#/$defs/commit" },
        "artifact_digests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    }
  }
}
