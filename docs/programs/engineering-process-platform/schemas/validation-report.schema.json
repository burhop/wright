{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/validation-report.schema.json",
  "title": "Engineering Process Platform Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "validator", "observed_at", "subject", "verdict", "checks", "findings", "eligibility", "areas", "benchmark_summary", "release_approval", "release_eligible", "delivery", "next_action"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "program_id": { "const": "EPP-2026" },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "bundle_manifest_digest", "bundle_manifest"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bundle_manifest_digest": { "$ref": "#/$defs/digest" },
        "bundle_manifest": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/bundleArtifact" } }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/validationSubject" },
    "verdict": { "enum": ["passed", "failed", "blocked"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": { "$ref": "#/$defs/code" },
          "result": { "enum": ["passed", "failed", "blocked", "not_run"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "artifact", "invariant", "evidence", "consequence", "recovery"],
        "properties": {
          "code": { "$ref": "#/$defs/code" },
          "severity": { "enum": ["fatal", "error", "warning", "info"] },
          "artifact": { "type": "string", "minLength": 1, "maxLength": 500 },
          "invariant": { "$ref": "#/$defs/code" },
          "evidence": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 300 } },
          "consequence": { "type": "string", "minLength": 1, "maxLength": 500 },
          "recovery": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmap_item", "allowed_actions", "blockers"],
      "properties": {
        "roadmap_item": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^EPP-[A-Z0-9-]+$" }] },
        "allowed_actions": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/code" } }
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_readiness", "benchmark_readiness", "commercial_readiness", "program_health"],
      "properties": {
        "product_readiness": { "$ref": "#/$defs/area" },
        "benchmark_readiness": { "$ref": "#/$defs/area" },
        "commercial_readiness": { "$ref": "#/$defs/area" },
        "program_health": { "$ref": "#/$defs/area" }
      }
    },
    "benchmark_summary": { "$ref": "#/$defs/benchmarkSummary" },
    "release_approval": { "$ref": "#/$defs/releaseApproval" },
    "release_eligible": { "type": "boolean" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "target_changed", "prior_snapshot_preserved", "container_resolution", "container_commit", "delivery_resolution", "delivery_commit", "evidence_record"],
      "properties": {
        "mode": { "enum": ["validate", "generate_dashboard"] },
        "status": { "enum": ["not_requested", "candidate_not_evidence", "committed_valid", "stale", "failed"] },
        "target_changed": { "type": "boolean" },
        "prior_snapshot_preserved": { "type": "boolean" },
        "container_resolution": { "enum": ["absent", "explicit", "inferred_head", "unresolved"] },
        "container_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "delivery_resolution": { "enum": ["absent", "explicit", "unresolved"] },
        "delivery_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "evidence_record": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] }
      }
    },
    "next_action": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "requires_human_approval", "reason"],
          "properties": {
            "action": { "$ref": "#/$defs/code" },
            "requires_human_approval": { "type": "boolean" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "passed" } } },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "resolution_status": { "const": "resolved" },
              "source_commit": { "$ref": "#/$defs/commit" },
              "source_tree": { "$ref": "#/$defs/commit" },
              "program_tree": { "$ref": "#/$defs/commit" },
              "input_manifest_digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "delivery": { "properties": { "status": { "const": "committed_valid" } }, "required": ["status"] } } },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "container_commit": { "$ref": "#/$defs/commit" },
              "delivery_resolution": { "const": "explicit" },
              "delivery_commit": { "$ref": "#/$defs/commit" }
            }
          },
          "delivery": {
            "properties": {
              "container_resolution": { "enum": ["explicit", "inferred_head"] },
              "container_commit": { "$ref": "#/$defs/commit" },
              "delivery_resolution": { "const": "explicit" },
              "delivery_commit": { "$ref": "#/$defs/commit" },
              "evidence_record": { "$ref": "#/$defs/artifact" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,99}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "git_blob"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sha256": { "$ref": "#/$defs/digest" },
        "git_blob": { "$ref": "#/$defs/commit" }
      }
    },
    "bundleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "git_blob", "byte_length"],
      "properties": {
        "path": { "type": "string", "pattern": "^(scripts/validate-engineering-process-program\\.py|scripts/program_control/.+\\.py)$", "maxLength": 500 },
        "sha256": { "$ref": "#/$defs/digest" },
        "git_blob": { "$ref": "#/$defs/commit" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 2097152 }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256", "git_blob", "schema_id", "schema_version"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "role": { "enum": ["immutable_policy", "operational_state", "append_only_evidence", "generated_projection", "feature_contract"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "git_blob": { "$ref": "#/$defs/commit" },
        "schema_id": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 500 }] },
        "schema_version": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 100 }] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "git_commit", "git_tree", "artifact_digests"],
      "properties": {
        "kind": { "enum": ["feature_candidate", "dev_candidate", "release_candidate"] },
        "git_commit": { "$ref": "#/$defs/commit" },
        "git_tree": { "$ref": "#/$defs/commit" },
        "artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "validationSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_status", "source_commit", "source_tree", "program_tree", "container_resolution", "container_commit", "delivery_resolution", "delivery_commit", "release_candidate", "worktree_clean", "checkout_representation", "input_manifest_digest", "input_manifest"],
      "properties": {
        "resolution_status": { "enum": ["resolved", "unresolved"] },
        "source_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "source_tree": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "program_tree": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "container_resolution": { "enum": ["absent", "explicit", "inferred_head", "unresolved"] },
        "container_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "delivery_resolution": { "enum": ["absent", "explicit", "unresolved"] },
        "delivery_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "release_candidate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/candidate" }] },
        "worktree_clean": { "type": "boolean" },
        "checkout_representation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "autocrlf", "dirty_path_count"],
          "properties": {
            "platform": { "enum": ["windows", "posix", "unknown"] },
            "autocrlf": { "enum": ["true", "false", "input", "unset", "unknown"] },
            "dirty_path_count": { "type": "integer", "minimum": 0 }
          }
        },
        "input_manifest_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "input_manifest": { "type": "array", "items": { "$ref": "#/$defs/sourceArtifact" } }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed_gates", "required_gates", "gates", "blockers", "evidence", "fresh", "last_success_at"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale"] },
        "passed_gates": { "type": "integer", "minimum": 0 },
        "required_gates": { "type": "integer", "minimum": 1 },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "classification", "reason_code", "evidence", "fresh"],
            "properties": {
              "id": { "type": "string", "pattern": "^(PROD|BENCH|COMM|PROG)-[0-9]{2}$" },
              "status": { "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale"] },
              "classification": { "enum": ["supporting", "skipped", "partial", "unsupported", "unavailable", "contaminated", "inconclusive", "not_tested"] },
              "reason_code": { "$ref": "#/$defs/code" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
              "fresh": { "type": "boolean" }
            }
          }
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "fresh": { "type": "boolean" },
        "last_success_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      }
    },
    "benchmarkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counted", "target", "first_attempt_passed", "eventual_passed", "failed", "blocked", "stale", "contaminated", "not_tested", "t0", "t1", "t2", "t3", "coverage_deficits", "oracle_deficits", "artifact_deficits", "partition_deficits", "freshness_deficits"],
      "properties": {
        "counted": { "type": "integer", "minimum": 0, "maximum": 100 },
        "target": { "const": 100 },
        "first_attempt_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "eventual_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stale": { "type": "integer", "minimum": 0, "maximum": 100 },
        "contaminated": { "type": "integer", "minimum": 0, "maximum": 100 },
        "not_tested": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t0": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t1": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t2": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t3": { "type": "integer", "minimum": 0, "maximum": 100 },
        "coverage_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "oracle_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "artifact_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "partition_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "freshness_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } }
      }
    },
    "releaseApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approval_id", "subject_matches"],
      "properties": {
        "status": { "enum": ["absent", "pending", "approved", "approved_with_conditions", "rejected", "stale", "revoked"] },
        "approval_id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^APR-[A-Z0-9-]{3,100}$" }] },
        "subject_matches": { "type": "boolean" }
      }
    }
  }
}
