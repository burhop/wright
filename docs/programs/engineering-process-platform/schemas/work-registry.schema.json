{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/work-registry.schema.json",
  "title": "Wright Engineering Process Platform Work Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "task_sources", "active_assignments"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "program_id": { "const": "engineering-process-platform" },
    "task_sources": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/taskSource" }
    },
    "active_assignments": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/assignment" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:docs/programs/engineering-process-platform/|specs/[0-9]{3}-[A-Za-z0-9_-]+/)[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "taskSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "tasks_path", "roadmap_item_id", "active_feature"],
      "properties": {
        "feature_id": { "type": "string", "pattern": "^EPP-[A-Z0-9-]+$" },
        "tasks_path": { "$ref": "#/$defs/relativePath" },
        "roadmap_item_id": { "type": "string", "pattern": "^EPP-[A-Z0-9-]+$" },
        "active_feature": { "type": "boolean" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "feature_id", "task_id", "task_title", "task_state", "branch", "worktree_id", "lane", "why_this_matters", "observed_at", "evidence"],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,99}$" },
        "feature_id": { "type": "string", "pattern": "^EPP-[A-Z0-9-]+$" },
        "task_id": { "type": "string", "pattern": "^T[0-9]{3}$" },
        "task_title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "task_state": { "enum": ["assigned", "in_progress", "blocked", "verifying"] },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "worktree_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
        "lane": { "enum": ["integration", "continued_development", "verification", "unavailable"] },
        "why_this_matters": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
