{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/dashboard.schema.json",
  "title": "Engineering Process Platform Dashboard Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "generation_status", "generated_at", "data_cutoff", "source", "areas", "benchmark_summary", "release_eligible", "release_formula", "next_action"],
  "properties": {
    "$schema": { "const": "./schemas/dashboard.schema.json" },
    "schema_version": { "const": "1.0" },
    "program_id": { "const": "EPP-2026" },
    "generation_status": { "enum": ["contract_seed_not_evidence", "committed_valid", "stale", "failed"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_cutoff": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "git_tree", "program_tree", "generator_version", "generator_digest", "artifact_digests"],
      "properties": {
        "git_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "git_tree": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "program_tree": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "generator_version": { "type": "string" },
        "generator_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_readiness", "benchmark_readiness", "commercial_readiness", "program_health"],
      "properties": {
        "product_readiness": { "$ref": "#/$defs/area" },
        "benchmark_readiness": { "$ref": "#/$defs/area" },
        "commercial_readiness": { "$ref": "#/$defs/area" },
        "program_health": { "$ref": "#/$defs/area" }
      }
    },
    "benchmark_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counted", "target", "first_attempt_passed", "eventual_passed", "failed", "blocked", "stale", "contaminated", "not_tested", "t0", "t1", "t2", "t3", "coverage_deficits", "oracle_deficits", "artifact_deficits"],
      "properties": {
        "counted": { "type": "integer", "minimum": 0, "maximum": 100 },
        "target": { "const": 100 },
        "first_attempt_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "eventual_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stale": { "type": "integer", "minimum": 0, "maximum": 100 },
        "contaminated": { "type": "integer", "minimum": 0, "maximum": 100 },
        "not_tested": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t0": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t1": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t2": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t3": { "type": "integer", "minimum": 0, "maximum": 100 },
        "coverage_deficits": { "type": "array", "items": { "type": "string" } },
        "oracle_deficits": { "type": "array", "items": { "type": "string" } },
        "artifact_deficits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "release_eligible": { "type": "boolean" },
    "release_formula": { "const": "product_readiness && benchmark_readiness && commercial_readiness && program_health && human_release_approval" },
    "next_action": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed_gates", "required_gates", "gates", "blockers", "evidence", "fresh", "last_success_at"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale"] },
        "passed_gates": { "type": "integer", "minimum": 0 },
        "required_gates": { "type": "integer", "minimum": 1 },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "reason", "evidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^(PROD|BENCH|COMM|PROG)-[0-9]{2}$" },
              "status": { "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale"] },
              "reason": { "type": "string" },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "fresh": { "type": "boolean" },
        "last_success_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      }
    }
  }
}
