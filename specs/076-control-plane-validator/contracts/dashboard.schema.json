{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/dashboard-v2.schema.json",
  "title": "Engineering Process Platform Dashboard Snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "generation_status", "generated_at", "data_cutoff", "source", "container_relation", "release_candidate", "areas", "benchmark_summary", "release_approval", "release_eligible", "release_formula", "next_action"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "2.0" },
    "program_id": { "const": "EPP-2026" },
    "generation_status": { "enum": ["contract_seed_not_evidence", "candidate_not_evidence", "committed_valid", "stale", "failed"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_cutoff": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "git_tree", "program_tree", "generator_version", "generator_digest", "input_manifest_digest", "artifact_digests"],
      "properties": {
        "git_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "git_tree": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "program_tree": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "generator_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "generator_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "input_manifest_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "container_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_parent_must_equal_source", "allowed_generated_outputs", "verification_evidence"],
      "properties": {
        "first_parent_must_equal_source": { "const": true },
        "allowed_generated_outputs": { "const": ["docs/programs/engineering-process-platform/dashboard.json"] },
        "verification_evidence": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] }
      }
    },
    "release_candidate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/candidate" }] },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_readiness", "benchmark_readiness", "commercial_readiness", "program_health"],
      "properties": {
        "product_readiness": { "$ref": "#/$defs/area" },
        "benchmark_readiness": { "$ref": "#/$defs/area" },
        "commercial_readiness": { "$ref": "#/$defs/area" },
        "program_health": { "$ref": "#/$defs/area" }
      }
    },
    "benchmark_summary": { "$ref": "#/$defs/benchmarkSummary" },
    "release_approval": { "$ref": "#/$defs/releaseApproval" },
    "release_eligible": { "type": "boolean" },
    "release_formula": { "const": "product_readiness && benchmark_readiness && commercial_readiness && program_health && human_release_approval" },
    "next_action": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "allOf": [
    {
      "if": { "properties": { "generation_status": { "const": "committed_valid" } } },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "git_commit": { "$ref": "#/$defs/commit" },
              "git_tree": { "$ref": "#/$defs/commit" },
              "program_tree": { "$ref": "#/$defs/commit" },
              "generator_digest": { "$ref": "#/$defs/digest" },
              "input_manifest_digest": { "$ref": "#/$defs/digest" }
            }
          },
          "container_relation": {
            "properties": { "verification_evidence": { "$ref": "#/$defs/artifact" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,99}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "git_blob"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sha256": { "$ref": "#/$defs/digest" },
        "git_blob": { "$ref": "#/$defs/commit" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "git_commit", "git_tree", "artifact_digests"],
      "properties": {
        "kind": { "enum": ["feature_candidate", "dev_candidate", "release_candidate"] },
        "git_commit": { "$ref": "#/$defs/commit" },
        "git_tree": { "$ref": "#/$defs/commit" },
        "artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "classification", "reason_code", "evidence", "fresh"],
      "properties": {
        "id": { "type": "string", "pattern": "^(PROD|BENCH|COMM|PROG)-[0-9]{2}$" },
        "status": { "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale"] },
        "classification": { "enum": ["supporting", "skipped", "partial", "unsupported", "unavailable", "contaminated", "inconclusive", "not_tested"] },
        "reason_code": { "$ref": "#/$defs/code" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "fresh": { "type": "boolean" }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed_gates", "required_gates", "gates", "blockers", "evidence", "fresh", "last_success_at"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale"] },
        "passed_gates": { "type": "integer", "minimum": 0 },
        "required_gates": { "type": "integer", "minimum": 1 },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "fresh": { "type": "boolean" },
        "last_success_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      }
    },
    "benchmarkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counted", "target", "first_attempt_passed", "eventual_passed", "failed", "blocked", "stale", "contaminated", "not_tested", "t0", "t1", "t2", "t3", "coverage_deficits", "oracle_deficits", "artifact_deficits", "partition_deficits", "freshness_deficits"],
      "properties": {
        "counted": { "type": "integer", "minimum": 0, "maximum": 100 },
        "target": { "const": 100 },
        "first_attempt_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "eventual_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stale": { "type": "integer", "minimum": 0, "maximum": 100 },
        "contaminated": { "type": "integer", "minimum": 0, "maximum": 100 },
        "not_tested": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t0": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t1": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t2": { "type": "integer", "minimum": 0, "maximum": 100 },
        "t3": { "type": "integer", "minimum": 0, "maximum": 100 },
        "coverage_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "oracle_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "artifact_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "partition_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "freshness_deficits": { "type": "array", "items": { "$ref": "#/$defs/code" } }
      }
    },
    "releaseApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approval_id", "subject_matches"],
      "properties": {
        "status": { "enum": ["absent", "pending", "approved", "approved_with_conditions", "rejected", "stale", "revoked"] },
        "approval_id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^APR-[A-Z0-9-]{3,100}$" }] },
        "subject_matches": { "type": "boolean" }
      }
    }
  }
}
