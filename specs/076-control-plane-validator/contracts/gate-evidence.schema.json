{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/gate-evidence.schema.json",
  "title": "Engineering Process Platform Gate Evidence Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "subject", "catalog_digest", "data_cutoff", "assertions"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "program_id": { "const": "EPP-2026" },
    "subject": { "$ref": "#/$defs/subject" },
    "catalog_digest": { "$ref": "#/$defs/digest" },
    "data_cutoff": { "type": "string", "format": "date-time" },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "classification", "reason_code", "observed_at", "expires_at", "stale_triggers", "verifier", "evidence"],
        "properties": {
          "gate_id": { "type": "string", "pattern": "^(PROD|BENCH|COMM|PROG)-[0-9]{2}$" },
          "status": { "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale"] },
          "classification": { "enum": ["supporting", "skipped", "partial", "unsupported", "unavailable", "contaminated", "inconclusive", "not_tested"] },
          "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,99}$" },
          "observed_at": { "type": "string", "format": "date-time" },
          "expires_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
          "stale_triggers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "verifier": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "role", "independent"],
            "properties": {
              "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
              "role": { "type": "string", "minLength": 1, "maxLength": 100 },
              "independent": { "type": "boolean" }
            }
          },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "git_commit", "git_tree", "artifact_digests"],
      "properties": {
        "kind": { "enum": ["feature_candidate", "dev_candidate", "release_candidate"] },
        "git_commit": { "$ref": "#/$defs/commit" },
        "git_tree": { "$ref": "#/$defs/commit" },
        "artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
