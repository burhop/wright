{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/programs/epp/gate-catalog.schema.json",
  "title": "Engineering Process Platform Gate Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "candidate_policy", "area_order", "gates"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "catalog_id": { "type": "string", "pattern": "^EPP-GATES-[0-9]+$" },
    "candidate_policy": { "type": "string", "minLength": 1, "maxLength": 500 },
    "area_order": { "const": ["product_readiness", "benchmark_readiness", "commercial_readiness", "program_health"] },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "required", "title", "evaluator", "assertions", "freshness", "evidence_policy"],
        "properties": {
          "id": { "type": "string", "pattern": "^(PROD|BENCH|COMM|PROG)-[0-9]{2}$" },
          "area": { "enum": ["product_readiness", "benchmark_readiness", "commercial_readiness", "program_health"] },
          "required": { "type": "boolean" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "evaluator": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,99}$" },
          "assertions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximum_age_seconds", "invalidation_triggers"],
            "properties": {
              "maximum_age_seconds": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
              "invalidation_triggers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
            }
          },
          "evidence_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_classes", "independent_verifier_required"],
            "properties": {
              "required_classes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
              "independent_verifier_required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
