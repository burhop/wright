{
  "format": "wright-native-process",
  "schema_version": "1.0.0",
  "id": "study-trace",
  "title": "Study fixture: three inputs and two outputs",
  "steps": [
    {
      "id": "need-source",
      "title": "Design need",
      "operation": "text.input@1",
      "config": {
        "value": "Design a desk bracket."
      }
    },
    {
      "id": "mass-source",
      "title": "Mass constraint",
      "operation": "text.input@1",
      "config": {
        "value": "Maximum mass: 200 g."
      }
    },
    {
      "id": "note-source",
      "title": "Revision note",
      "operation": "text.input@1",
      "config": {
        "value": "Revision: A"
      }
    },
    {
      "id": "base-compose",
      "title": "Combine need and constraint",
      "operation": "text.join@1",
      "config": {
        "separator": "\n"
      }
    },
    {
      "id": "full-compose",
      "title": "Add revision",
      "operation": "text.join@1",
      "config": {
        "separator": "\n"
      }
    },
    {
      "id": "brief-file",
      "title": "Full brief",
      "operation": "artifact.write-text@1",
      "config": {
        "filename": "study-brief.md"
      }
    },
    {
      "id": "summary-file",
      "title": "Base summary",
      "operation": "artifact.write-text@1",
      "config": {
        "filename": "study-summary.txt"
      }
    }
  ],
  "ports": [
