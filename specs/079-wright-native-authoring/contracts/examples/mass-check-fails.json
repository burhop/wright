{
  "format": "wright-native-process",
  "schema_version": "1.0.0",
  "id": "mass-check",
  "title": "Calculate and check mass with explicit units",
  "steps": [
    {
      "id": "volume-source",
      "title": "volume source",
      "operation": "quantity.input@1",
      "config": {
        "value": {
          "value": "0.00005",
          "unit": "m3"
        }
      }
    },
    {
      "id": "density-source",
      "title": "density source",
      "operation": "quantity.input@1",
      "config": {
        "value": {
          "value": "2700",
          "unit": "kg/m3"
        }
      }
    },
    {
      "id": "mass-product",
      "title": "mass product",
      "operation": "quantity.multiply@1",
      "config": {
        "unit": "g"
      }
    },
    {
      "id": "mass-check-step",
      "title": "mass check",
      "operation": "quantity.range@1",
      "config": {
        "minimum": {
          "value": "1",
          "unit": "g"
        },
        "maximum": {
          "value": "100",
          "unit": "g"
        }
      }
    },
    {
      "id": "mass-report",
      "title": "mass report",
      "operation": "quantity.format@1",
      "config": {
        "label": "Mass"
      }
    },
    {
      "id": "mass-file",
      "title": "mass file",
      "operation": "artifact.write-text@1",
      "config": {
        "filename": "mass-report.txt"
      }
    }
  ],
  "ports": [
    {
      "id": "volume-source-output-value",
      "step_id": "volume-source",
      "key": "value",
      "label": "value",
      "direction": "output",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-product-input-left",
      "step_id": "mass-product",
      "key": "left",
      "label": "left",
      "direction": "input",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "density-source-output-value",
      "step_id": "density-source",
      "key": "value",
      "label": "value",
      "direction": "output",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-product-input-right",
      "step_id": "mass-product",
      "key": "right",
      "label": "right",
      "direction": "input",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-product-output-value",
      "step_id": "mass-product",
      "key": "value",
      "label": "value",
      "direction": "output",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-check-input-value",
      "step_id": "mass-check-step",
      "key": "value",
      "label": "value",
      "direction": "input",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-check-output-value",
      "step_id": "mass-check-step",
      "key": "value",
      "label": "value",
      "direction": "output",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-report-input-value",
      "step_id": "mass-report",
      "key": "value",
      "label": "value",
      "direction": "input",
      "type": "quantity",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-report-output-text",
      "step_id": "mass-report",
      "key": "text",
      "label": "text",
      "direction": "output",
      "type": "text",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-file-input-text",
      "step_id": "mass-file",
      "key": "text",
      "label": "text",
      "direction": "input",
      "type": "text",
      "cardinality": "one",
      "required": true
    },
    {
      "id": "mass-file-output-artifact",
      "step_id": "mass-file",
      "key": "artifact",
      "label": "artifact",
      "direction": "output",
      "type": "artifact",
      "cardinality": "one",
      "required": true
    }
  ],
  "connections": [
    {
      "id": "link-1",
      "source_port_id": "volume-source-output-value",
      "target_port_id": "mass-product-input-left"
    },
    {
      "id": "link-2",
      "source_port_id": "density-source-output-value",
      "target_port_id": "mass-product-input-right"
    },
    {
      "id": "link-3",
      "source_port_id": "mass-product-output-value",
      "target_port_id": "mass-check-input-value"
    },
    {
      "id": "link-4",
      "source_port_id": "mass-check-output-value",
      "target_port_id": "mass-report-input-value"
    },
    {
      "id": "link-5",
      "source_port_id": "mass-report-output-text",
      "target_port_id": "mass-file-input-text"
    }
  ],
  "outputs": [
    {
      "id": "mass-result",
      "title": "Mass report",
      "port_id": "mass-file-output-artifact"
    }
  ]
}
