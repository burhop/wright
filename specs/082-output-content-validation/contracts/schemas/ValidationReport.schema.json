          "title": "Formats",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "config_digest",
        "method"
      ],
      "title": "ReaderIdentity",
      "type": "object"
    },
    "ReportScope": {
      "additionalProperties": false,
      "properties": {
        "requirement_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "excluded_scope": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Excluded Scope",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "physical_validation": {
          "const": "not_assessed",
          "default": "not_assessed",
          "title": "Physical Validation",
          "type": "string"
        }
      },
      "required": [
        "requirement_ids"
      ],
      "title": "ReportScope",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "scope": {
          "enum": [
            "content",
            "design"
          ],
          "title": "Scope",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "review_required": {
