{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "wright.process-validation/1",
          "default": "wright.process-validation/1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "attempt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ValidationRequest"
        },
        "profile": {
          "$ref": "#/$defs/ValidationProfile"
        },
        "created_at": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "subject_current": {
          "default": true,
          "title": "Subject Current",
          "type": "boolean"
        },
        "review_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Review Ids",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "id",
        "attempt_id",
        "request",
        "profile",
        "created_at",
        "summary"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "AssessmentCurrentness": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "As Of",
          "type": "string"
        },
        "selected_assessment_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Selected Assessment Id",
          "type": "string"
        },
        "selected_attempt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Selected Attempt Id",
          "type": "string"
        },
        "selected_subject_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Subject Ids",
          "type": "array"
        },
        "latest_attempt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Latest Attempt Id",
          "type": "string"
        },
        "latest_assessment_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Assessment Id"
        },
        "superseded_by": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Superseded By",
          "type": "array"
        },
        "is_current": {
          "title": "Is Current",
          "type": "boolean"
        },
        "stale_reason": {
          "anyOf": [
            {
              "enum": [
                "newer_validation_attempt",
                "superseded_by_review",
                "subject_revision_changed",
                "subject_changed_during_validation",
                "subject_unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Reason"
        }
      },
      "required": [
        "as_of",
        "selected_assessment_id",
        "selected_attempt_id",
        "selected_subject_ids",
        "latest_attempt_id",
        "is_current"
      ],
      "title": "AssessmentCurrentness",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "unresolved_decisions": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Decisions",
          "type": "array"
        },
        "amendments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Amendments",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "requirements"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "CheckDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "default": "1",
          "maxLength": 160,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "subject_role": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Subject Role",
          "type": "string"
        },
        "reader": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Reader",
          "type": "string"
        },
        "selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Selector",
          "type": "string"
        },
        "constraint": {
          "$ref": "#/$defs/Constraint"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "frame": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "evidence_method": {
          "default": "structured_value",
          "enum": [
            "structured_value",
            "independent_measurement",
            "native_inspection",
            "producer_claim",
            "human_review"
          ],
          "title": "Evidence Method",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "applicability_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
