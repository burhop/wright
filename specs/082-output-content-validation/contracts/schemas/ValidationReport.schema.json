      },
      "required": [
        "id",
        "requirement_ids",
        "subject_role",
        "reader",
        "constraint"
      ],
      "title": "CheckDefinition",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "inconclusive",
            "error",
            "not_applicable"
          ],
          "title": "State",
          "type": "string"
        },
        "measurement_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Measurement Ids",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "applicability_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "check_id",
        "requirement_ids",
        "state"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "enum": [
            "exists",
            "type",
            "equals",
            "within",
            "range",
            "review"
          ],
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "inclusive": {
          "default": true,
          "title": "Inclusive",
          "type": "boolean"
        }
      },
      "required": [
        "operator"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "revise_output",
            "supply_input",
            "restore_capability",
            "request_review",
            "retry_validation",
            "refresh_subject"
          ],
          "title": "Action",
          "type": "string"
        },
        "target_step_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Step Id"
        },
        "target": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "preserve_requirement_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Preserve Requirement Ids",
          "type": "array"
        },
        "recheck_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recheck Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "target"
      ],
      "title": "Correction",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "code": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "check_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "fail",
            "blocked",
            "inconclusive",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "enum": [
            "output_defect",
            "missing_evidence",
            "source_conflict",
            "capability_unavailable",
            "review_required",
            "validator_error",
            "stale_subject"
          ],
          "title": "Category",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProducerIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Selector",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/Constraint"
        },
        "observed": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "frame": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "observed_unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Unit"
        },
        "observed_frame": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Frame"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "summary": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "explanation": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "suggested_cause": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Cause"
        },
        "correction": {
          "$ref": "#/$defs/Correction"
        }
      },
      "required": [
        "id",
        "code",
        "check_id",
        "requirement_ids",
        "state",
        "category",
        "expected",
        "source_refs",
        "summary",
        "explanation",
        "correction"
      ],
      "title": "Finding",
      "type": "object"
    },
    "JsonValue": {},
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "subject_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        },
        "selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Selector",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "frame": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "uncertainty": {
          "default": 0.0,
          "minimum": 0,
          "title": "Uncertainty",
          "type": "number"
        },
        "reader": {
          "$ref": "#/$defs/ReaderIdentity"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "subject_id",
        "subject_sha256",
        "value",
        "reader",
        "evidence_refs"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "output_port": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Output Port",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "attempt",
        "output_port"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "ReaderIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "method": {
          "enum": [
            "structured_value",
            "independent_measurement",
            "native_inspection",
            "producer_claim",
            "human_review"
