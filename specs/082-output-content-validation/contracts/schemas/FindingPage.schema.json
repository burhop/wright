{
  "$defs": {
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "enum": [
            "exists",
            "type",
            "equals",
            "within",
            "range",
            "review"
          ],
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "inclusive": {
          "default": true,
          "title": "Inclusive",
          "type": "boolean"
        }
      },
      "required": [
        "operator"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "revise_output",
            "supply_input",
            "restore_capability",
            "request_review",
            "retry_validation",
            "refresh_subject"
          ],
          "title": "Action",
          "type": "string"
        },
        "target_step_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Step Id"
        },
        "target": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "preserve_requirement_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Preserve Requirement Ids",
          "type": "array"
        },
        "recheck_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recheck Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "target"
      ],
      "title": "Correction",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "code": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "check_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "fail",
            "blocked",
            "inconclusive",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "enum": [
            "output_defect",
            "missing_evidence",
            "source_conflict",
            "capability_unavailable",
            "review_required",
            "validator_error",
            "stale_subject"
          ],
          "title": "Category",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProducerIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Selector",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/Constraint"
        },
        "observed": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "frame": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "observed_unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Unit"
        },
        "observed_frame": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Frame"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "summary": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "explanation": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "suggested_cause": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Cause"
        },
        "correction": {
          "$ref": "#/$defs/Correction"
        }
      },
      "required": [
        "id",
        "code",
        "check_id",
        "requirement_ids",
        "state",
        "category",
        "expected",
        "source_refs",
        "summary",
        "explanation",
        "correction"
      ],
      "title": "Finding",
      "type": "object"
    },
    "JsonValue": {},
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "output_port": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Output Port",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "attempt",
        "output_port"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "locator": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "sha256",
        "locator"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "content_verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Verified"
        },
        "requirements_compliant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requirements Compliant"
        },
        "evaluation_complete": {
          "title": "Evaluation Complete",
          "type": "boolean"
        },
        "release_eligible": {
          "title": "Release Eligible",
          "type": "boolean"
        },
        "physical_validation": {
          "const": "not_assessed",
          "default": "not_assessed",
          "title": "Physical Validation",
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "inconclusive",
              "error",
              "not_applicable"
            ]
          },
          "title": "Counts",
          "type": "object"
        }
      },
      "required": [
        "content_verified",
        "requirements_compliant",
        "evaluation_complete",
        "release_eligible",
        "counts"
      ],
      "title": "Summary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "wright.process-validation/1",
      "default": "wright.process-validation/1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "assessment_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assessment Digest",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "is_current": {
      "title": "Is Current",
      "type": "boolean"
    },
    "release_eligible": {
      "title": "Release Eligible",
      "type": "boolean"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "finding_count": {
      "minimum": 0,
      "title": "Finding Count",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 20,
      "title": "Findings",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    }
  },
  "required": [
    "assessment_id",
    "assessment_digest",
    "attempt_id",
    "workspace_id",
    "is_current",
    "release_eligible",
    "summary",
    "finding_count",
    "findings"
  ],
  "title": "FindingPage",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wright:process-validation:1:FindingPage"
}
