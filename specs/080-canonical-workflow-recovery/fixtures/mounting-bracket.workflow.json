      "phase_id": "phase.deliver",
      "execution_kind": "deterministic",
      "instructions": "Create a local package only; do not publish or send it.",
      "configuration": { "classification": "internal", "publish": false },
      "input_port_ids": ["port.step-in", "port.report-package-in"],
      "output_port_ids": ["port.package-out"],
      "binding_id": "binding.release-package",
      "component_ref": null
    }
