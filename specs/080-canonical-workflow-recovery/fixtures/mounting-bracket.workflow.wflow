  title: "Design review step group"
  inputs: ["port.design-specification-review-in","port.geometry-review-in","port.report-in"]
  outputs: ["port.approved-geometry-out"]
  digest: sha256:5555555555555555555555555555555555555555555555555555555555555555
  addresses: [{"concept_kind":"block","relative_path":"blocks/block.evaluate","semantic_id":"component.review-cell.block.evaluate"},{"concept_kind":"relationship","relative_path":"relationships/rel.accept","semantic_id":"component.review-cell.relationship.accept"},{"concept_kind":"artifact_contract","relative_path":"artifact-contracts/artifact.approved","semantic_id":"component.review-cell.artifact.approved"},{"concept_kind":"port","relative_path":"ports/port.approved","semantic_id":"component.review-cell.port.approved"}]
