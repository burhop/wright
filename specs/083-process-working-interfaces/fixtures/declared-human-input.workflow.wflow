  settings: {"authoring_template": "human-input", "human_interaction": {"version": 1, "kind": "input", "instructions": "Choose the comparison to carry forward after reviewing the output.", "response_schema": {"type": "object", "properties": {"selection": {"type": "string", "enum": ["a", "b"]}}, "required": ["selection"], "additionalProperties": false}, "output_port": "choice_response"}}
