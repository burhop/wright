{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/schemas/program-status-bundle.schema.json",
  "title": "Wright Program Status Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "generated_at", "source", "dashboard", "supplement"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "bundle_id": { "$ref": "#/$defs/sha256" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "source": { "$ref": "#/$defs/source" },
    "dashboard": { "$ref": "https://wright.local/programs/epp/dashboard-v2.schema.json" },
    "supplement": { "$ref": "#/$defs/supplement" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:docs/programs/engineering-process-platform/|specs/076-control-plane-validator/|specs/077-browser-program-status/)[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "program_tree", "snapshot_path", "snapshot_raw_sha256", "raw_identity_verification", "raw_identity_evidence", "dashboard_canonical_sha256", "source_catalog_path", "source_catalog_sha256", "validation_transition", "validation_verdict"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" },
        "program_tree": { "$ref": "#/$defs/gitSha" },
        "snapshot_path": { "$ref": "#/$defs/relativePath" },
        "snapshot_raw_sha256": { "$ref": "#/$defs/sha256" },
        "raw_identity_verification": { "const": "publisher_git_blob_attested" },
        "raw_identity_evidence": { "$ref": "#/$defs/evidenceRef" },
        "dashboard_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "source_catalog_path": { "const": "specs/077-browser-program-status/contracts/program-status-source-catalog.json" },
        "source_catalog_sha256": { "$ref": "#/$defs/sha256" },
        "validation_transition": { "type": "string", "pattern": "^TR-[0-9]{4}$" },
        "validation_verdict": { "const": "passed" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "purpose", "eligibility", "authority_state", "requires_human_approval", "blocker", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,99}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "purpose": { "enum": ["current_program_action", "metric_guidance", "lane_next_action", "benchmark_qualifying_action"] },
        "eligibility": { "enum": ["eligible", "blocked", "requires_approval", "unavailable"] },
        "authority_state": { "enum": ["authorized", "not_authorized", "not_required", "stale", "unavailable"] },
        "requires_human_approval": { "type": "boolean" },
        "blocker": { "type": ["string", "null"], "maxLength": 500 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "eligibility": { "const": "eligible" } }, "required": ["eligibility"] },
          "then": { "properties": { "requires_human_approval": { "const": false }, "authority_state": { "enum": ["authorized", "not_required"] }, "blocker": { "type": "null" } } }
        },
        {
          "if": { "properties": { "eligibility": { "const": "blocked" } }, "required": ["eligibility"] },
          "then": { "properties": { "requires_human_approval": { "const": false }, "blocker": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "eligibility": { "const": "requires_approval" } }, "required": ["eligibility"] },
          "then": { "properties": { "requires_human_approval": { "const": true }, "authority_state": { "enum": ["not_authorized", "stale", "unavailable"] }, "blocker": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "eligibility": { "const": "unavailable" } }, "required": ["eligibility"] },
          "then": { "properties": { "requires_human_approval": { "const": false }, "authority_state": { "const": "unavailable" }, "blocker": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "sourceClass": {
      "enum": ["product_acceptance", "test_evidence", "automation_capability", "program_gate", "readiness_gate", "benchmark_qualification", "feature_task", "integration_gate"]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "transition_id", "parent_commit", "observed_at", "value", "denominator", "label", "source_classification", "change_reason", "evidence"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "transition_id": { "type": ["string", "null"], "pattern": "^TR-[0-9]{4}$" },
        "parent_commit": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "value": { "type": "number", "minimum": 0 },
        "denominator": { "type": ["number", "null"], "minimum": 0 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source_classification": { "$ref": "#/$defs/sourceClass" },
        "change_reason": { "type": ["string", "null"], "maxLength": 500 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "latestChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "observed_at", "from_value", "to_value", "reason"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "from_value": { "type": ["number", "null"] },
        "to_value": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "counting_rule", "source_classification", "availability", "feature_id", "decision_use", "current_limitation", "next_action", "latest_change", "omitted_observations", "unavailable_reason", "observations"],
      "properties": {
        "id": { "enum": ["customer_capability", "quality", "process_automation", "governance", "product_readiness", "benchmark_readiness", "commercial_readiness", "program_health", "benchmark_qualified", "feature_tasks", "integration_delivery"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "unit": { "enum": ["accepted_customer_scenarios", "passing_required_checks_ratio", "demonstrated_lifecycle_capabilities", "passing_program_gates_ratio", "passing_readiness_gates_ratio", "qualified_processes_of_100", "completed_feature_tasks_ratio", "completed_integration_gates_of_8"] },
        "counting_rule": { "enum": ["distinct_committed_customer_acceptance", "required_candidate_checks", "distinct_committed_lifecycle_demonstrations", "authoritative_program_health_gates", "authoritative_readiness_area_gates", "governed_qualification_only", "exact_feature_task_ids", "ordered_integration_gate_completion"] },
        "source_classification": { "$ref": "#/$defs/sourceClass" },
        "availability": { "enum": ["available", "unavailable"] },
        "feature_id": { "type": ["string", "null"], "maxLength": 64 },
        "decision_use": { "type": "string", "minLength": 1, "maxLength": 500 },
        "current_limitation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "next_action": { "allOf": [{ "$ref": "#/$defs/action" }, { "properties": { "purpose": { "const": "metric_guidance" } } }] },
        "latest_change": { "oneOf": [{ "$ref": "#/$defs/latestChange" }, { "type": "null" }] },
        "omitted_observations": { "type": "integer", "minimum": 0 },
        "unavailable_reason": { "type": ["string", "null"], "maxLength": 500 },
        "observations": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/observation" } }
      },
      "allOf": [
        { "if": { "properties": { "availability": { "const": "available" } }, "required": ["availability"] }, "then": { "properties": { "observations": { "minItems": 1 }, "latest_change": { "$ref": "#/$defs/latestChange" }, "unavailable_reason": { "type": "null" } } } },
        { "if": { "properties": { "availability": { "const": "unavailable" } }, "required": ["availability"] }, "then": { "properties": { "observations": { "maxItems": 0 }, "latest_change": { "type": "null" }, "unavailable_reason": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "id": { "const": "customer_capability" } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "accepted_customer_scenarios" }, "counting_rule": { "const": "distinct_committed_customer_acceptance" }, "source_classification": { "const": "product_acceptance" } } } },
        { "if": { "properties": { "id": { "const": "quality" } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "passing_required_checks_ratio" }, "counting_rule": { "const": "required_candidate_checks" }, "source_classification": { "const": "test_evidence" } } } },
        { "if": { "properties": { "id": { "const": "process_automation" } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "demonstrated_lifecycle_capabilities" }, "counting_rule": { "const": "distinct_committed_lifecycle_demonstrations" }, "source_classification": { "const": "automation_capability" } } } },
        { "if": { "properties": { "id": { "const": "governance" } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "passing_program_gates_ratio" }, "counting_rule": { "const": "authoritative_program_health_gates" }, "source_classification": { "const": "program_gate" } } } },
        { "if": { "properties": { "id": { "enum": ["product_readiness", "benchmark_readiness", "commercial_readiness", "program_health"] } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "passing_readiness_gates_ratio" }, "counting_rule": { "const": "authoritative_readiness_area_gates" }, "source_classification": { "const": "readiness_gate" } } } },
        { "if": { "properties": { "id": { "const": "benchmark_qualified" } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "qualified_processes_of_100" }, "counting_rule": { "const": "governed_qualification_only" }, "source_classification": { "const": "benchmark_qualification" } } } },
        { "if": { "properties": { "id": { "const": "feature_tasks" } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "completed_feature_tasks_ratio" }, "counting_rule": { "const": "exact_feature_task_ids" }, "source_classification": { "const": "feature_task" }, "feature_id": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "id": { "const": "integration_delivery" } }, "required": ["id"] }, "then": { "properties": { "unit": { "const": "completed_integration_gates_of_8" }, "counting_rule": { "const": "ordered_integration_gate_completion" }, "source_classification": { "const": "integration_gate" } } } }
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_total", "source_path", "source_digest", "maturity_counts"],
      "properties": {
        "proposed_total": { "const": 100 },
        "source_path": { "$ref": "#/$defs/relativePath" },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "maturity_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fully_defined", "ready_to_specify", "shaped", "candidate", "discovery_shaped", "discovery", "discovery_separate_t4_authority_required"],
          "properties": {
            "fully_defined": { "type": "integer", "minimum": 0 },
            "ready_to_specify": { "type": "integer", "minimum": 0 },
            "shaped": { "type": "integer", "minimum": 0 },
            "candidate": { "type": "integer", "minimum": 0 },
            "discovery_shaped": { "type": "integer", "minimum": 0 },
            "discovery": { "type": "integer", "minimum": 0 },
            "discovery_separate_t4_authority_required": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "commitTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" }
      }
    },
    "leaseRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_audit_transition", "rollback_state", "exhausted_cause_ids", "active_cause_id", "repair_maximum", "repair_remaining"],
      "properties": {
        "status": { "enum": ["audit_current", "reactivated", "interrupted", "expired", "blocked"] },
        "last_audit_transition": { "type": "string", "pattern": "^TR-[0-9]{4}$" },
        "rollback_state": { "type": "string", "pattern": "^evidence/states/program-state-revision-[0-9]{4}\\.json$" },
        "exhausted_cause_ids": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "pattern": "^[A-Z0-9-]{3,100}$" } },
        "active_cause_id": { "type": ["string", "null"], "pattern": "^[A-Z0-9-]{3,100}$" },
        "repair_maximum": { "const": 2 },
        "repair_remaining": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "branch", "worktree_id", "dev_baseline", "worktree_start", "holder_role", "lease_mode", "lease_revision", "acquired_at", "expires_at", "allowed_paths", "path_restrictions", "allowed_actions", "recovery"],
      "properties": {
        "feature_id": { "type": "string", "pattern": "^EPP-[A-Z0-9-]+$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 200 },
        "worktree_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
        "dev_baseline": { "$ref": "#/$defs/commitTree" },
        "worktree_start": { "$ref": "#/$defs/commitTree" },
        "holder_role": { "const": "feature_owner" },
        "lease_mode": { "enum": ["planning", "implementation", "verification"] },
        "lease_revision": { "type": "integer", "minimum": 1 },
        "acquired_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "allowed_paths": { "type": "array", "minItems": 1, "maxItems": 250, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "path_restrictions": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "restriction"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 300 },
              "restriction": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        "allowed_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["inspect", "edit_allowlisted_paths", "run_deterministic_checks", "create_local_artifacts", "create_local_commits"] } },
        "recovery": { "$ref": "#/$defs/leaseRecovery" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "transition_id", "parent_commit", "observed_at", "label", "source_classification", "evidence"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "transition_id": { "type": ["string", "null"], "pattern": "^TR-[0-9]{4}$" },
        "parent_commit": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_classification": { "$ref": "#/$defs/sourceClass" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passing", "failing", "pending"],
      "properties": {
        "passing": { "type": "integer", "minimum": 0 },
        "failing": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "maxLength": 1000, "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?/pull/[1-9][0-9]*$" }
      }
    },
    "deliveryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commit", "observed_at", "result", "evidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "commit": { "$ref": "#/$defs/gitSha" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "result": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidence": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "integrationLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "branch", "milestone", "latest_capability", "blocker", "next_action", "observed_at", "evidence", "target_branch", "frozen_candidate", "last_pushed_commit", "last_pushed_at", "pull_request", "phase", "checks", "ci_started_at", "first_actionable_failure", "dev_sync", "merge_gate", "authority_state", "events"],
      "properties": {
        "kind": { "const": "integration" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "milestone": { "type": "string", "minLength": 1, "maxLength": 300 },
        "latest_capability": { "type": "string", "minLength": 1, "maxLength": 500 },
        "blocker": { "type": ["string", "null"], "maxLength": 500 },
        "next_action": { "allOf": [{ "$ref": "#/$defs/action" }, { "properties": { "purpose": { "const": "lane_next_action" } } }] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "evidence": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } },
        "target_branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "frozen_candidate": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "last_pushed_commit": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "last_pushed_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "pull_request": { "oneOf": [{ "$ref": "#/$defs/pullRequest" }, { "type": "null" }] },
        "phase": { "enum": ["not pushed", "local gate", "PR open", "CI running", "CI failed", "merge ready", "merged", "dev deployment verified"] },
        "checks": { "oneOf": [{ "$ref": "#/$defs/checks" }, { "type": "null" }] },
        "ci_started_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "first_actionable_failure": { "type": ["string", "null"], "maxLength": 500 },
        "dev_sync": { "type": ["string", "null"], "maxLength": 160 },
        "merge_gate": { "type": ["string", "null"], "maxLength": 160 },
        "authority_state": { "enum": ["authorized", "not_authorized", "not_required", "stale", "unavailable"] },
        "events": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/deliveryEvent" } }
      }
    },
    "developmentLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "branch", "milestone", "latest_capability", "blocker", "next_action", "observed_at", "evidence", "base_commit", "authority_state"],
      "properties": {
        "kind": { "const": "continued_development" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "milestone": { "type": "string", "minLength": 1, "maxLength": 300 },
        "latest_capability": { "type": "string", "minLength": 1, "maxLength": 500 },
        "blocker": { "type": ["string", "null"], "maxLength": 500 },
        "next_action": { "allOf": [{ "$ref": "#/$defs/action" }, { "properties": { "purpose": { "const": "lane_next_action" } } }] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "evidence": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } },
        "base_commit": { "$ref": "#/$defs/gitSha" },
        "authority_state": { "enum": ["authorized", "not_authorized", "not_required", "stale", "unavailable"] }
      }
    },
    "evidenceDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path", "sha256", "summary", "freshness", "recovery", "availability", "exact_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "freshness": { "enum": ["current", "stale", "unavailable", "unknown"] },
        "recovery": { "type": ["string", "null"], "maxLength": 1000 },
        "availability": { "enum": ["checkout_available", "exact_github", "identity_only"] },
        "exact_url": { "oneOf": [{ "type": "string", "maxLength": 1000, "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?/blob/[0-9a-f]{40}/[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "availability": { "const": "exact_github" } }, "required": ["availability"] }, "then": { "properties": { "exact_url": { "type": "string" } } } }
      ]
    },
    "correctionDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "path", "digest", "correction_class", "authority_status", "approval_id", "expected_claim_ids", "verified_claim_ids", "finding_ids", "resolved_finding_ids", "unresolved_finding_ids", "verification_ids", "verification_subject", "verified_at", "evidence"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/sha256" },
        "correction_class": { "type": "string", "minLength": 1, "maxLength": 160 },
        "authority_status": { "enum": ["approved", "pending", "stale", "unavailable"] },
        "approval_id": { "type": ["string", "null"], "maxLength": 160 },
        "expected_claim_ids": { "type": "array", "minItems": 1, "maxItems": 250, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "verified_claim_ids": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "finding_ids": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "resolved_finding_ids": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "unresolved_finding_ids": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "verification_ids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "verification_subject": { "type": "string", "minLength": 1, "maxLength": 300 },
        "verified_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "severity", "summary", "blocking", "opened_at", "resolved_at", "correction_profile_id", "resolution_verification_id", "recovery", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "status": { "enum": ["open", "resolved", "accepted", "unavailable"] },
        "severity": { "enum": ["P0", "P1", "P2", "P3", "unknown"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "blocking": { "type": "boolean" },
        "opened_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "resolved_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "correction_profile_id": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "resolution_verification_id": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "recovery": { "type": ["string", "null"], "maxLength": 1000 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": { "properties": { "resolved_at": { "$ref": "#/$defs/timestamp" }, "correction_profile_id": { "$ref": "#/$defs/stableId" }, "resolution_verification_id": { "$ref": "#/$defs/stableId" }, "blocking": { "const": false } } }
        },
        {
          "if": { "properties": { "status": { "const": "open" } }, "required": ["status"] },
          "then": { "properties": { "resolved_at": { "type": "null" }, "correction_profile_id": { "type": "null" }, "resolution_verification_id": { "type": "null" } } }
        }
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "owner", "overdue", "blocks", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "severity": { "enum": ["P0", "P1", "P2", "P3", "unknown"] },
        "status": { "type": "string", "minLength": 1, "maxLength": 80 },
        "owner": { "type": ["string", "null"], "maxLength": 160 },
        "overdue": { "type": "boolean" },
        "blocks": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "owner", "overdue", "blocks", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "type": "string", "minLength": 1, "maxLength": 80 },
        "owner": { "type": ["string", "null"], "maxLength": 160 },
        "overdue": { "type": "boolean" },
        "blocks": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "independentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "verifier", "independent", "subject", "verdict", "blocking", "finding_ids", "correction_profile_ids", "verified_at", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "author": { "type": "string", "minLength": 1, "maxLength": 160 },
        "verifier": { "type": "string", "minLength": 1, "maxLength": 160 },
        "independent": { "const": true },
        "subject": { "type": "string", "minLength": 1, "maxLength": 300 },
        "verdict": { "enum": ["passed", "failed", "inconclusive"] },
        "blocking": { "type": "boolean" },
        "finding_ids": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "correction_profile_ids": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "verified_at": { "$ref": "#/$defs/timestamp" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      },
      "allOf": [
        { "if": { "properties": { "verdict": { "const": "passed" } }, "required": ["verdict"] }, "then": { "properties": { "blocking": { "const": false } } } },
        { "if": { "properties": { "verdict": { "enum": ["failed", "inconclusive"] } }, "required": ["verdict"] }, "then": { "properties": { "blocking": { "const": true } } } }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corrections", "findings", "risks", "decisions", "verification", "limits", "flow"],
      "properties": {
        "corrections": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/correctionDisclosure" } },
        "findings": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/finding" } },
        "risks": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/risk" } },
        "decisions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/decision" } },
        "verification": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/independentVerification" } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wip_max", "repair_max", "push_max"],
          "properties": {
            "wip_max": { "type": "integer", "minimum": 1 },
            "repair_max": { "const": 2 },
            "push_max": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_feature_count", "active_lease_count", "roadmap_blocker_count", "open_p0_decision_count", "open_p0_risk_count"],
          "properties": {
            "active_feature_count": { "type": "integer", "minimum": 0 },
            "active_lease_count": { "type": "integer", "minimum": 0 },
            "roadmap_blocker_count": { "type": "integer", "minimum": 0 },
            "open_p0_decision_count": { "type": "integer", "minimum": 0 },
            "open_p0_risk_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "benchmarkDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "blocking", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "status": { "enum": ["satisfied", "pending", "blocked", "not_authorized", "unavailable"] },
        "blocking": { "type": "boolean" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "benchmarkContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "hold_state", "hold_reason", "dependencies", "authorization_state", "next_qualifying_action", "evidence"],
      "properties": {
        "phase": { "enum": ["not_started", "qualification_planning", "qualification_active", "on_hold", "blocked", "complete", "unavailable"] },
        "hold_state": { "enum": ["none", "on_hold", "blocked", "unavailable"] },
        "hold_reason": { "type": ["string", "null"], "maxLength": 1000 },
        "dependencies": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/benchmarkDependency" } },
        "authorization_state": { "enum": ["authorized", "not_authorized", "not_required", "stale", "unavailable"] },
        "next_qualifying_action": { "allOf": [{ "$ref": "#/$defs/action" }, { "properties": { "purpose": { "const": "benchmark_qualifying_action" } } }] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "hold_state": { "const": "none" } }, "required": ["hold_state"] },
          "then": { "properties": { "hold_reason": { "type": "null" } } }
        },
        {
          "if": { "properties": { "hold_state": { "enum": ["on_hold", "blocked", "unavailable"] } }, "required": ["hold_state"] },
          "then": { "properties": { "hold_reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "mode", "observed_commit", "last_attempt_at", "last_success_at", "failure_code", "recovery"],
      "properties": {
        "state": { "enum": ["active", "inactive", "failed", "unavailable"] },
        "mode": { "enum": ["committed_watch", "package_install", "manual"] },
        "observed_commit": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "last_attempt_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "last_success_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "failure_code": { "type": ["string", "null"], "maxLength": 96 },
        "recovery": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_milestone", "active_feature", "lease", "tasks", "checkpoints", "blockers", "current_next_action", "lanes"],
      "properties": {
        "current_milestone": { "type": "string", "minLength": 1, "maxLength": 300 },
        "active_feature": { "type": ["string", "null"], "maxLength": 64 },
        "lease": { "oneOf": [{ "$ref": "#/$defs/lease" }, { "type": "null" }] },
        "tasks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feature_id", "completed", "total"],
          "properties": {
            "feature_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "completed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "checkpoints": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/checkpoint" } },
        "blockers": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
        "current_next_action": { "allOf": [{ "$ref": "#/$defs/action" }, { "properties": { "purpose": { "const": "current_program_action" } } }] },
        "lanes": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/integrationLane" },
            { "$ref": "#/$defs/developmentLane" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history", "customer_catalog", "benchmark_context", "work", "governance", "evidence_index"],
      "properties": {
        "history": {
          "type": "array",
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "customer_capability" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "quality" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "process_automation" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "governance" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "product_readiness" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "benchmark_readiness" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "commercial_readiness" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "program_health" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "benchmark_qualified" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "feature_tasks" } } }] },
            { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "id": { "const": "integration_delivery" } } }] }
          ],
          "items": false,
          "minItems": 11,
          "maxItems": 11
        },
        "customer_catalog": { "$ref": "#/$defs/catalog" },
        "benchmark_context": { "$ref": "#/$defs/benchmarkContext" },
        "work": { "$ref": "#/$defs/work" },
        "governance": { "$ref": "#/$defs/governance" },
        "evidence_index": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/evidenceDetail" } }
      }
    }
  }
}
