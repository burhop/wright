{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/schemas/program-status-bundle.schema.json",
  "title": "Wright Program Status Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "generated_at", "source", "projection"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "bundle_id": { "$ref": "#/$defs/sha256" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "source": { "$ref": "#/$defs/source" },
    "projection": { "$ref": "#/$defs/projection" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)(docs/programs/engineering-process-platform|specs/07[67]-)[A-Za-z0-9._/-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "program_tree", "snapshot_path", "snapshot_sha256", "validation_transition", "validation_verdict"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" },
        "program_tree": { "$ref": "#/$defs/gitSha" },
        "snapshot_path": { "$ref": "#/$defs/relativePath" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "validation_transition": { "type": "string", "pattern": "^TR-[0-9]{4}$" },
        "validation_verdict": { "const": "passed" }
      }
    },
    "readinessStatus": {
      "type": "string",
      "enum": ["not_started", "in_progress", "ready", "blocked", "failed", "stale", "unavailable", "unknown"]
    },
    "gateStatus": {
      "type": "string",
      "enum": ["not_started", "in_progress", "passed", "blocked", "failed", "stale", "skipped", "partial", "unsupported", "unavailable", "not_tested", "inconclusive", "contaminated", "unknown"]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path", "sha256"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "blockers", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "$ref": "#/$defs/gateStatus" },
        "blockers": { "type": "array", "maxItems": 25, "items": { "type": "string", "maxLength": 500 } },
        "evidence": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } },
        "recovery": { "type": ["string", "null"], "maxLength": 1000 },
        "freshness": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "readinessArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "required_gate_count", "passed_gate_count", "gates", "blockers", "freshness"],
      "properties": {
        "id": { "enum": ["product_readiness", "benchmark_readiness", "commercial_readiness", "program_health"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "$ref": "#/$defs/readinessStatus" },
        "required_gate_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "passed_gate_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "gates": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/gate" } },
        "blockers": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
        "freshness": { "type": "string", "maxLength": 160 },
        "last_qualified_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "observed_at", "value", "label", "evidence_refs"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "value": { "type": "number" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "change_reason": { "type": ["string", "null"], "maxLength": 500 },
        "evidence_refs": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "decision_use", "current_limitation", "next_action", "omitted_observations", "observations"],
      "properties": {
        "id": {
          "enum": [
            "customer_capability",
            "quality",
            "process_automation",
            "governance",
            "product_readiness",
            "benchmark_readiness",
            "commercial_readiness",
            "program_health",
            "benchmark_qualified",
            "feature_tasks",
            "integration_delivery"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 120 },
        "feature_id": { "type": ["string", "null"], "maxLength": 64 },
        "decision_use": { "type": "string", "minLength": 1, "maxLength": 500 },
        "current_limitation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "next_action": { "type": "string", "minLength": 1, "maxLength": 500 },
        "omitted_observations": { "type": "integer", "minimum": 0 },
        "observations": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/observation" } }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified", "target", "phase", "hold_reason", "blocking_dependencies", "authorization_state", "next_action", "evidence_cutoff"],
      "properties": {
        "qualified": { "type": "integer", "minimum": 0, "maximum": 100 },
        "target": { "const": 100 },
        "phase": { "type": "string", "minLength": 1, "maxLength": 120 },
        "hold_reason": { "type": ["string", "null"], "maxLength": 500 },
        "blocking_dependencies": { "type": "array", "maxItems": 25, "items": { "type": "string", "maxLength": 300 } },
        "authorization_state": { "type": "string", "minLength": 1, "maxLength": 160 },
        "next_action": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence_cutoff": { "$ref": "#/$defs/timestamp" },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "first_attempt_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
            "first_attempt_total": { "type": "integer", "minimum": 0, "maximum": 100 },
            "eventual_passed": { "type": "integer", "minimum": 0, "maximum": 100 },
            "eventual_total": { "type": "integer", "minimum": 0, "maximum": 100 },
            "qualification_tiers": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "count"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "count": { "type": "integer", "minimum": 0, "maximum": 100 }
                }
              }
            },
            "non_passing_count": { "type": "integer", "minimum": 0, "maximum": 100 },
            "partition_deficit_count": { "type": "integer", "minimum": 0, "maximum": 100 },
            "coverage_deficit_count": { "type": "integer", "minimum": 0, "maximum": 100 },
            "oracle_complete_count": { "type": "integer", "minimum": 0, "maximum": 100 },
            "artifact_complete_count": { "type": "integer", "minimum": 0, "maximum": 100 },
            "contaminated_count": { "type": "integer", "minimum": 0, "maximum": 100 },
            "attempt_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_total", "source_path", "source_digest", "maturity_counts"],
      "properties": {
        "proposed_total": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "source_path": { "$ref": "#/$defs/relativePath" },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "maturity_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 10000 } }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "branch", "milestone", "latest_capability", "blocker", "next_action", "observed_at"],
      "properties": {
        "kind": { "enum": ["integration", "continued_development"] },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "milestone": { "type": "string", "minLength": 1, "maxLength": 300 },
        "latest_capability": { "type": "string", "minLength": 1, "maxLength": 500 },
        "blocker": { "type": ["string", "null"], "maxLength": 500 },
        "next_action": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "target_branch": { "type": ["string", "null"], "maxLength": 255 },
        "frozen_candidate": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "last_pushed_commit": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "last_pushed_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "pull_request": { "type": ["object", "null"], "additionalProperties": false, "properties": { "number": { "type": "integer", "minimum": 1 }, "url": { "type": "string", "pattern": "^https://github\\.com/" } } },
        "phase": { "type": ["string", "null"], "enum": ["not pushed", "local gate", "PR open", "CI running", "CI failed", "merge ready", "merged", "dev deployment verified", null] },
        "checks": { "type": ["object", "null"], "additionalProperties": false, "properties": { "passing": { "type": "integer", "minimum": 0 }, "failing": { "type": "integer", "minimum": 0 }, "pending": { "type": "integer", "minimum": 0 } } },
        "ci_started_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "first_actionable_failure": { "type": ["string", "null"], "maxLength": 500 },
        "dev_sync": { "type": ["string", "null"], "maxLength": 160 },
        "merge_gate": { "type": ["string", "null"], "maxLength": 160 },
        "base_commit": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "authority_state": { "type": ["string", "null"], "maxLength": 160 },
        "events": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/deliveryEvent" } }
      }
    },
    "deliveryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commit", "observed_at", "result"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "commit": { "$ref": "#/$defs/gitSha" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "result": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "state", "evidence", "recovery"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "severity": { "type": "string", "minLength": 1, "maxLength": 32 },
        "state": { "type": "string", "minLength": 1, "maxLength": 64 },
        "evidence": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } },
        "recovery": { "type": ["string", "null"], "maxLength": 1000 },
        "opened_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "resolved_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "authority", "expected_claims", "verified_claims", "finding_ids", "result"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "authority": { "type": "string", "minLength": 1, "maxLength": 300 },
        "expected_claims": { "type": "integer", "minimum": 0 },
        "verified_claims": { "type": "integer", "minimum": 0 },
        "finding_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 160 } },
        "result": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "observed_at", "label", "evidence"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "benchmark", "customer_catalog", "work", "history", "findings", "corrections", "freshness", "release"],
      "properties": {
        "readiness": {
          "type": "array",
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/readinessArea" }, { "properties": { "id": { "const": "product_readiness" } } }] },
            { "allOf": [{ "$ref": "#/$defs/readinessArea" }, { "properties": { "id": { "const": "benchmark_readiness" } } }] },
            { "allOf": [{ "$ref": "#/$defs/readinessArea" }, { "properties": { "id": { "const": "commercial_readiness" } } }] },
            { "allOf": [{ "$ref": "#/$defs/readinessArea" }, { "properties": { "id": { "const": "program_health" } } }] }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "benchmark": { "$ref": "#/$defs/benchmark" },
        "customer_catalog": { "$ref": "#/$defs/catalog" },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current_milestone", "active_feature", "tasks", "checkpoints", "blockers", "next_action", "lanes"],
          "properties": {
            "current_milestone": { "type": "string", "minLength": 1, "maxLength": 300 },
            "active_feature": { "type": ["string", "null"], "maxLength": 64 },
            "tasks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["feature_id", "completed", "total"],
              "properties": {
                "feature_id": { "type": "string", "minLength": 1, "maxLength": 64 },
                "completed": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 }
              }
            },
            "checkpoints": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/checkpoint" } },
            "blockers": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
            "next_action": { "type": "string", "minLength": 1, "maxLength": 500 },
            "lanes": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/lane" } }
          }
        },
        "history": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/series" } },
        "findings": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/finding" } },
        "corrections": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/correction" } },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_cutoff", "classification"],
          "properties": {
            "evidence_cutoff": { "$ref": "#/$defs/timestamp" },
            "classification": { "enum": ["current", "stale", "unavailable", "unknown"] },
            "reason": { "type": ["string", "null"], "maxLength": 500 }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible", "approval_current", "explanation"],
          "properties": {
            "eligible": { "type": "boolean" },
            "approval_current": { "type": "boolean" },
            "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    }
  }
}
