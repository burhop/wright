{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/schemas/chatter-conversion-parity-evidence-1.0.json",
  "title": "Wright Chatter Conversion Parity Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "source_identity", "serving_identity", "population", "metrics", "boundary_results", "checks", "status", "material_digest", "observation_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"$ref": "#/$defs/id"},
    "source_identity": {"$ref": "#/$defs/source"},
    "serving_identity": {"$ref": "#/$defs/serving"},
    "population": {"$ref": "#/$defs/population"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "boundary_results": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/boundary"}},
    "checks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/check"}},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "material_digest": {"$ref": "#/$defs/digest"},
    "observation_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "dataset_digest", "membership_digest", "recipe_digest", "environment_lock_digest", "trusted_evaluator_digest"],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "dataset_digest": {"$ref": "#/$defs/digest"},
        "membership_digest": {"$ref": "#/$defs/digest"},
        "recipe_digest": {"$ref": "#/$defs/digest"},
        "environment_lock_digest": {"$ref": "#/$defs/digest"},
        "trusted_evaluator_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "serving": {
      "type": "object", "additionalProperties": false,
      "required": ["exporter_digest", "metadata_digest", "forest_digest", "package_material_digest", "adapter_id", "adapter_version"],
      "properties": {
        "exporter_digest": {"$ref": "#/$defs/digest"},
        "metadata_digest": {"$ref": "#/$defs/digest"},
        "forest_digest": {"$ref": "#/$defs/digest"},
        "package_material_digest": {"$ref": "#/$defs/digest"},
        "adapter_id": {"$ref": "#/$defs/id"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "population": {
      "type": "object", "additionalProperties": false,
      "required": ["row_count", "group_count", "partition_digest", "input_digest", "source_output_digest", "serving_output_digest", "group_overlap_count"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 1},
        "group_count": {"type": "integer", "minimum": 2},
        "partition_digest": {"$ref": "#/$defs/digest"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "source_output_digest": {"$ref": "#/$defs/digest"},
        "serving_output_digest": {"$ref": "#/$defs/digest"},
        "group_overlap_count": {"const": 0}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["class_agreement", "mean_absolute_score_delta", "maximum_absolute_score_delta", "reload_maximum_score_delta", "class_disagreement_count", "mandatory_boundary_disagreement_count"],
      "properties": {
        "class_agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_absolute_score_delta": {"type": "number", "minimum": 0},
        "maximum_absolute_score_delta": {"type": "number", "minimum": 0},
        "reload_maximum_score_delta": {"type": "number", "minimum": 0},
        "class_disagreement_count": {"type": "integer", "minimum": 0},
        "mandatory_boundary_disagreement_count": {"type": "integer", "minimum": 0}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["vector_id", "mandatory", "source_state", "serving_state", "absolute_score_delta", "state"],
      "properties": {
        "vector_id": {"$ref": "#/$defs/id"},
        "mandatory": {"type": "boolean"},
        "source_state": {"enum": ["stable", "chatter", "rejected"]},
        "serving_state": {"enum": ["stable", "chatter", "rejected"]},
        "absolute_score_delta": {"type": "number", "minimum": 0},
        "state": {"enum": ["passed", "failed"]}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "state", "evidence_digest"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "state": {"enum": ["passed", "failed", "blocked"]},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "message": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
