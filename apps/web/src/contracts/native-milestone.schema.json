              "result",
              "observed_at",
              "tested_commit",
              "tested_tree",
              "scope_sha256",
              "author_id",
              "verifier_id",
              "verification_actor_kind",
              "summary",
              "artifacts",
              "counts"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              },
              "check_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "not_run",
                  "unavailable",
                  "inconclusive"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "tested_commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "tested_tree": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "scope_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "author_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "verifier_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification_actor_kind": {
                "enum": ["automated", "agent", "human"]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "artifacts": {
                "type": "array",
                "minItems": 0,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256", "commit"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^(?:docs/programs/engineering-process-platform/|specs/[0-9]{3}-[A-Za-z0-9_-]+/)[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "commit": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  }
                }
              },
              "counts": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "total",
                      "passed",
                      "failed",
                      "skipped",
                      "not_run"
                    ],
                    "properties": {
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "passed": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "failed": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "skipped": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "not_run": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "summary",
              "owner",
              "required_action",
              "task_ids",
              "check_ids",
              "observed_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "required_action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "task_ids": {
                "type": "array",
                "minItems": 0,
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "pattern": "^T[0-9]{3}$"
                }
              },
              "check_ids": {
                "type": "array",
                "minItems": 0,
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
                }
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "next_task_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{3}$"
          }
        },
        "examples": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "execution_mode",
              "check_ids",
              "definition_path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "execution_mode": {
                "enum": ["fixture", "local_computation", "live_mcp"]
              },
              "check_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
                }
              },
              "definition_path": {
                "type": "string",
                "pattern": "^(?:apps|packages|scripts|tests|src|specs|docs)/[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch",
            "target_branch",
            "baseline_commit",
            "candidate_commit",
            "pull_requests",
            "merged_commit",
            "deployment_check_ids"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "target_branch": {
              "const": "dev"
            },
            "baseline_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "candidate_commit": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pull_requests": {
              "type": "array",
              "minItems": 0,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "head_commit", "observed_at"],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://github[.]com/burhop/wright/pull/[1-9][0-9]*$"
                  },
                  "head_commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            },
            "merged_commit": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "deployment_check_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              }
            }
          }
        }
      }
    },
    "attestations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "tested_scope_sha256",
          "current_scope_sha256",
          "commit_tree_matches",
          "artifacts_match",
          "coverage_available"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "tested_scope_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "current_scope_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "commit_tree_matches": {
            "type": "boolean"
          },
          "artifacts_match": {
            "type": "boolean"
          },
          "coverage_available": {
            "type": "boolean"
          }
        }
      }
    },
    "delivery_attested": {
      "type": "boolean"
    }
  }
}
