  inputs: [{"description":"Reviewed analysis basis","item":null,"key":"strength_check_spec","kind":"engineering_document","name":"Reviewed analysis basis","quantity":"one","required":true},{"description":"Analysed STEP","item":null,"key":"strength_check_geometry","kind":"workspace_file","name":"Analysed STEP","quantity":"one","required":true},{"description":"Response fields","item":null,"key":"strength_check_field","kind":"workspace_file","name":"Response fields","quantity":"one","required":true},{"description":"Analysis basis","item":null,"key":"strength_check_basis","kind":"workspace_file","name":"Analysis basis","quantity":"one","required":true}]
