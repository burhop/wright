  inputs: [{"description":"Reviewed specification","item":null,"key":"geometry_check_spec","kind":"engineering_document","name":"Reviewed specification","quantity":"one","required":true},{"description":"Handle STEP","item":null,"key":"geometry_check_geometry","kind":"workspace_file","name":"Handle STEP","quantity":"one","required":true}]
