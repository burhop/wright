  outputs: []
  instructions: "Read the engineering report, reviewed specification, exact geometry checks, final analysis applicability and support/toolpath previews before deciding on this exact 3MF. Failed, stale or missing evidence must be resolved before approval. Requesting changes records the decision; it does not automatically edit or rerun this workflow. Qualification stops before any physical operation. A separately qualified digital simulator may produce only a clearly simulated transfer receipt after this review."
  settings: {"authoring_template":"manual-review"}
  tool: null
  reusable_step: null
end

task report
  name: "Read the engineering results"
  purpose: "Read the engineering results. Preserve the exact current requirements and evidence."
  step_type: work
  group: null
  performed_by: ai_assisted
  inputs: [{"description":"Design specification","item":null,"key":"report_spec","kind":"engineering_document","name":"Design specification","quantity":"one","required":true},{"description":"Geometry checks","item":null,"key":"report_geometry","kind":"engineering_document","name":"Geometry checks","quantity":"one","required":true},{"description":"Strength checks","item":null,"key":"report_strength","kind":"engineering_document","name":"Strength checks","quantity":"one","required":true},{"description":"Slice package","item":null,"key":"report_package","kind":"workspace_file","name":"Slice package","quantity":"one","required":true},{"description":"Handle preview","item":null,"key":"report_preview","kind":"workspace_file","name":"Handle preview","quantity":"one","required":true},{"description":"Exact STEP","item":null,"key":"report_model","kind":"workspace_file","name":"Exact STEP","quantity":"one","required":true},{"description":"Editable model identity","item":null,"key":"report_editable","kind":"engineering_document","name":"Editable model identity","quantity":"one","required":true},{"description":"Final manufacturing and analysis checks","item":null,"key":"report_final_checks","kind":"engineering_document","name":"Final manufacturing and analysis checks","quantity":"one","required":true}]
  outputs: [{"description":"Engineering report","item":null,"key":"report_report","kind":"engineering_document","name":"Engineering report","quantity":"one","required":true}]
  prompt: "Write a concise Markdown engineering report: requested outcome, expected versus measured dimensions with units, each recorded check and its limits, strength-analysis findings and applicability, unresolved issues, and links to exact model, preview and manufacturing files. Keep original no-lifting/no-certification/no-physical-print scope prominent. A review is not physical fit verification. Link raw evidence without making JSON the main report. Never invent passing checks or unobserved outputs. Prepare this report before the print-package review. Separate earlier analysis findings from final manufacturing applicability checks; stale, failed and missing checks must remain visible. Link the exact editable model identity and supplied STEP file. The report itself grants no approval."
  settings: {"authoring_template":"ai-prompt","file_policy":"indexed","output_filename":"results/{{wright.run_id}}/engineering-report.md","output_format":"markdown","run_path_template":"wright.run-path/1","save_output":true}
  tool: null
  reusable_step: null
end

