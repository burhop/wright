  inputs: [{"description":"Reviewed specification","item":null,"key":"manufacturing_check_spec","kind":"engineering_document","name":"Reviewed specification","quantity":"one","required":true},{"description":"Analysed handle STEP","item":null,"key":"manufacturing_check_geometry","kind":"workspace_file","name":"Analysed handle STEP","quantity":"one","required":true},{"description":"Source mesh","item":null,"key":"manufacturing_check_source","kind":"workspace_file","name":"Source mesh","quantity":"one","required":true},{"description":"Repaired mesh","item":null,"key":"manufacturing_check_repaired","kind":"workspace_file","name":"Repaired mesh","quantity":"one","required":true},{"description":"Manufacturing changes and orientation","item":null,"key":"manufacturing_check_changes","kind":"engineering_document","name":"Manufacturing changes and orientation","quantity":"one","required":true},{"description":"Analysis basis","item":null,"key":"manufacturing_check_basis","kind":"workspace_file","name":"Analysis basis","quantity":"one","required":true},{"description":"Prior strength checks","item":null,"key":"manufacturing_check_strength","kind":"engineering_document","name":"Prior strength checks","quantity":"one","required":true},{"description":"Selected exact slice package","item":null,"key":"manufacturing_check_package","kind":"workspace_file","name":"Selected exact slice package","quantity":"one","required":true},{"description":"Exact orientation transforms","item":null,"key":"manufacturing_check_orientations","kind":"engineering_document","name":"Exact orientation transforms","quantity":"one","required":true}]
