+test('listNodeTypes exposes the live safe authoring catalog without changing the graph', async () => {
+  const registry = createBuiltInRegistry();
+  let workingGraph: NodeGraph = {
+    metadata: { id: 'graph-1' as GraphId, name: 'Graph', description: '' },
+    nodes: [],
+    connections: [],
+  };
+  const project = {
+    metadata: { id: 'project-1' as ProjectId, title: 'Project', description: '' },
+    graphs: { [workingGraph.metadata!.id!]: workingGraph },
+    plugins: [],
+  } as Project;
+  const helpers = buildAiGraphBuilderExternalFunctions({
+    project,
+    referencedProjects: {},
+    registry,
+    catalog: createCatalog(registry, project),
+    showChanges: () => assert.fail('listNodeTypes must not publish graph changes'),
+    workingGraph: () => workingGraph,
+    setWorkingGraph: (nextGraph) => {
+      workingGraph = nextGraph;
+    },
+  });
+
+  const result = (await helpers.listNodeTypes?.({} as ExternalFunctionProcessContext, {
+    query: 'input output text',
+  })) as { type: 'string'; value: string };
+  const catalogResult = JSON.parse(result.value) as {
+    choices: Array<{ authoringChoiceId: string; nodeType: string }>;
+    guidance: string;
+  };
+
+  assert.equal(result.type, 'string');
+  assert.deepEqual(workingGraph.nodes, []);
+  assert.ok(catalogResult.choices.some((entry) => entry.nodeType === 'graphInput'));
+  assert.ok(catalogResult.choices.some((entry) => entry.nodeType === 'graphOutput'));
+  assert.ok(catalogResult.choices.some((entry) => entry.nodeType === 'text'));
+  assert.match(catalogResult.guidance, /authoringChoiceId/);
+});
