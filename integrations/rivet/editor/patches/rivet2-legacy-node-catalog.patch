+function resolveAiGraphBuilderNodeTypeQuery(rawQuery: unknown): string {
+  const query = isRecord(rawQuery) ? readStringField(rawQuery, 'query') : rawQuery;
+  return typeof query === 'string' ? stripStringWrapper(query).slice(0, 200) : '';
+}
+
+function listAiGraphBuilderNodeTypes(catalog: GraphBuilderAuthoringCatalogSnapshot, rawQuery: unknown): string {
+  const query = resolveAiGraphBuilderNodeTypeQuery(rawQuery);
+  const queryTokens = query
+    .toLowerCase()
+    .split(/[^a-z0-9]+/)
+    .filter((token) => token.length > 1);
+  const entries = catalog.listEntries().filter((entry) => entry.capabilities.createWithDefaults);
+  const scoredEntries = entries
+    .map((entry) => {
+      const exactLabels = [entry.authoringChoiceId, entry.nodeType, entry.displayName, ...entry.aliases].map((label) =>
+        label.toLowerCase(),
+      );
+      const searchableText = [...exactLabels, entry.description].join(' ').toLowerCase();
+      const score = queryTokens.reduce((total, token) => {
+        if (exactLabels.some((label) => label === token)) {
+          return total + 4;
+        }
+        if (exactLabels.some((label) => label.includes(token))) {
+          return total + 2;
+        }
+        return searchableText.includes(token) ? total + 1 : total;
+      }, 0);
+      return { entry, score };
+    })
+    .filter(({ score }) => queryTokens.length === 0 || score > 0)
+    .sort((left, right) => right.score - left.score || left.entry.displayName.localeCompare(right.entry.displayName));
+
+  const starterNodeTypes = new Set([
+    'graphInput',
+    'graphOutput',
+    'text',
+    'number',
+    'boolean',
+    'expression',
+    'passthrough',
+    'comment',
+  ]);
+  const starterEntries = entries
+    .filter((entry) => entry.family === 'registered' && starterNodeTypes.has(entry.nodeType))
+    .sort((left, right) => left.displayName.localeCompare(right.displayName));
+  const selectedEntries = [...scoredEntries.map(({ entry }) => entry), ...starterEntries]
+    .filter(
+      (entry, index, all) =>
+        all.findIndex((candidate) => candidate.authoringChoiceId === entry.authoringChoiceId) === index,
+    )
+    .slice(0, 40);
+
+  return JSON.stringify({
+    query,
+    totalAvailable: entries.length,
+    matchCount: scoredEntries.length,
+    choices: selectedEntries.map((entry) => ({
+      authoringChoiceId: entry.authoringChoiceId,
+      nodeType: entry.nodeType,
+      displayName: entry.displayName,
+      description: entry.description,
+      aliases: entry.aliases,
+    })),
+    guidance:
+      scoredEntries.length === 0 && queryTokens.length > 0
+        ? 'No direct matches were found. The choices include safe starter nodes; try a shorter capability query if needed.'
+        : 'Pass authoringChoiceId to createNode. Use getNodePorts and getNodeData after creation.',
+  });
+}
