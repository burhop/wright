 import { layoutGraphBuilderCreatedNodes } from './deterministicGraphLayout.js';
 
 const RULES_VERSION = 'graph-builder-authoring-v1';
+const WRIGHT_DOCUMENT_TOOL = 'wright-workspace-files__write_text_document';
+
+export function validateGraphBuilderDeliverableEffect(input: {
+  project: GraphBuilderAuthoringProject;
+  graphId: GraphId;
+  requestedDeliverable: GraphBuilderRequestedDeliverable;
+}): GraphValidationResult {
+  if (input.requestedDeliverable.kind === 'value_only') {
+    return validation([]);
+  }
+  const graph = input.project.graphs[input.graphId];
+  if (!graph) {
+    return validation([
+      diagnostic({
+        key: `deliverable:missing-graph:${input.graphId}`,
+        ruleId: 'requested-deliverable-effect',
+        graphId: input.graphId,
+        message: 'The graph for the requested deliverable is unavailable.',
+      }),
+    ]);
+  }
+  if (input.requestedDeliverable.kind !== 'workspace_document') {
+    return validation([
+      diagnostic({
+        key: `deliverable:domain-producer-required:${input.graphId}:${input.requestedDeliverable.kind}`,
+        ruleId: 'requested-deliverable-domain-producer',
+        graphId: input.graphId,
+        message:
+          'This native deliverable requires a reviewed Solid Edge/domain artifact producer. The generic document writer and LLM text cannot satisfy it.',
+      }),
+    ]);
+  }
+  const candidates = graph.nodes.filter(
+    (node) =>
+      node.type === 'mcpToolCall' &&
+      (node.data as { toolName?: unknown }).toolName === WRIGHT_DOCUMENT_TOOL,
+  );
+  if (candidates.length !== 1) {
+    return validation([
+      diagnostic({
+        key: `deliverable:document-producer-count:${input.graphId}`,
+        ruleId: 'requested-deliverable-producer',
+        graphId: input.graphId,
+        message:
+          'Add exactly one “Create workspace document” MCP Tool Call using the reviewed Wright document producer.',
+      }),
+    ]);
+  }
+  const producer = candidates[0]!;
+  const data = producer.data as {
+    toolArguments?: unknown;
+    useToolArgumentsInput?: unknown;
+    useToolNameInput?: unknown;
+  };
+  const diagnostics: GraphDiagnostic[] = [];
+  if (data.useToolNameInput === true) {
+    diagnostics.push(
+      diagnostic({
+        key: `deliverable:dynamic-tool:${input.graphId}:${producer.id}`,
+        ruleId: 'requested-deliverable-producer',
+        graphId: input.graphId,
+        nodeId: producer.id,
+        message: 'Create workspace document must keep its exact reviewed tool identity.',
+      }),
+    );
+  }
+  const argumentsConnection = graph.connections.some(
+    (connection) =>
+      connection.inputNodeId === producer.id &&
+      (connection.inputId === 'toolArguments' || connection.inputId === 'arguments'),
+  );
+  let staticArguments: Record<string, unknown> | undefined;
+  if (typeof data.toolArguments === 'string' && data.toolArguments.trim()) {
+    try {
+      const value: unknown = JSON.parse(data.toolArguments);
+      if (value && typeof value === 'object' && !Array.isArray(value)) {
+        staticArguments = value as Record<string, unknown>;
+      }
+    } catch {
+      // Reported below as incomplete producer arguments.
+    }
+  }
+  if (!argumentsConnection) {
+    if (
+      !staticArguments ||
+      typeof staticArguments.content !== 'string' ||
+      typeof staticArguments.mediaType !== 'string' ||
+      staticArguments.relativePath !== input.requestedDeliverable.suggestedRelativePath ||
+      staticArguments.overwrite !== false
+    ) {
+      diagnostics.push(
+        diagnostic({
+          key: `deliverable:document-inputs:${input.graphId}:${producer.id}`,
+          ruleId: 'requested-deliverable-inputs',
+          graphId: input.graphId,
+          nodeId: producer.id,
+          message:
+            'Create workspace document needs the confirmed relative path, content, media type, and overwrite=false through static arguments or one connected arguments object.',
+        }),
+      );
+    }
+  }
+  const graphOutputIds = new Set(
+    graph.nodes.filter((node) => node.type === 'graphOutput').map((node) => node.id),
+  );
+  if (
+    !graph.connections.some(
+      (connection) =>
+        connection.outputNodeId === producer.id && graphOutputIds.has(connection.inputNodeId),
+    )
+  ) {
+    diagnostics.push(
+      diagnostic({
+        key: `deliverable:document-output:${input.graphId}:${producer.id}`,
+        ruleId: 'requested-deliverable-output',
+        graphId: input.graphId,
+        nodeId: producer.id,
+        message: 'Connect the Create workspace document result to Graph Output.',
+      }),
+    );
+  }
+  return validation(diagnostics);
+}
 
