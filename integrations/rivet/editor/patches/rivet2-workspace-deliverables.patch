diff --git a/packages/app/src/features/graphBuilder/requestedDeliverable.test.ts b/packages/app/src/features/graphBuilder/requestedDeliverable.test.ts
new file mode 100644
index 00000000..5d95b4bf
--- /dev/null
+++ b/packages/app/src/features/graphBuilder/requestedDeliverable.test.ts
@@ -0,0 +1,135 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import type { GraphId, NodeConnection, NodeId, PortId } from '@valerypopoff/rivet2-core';
+import {
+  graphBuilderRequestedDeliverableSchema,
+  type GraphBuilderAuthoringProject,
+  type GraphBuilderRequestedDeliverable,
+} from '../../domain/graphBuilder/index.js';
+import { validateGraphBuilderDeliverableEffect } from './authoringSemantics.js';
+
+const graphId = 'main' as GraphId;
+const deliverable: GraphBuilderRequestedDeliverable = {
+  kind: 'workspace_document',
+  label: 'Design review',
+  suggestedRelativePath: 'reports/design-review.md',
+  confirmedAt: '2026-08-21T20:00:00Z',
+  confirmationRevision: 0,
+};
+
+function project({
+  connectOutput = true,
+  toolName = 'wright-workspace-files__write_text_document',
+}: {
+  connectOutput?: boolean;
+  toolName?: string;
+} = {}) {
+  const connections: NodeConnection[] = connectOutput
+    ? [
+        {
+          outputNodeId: 'writer' as NodeId,
+          outputId: 'result' as PortId,
+          inputNodeId: 'output' as NodeId,
+          inputId: 'value' as PortId,
+        },
+      ]
+    : [];
+  return {
+    metadata: {
+      id: 'project',
+      title: 'Document workflow',
+      description: '',
+      mainGraphId: graphId,
+    },
+    graphs: {
+      [graphId]: {
+        metadata: { id: graphId, name: 'Main' },
+        nodes: [
+          {
+            id: 'writer',
+            type: 'mcpToolCall',
+            title: 'Create workspace document',
+            visualData: { x: 0, y: 0 },
+            data: {
+              toolName,
+              useToolNameInput: false,
+              useToolArgumentsInput: false,
+              toolArguments: JSON.stringify({
+                relativePath: deliverable.suggestedRelativePath,
+                content: '# Design review\n',
+                mediaType: 'text/markdown',
+                overwrite: false,
+              }),
+            },
+          },
+          {
+            id: 'output',
+            type: 'graphOutput',
+            title: 'Document artifact',
+            visualData: { x: 200, y: 0 },
+            data: { id: 'artifact', dataType: 'object' },
+          },
+        ],
+        connections,
+      },
+    },
+    nodePrefabs: {},
+  } as unknown as GraphBuilderAuthoringProject;
+}
+
+test('requested deliverable requires an explicit user-confirmed kind and document path', () => {
+  assert.equal(
+    graphBuilderRequestedDeliverableSchema.safeParse({
+      label: 'Design review',
+      confirmedAt: '2026-08-21T20:00:00Z',
+      confirmationRevision: 0,
+    }).success,
+    false,
+  );
+  assert.equal(
+    graphBuilderRequestedDeliverableSchema.safeParse({
+      ...deliverable,
+      suggestedRelativePath: undefined,
+    }).success,
+    false,
+  );
+  assert.equal(graphBuilderRequestedDeliverableSchema.safeParse(deliverable).success, true);
+});
+
+test('workspace document accepts only the exact producer and authoritative output dependency', () => {
+  assert.deepEqual(
+    validateGraphBuilderDeliverableEffect({
+      project: project(),
+      graphId,
+      requestedDeliverable: deliverable,
+    }).blockingDiagnosticKeys,
+    [],
+  );
+  const disconnected = validateGraphBuilderDeliverableEffect({
+    project: project({ connectOutput: false }),
+    graphId,
+    requestedDeliverable: deliverable,
+  });
+  assert.equal(disconnected.blockingDiagnosticKeys.length, 1);
+  assert.match(disconnected.diagnostics[0]!.message, /Graph Output/);
+
+  const substitute = validateGraphBuilderDeliverableEffect({
+    project: project({ toolName: 'other__return_path' }),
+    graphId,
+    requestedDeliverable: deliverable,
+  });
+  assert.equal(substitute.blockingDiagnosticKeys.length, 1);
+  assert.match(substitute.diagnostics[0]!.message, /exactly one/i);
+});
+
+test('native CAD and STL stay fail-closed until a reviewed domain producer is available', () => {
+  for (const kind of ['native_cad', 'stl_mesh'] as const) {
+    const result = validateGraphBuilderDeliverableEffect({
+      project: project(),
+      graphId,
+      requestedDeliverable: { ...deliverable, kind, suggestedRelativePath: undefined },
+    });
+    assert.equal(result.blockingDiagnosticKeys.length, 1);
+    assert.match(result.diagnostics[0]!.message, /Solid Edge\/domain artifact producer/);
+  }
+});
