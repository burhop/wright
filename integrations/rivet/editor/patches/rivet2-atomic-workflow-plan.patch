+test('legacy draft runner applies a connected workflow plan atomically', async () => {
+  let planResult: unknown;
+  const result = await runLegacyGraphBuilderDraft(
+    options(async ({ externalFunctions, onUserEvent }) => {
+      planResult = await externalFunctions.applyWorkflowPlan!({} as ExternalFunctionProcessContext, {
+        nodes: [
+          {
+            alias: 'providers',
+            nodeType: 'registered:mcpToolCall',
+            settings: {
+              title: 'List providers',
+              toolName: 'solid-edge-mcp__cad.list_providers',
+              toolArguments: '{}',
+              useToolNameInput: false,
+              useToolArgumentsInput: false,
+              useToolCallIdInput: false,
+            },
+          },
+          {
+            alias: 'providerId',
+            nodeType: 'registered:extractObjectPath',
+            settings: { path: '$.providerId', usePathInput: false },
+          },
+          {
+            alias: 'arguments',
+            nodeType: 'registered:object',
+            settings: { jsonTemplate: '{"providerId":"{{providerId}}"}' },
+          },
+          {
+            alias: 'status',
+            nodeType: 'registered:mcpToolCall',
+            title: 'Get provider status',
+            settings: {
+              toolName: 'solid-edge-mcp__cad.get_status',
+              toolArguments: '{}',
+              useToolNameInput: false,
+              useToolArgumentsInput: true,
+              useToolCallIdInput: false,
+            },
+          },
+          {
+            alias: 'result',
+            nodeType: 'registered:graphOutput',
+            settings: { dataType: 'object', id: 'result' },
+          },
+        ],
+        connections: [
+          {
+            sourceAlias: 'providers',
+            sourcePortId: 'response',
+            destAlias: 'providerId',
+            destPortId: 'object',
+          },
+          {
+            sourceAlias: 'providerId',
+            sourcePortId: 'match',
+            destAlias: 'arguments',
+            destPortId: 'providerId',
+          },
+          {
+            sourceAlias: 'arguments',
+            sourcePortId: 'output',
+            destAlias: 'status',
+            destPortId: 'toolArguments',
+          },
+          {
+            sourceAlias: 'status',
+            sourcePortId: 'response',
+            destAlias: 'result',
+            destPortId: 'value',
+          },
+        ],
+      });
+      onUserEvent.finalMessage?.({ type: 'string', value: 'Applied a connected workflow plan.' });
+    }),
+  );
+
+  assert.equal(result.status, 'ready-for-preview');
+  if (result.status !== 'ready-for-preview') return;
+  assert.equal(result.draft.graphs[graphId]!.nodes.length, 5);
+  assert.equal(result.draft.graphs[graphId]!.connections.length, 4);
+  assert.equal(
+    result.draft.graphs[graphId]!.nodes.find((node) => node.type === 'mcpToolCall')!.title,
+    'List providers',
+  );
+  assert.deepEqual(planResult, {
+    type: 'object',
+    value: {
+      aliases: {
+        providers: result.draft.graphs[graphId]!.nodes.find((node) => node.title === 'List providers')!.id,
+        providerId: result.draft.graphs[graphId]!.nodes.find((node) => node.type === 'extractObjectPath')!.id,
+        arguments: result.draft.graphs[graphId]!.nodes.find((node) => node.type === 'object')!.id,
+        status: result.draft.graphs[graphId]!.nodes.find((node) => node.title === 'Get provider status')!.id,
+        result: result.draft.graphs[graphId]!.nodes.find((node) => node.type === 'graphOutput')!.id,
+      },
+      connectionCount: 4,
+      nodeCount: 5,
+    },
+  });
+});
