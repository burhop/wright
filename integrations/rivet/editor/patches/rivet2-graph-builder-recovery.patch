+test('legacy draft runner returns command validation errors so the agent can recover', async () => {
+  let rejectedResult: unknown;
+  const result = await runLegacyGraphBuilderDraft(
+    options(async ({ externalFunctions, onUserEvent }) => {
+      rejectedResult = await externalFunctions.createNode!(
+        {} as ExternalFunctionProcessContext,
+        'Not A Registered Node Type',
+      );
+      await externalFunctions.createNode!({} as ExternalFunctionProcessContext, 'Text');
+      onUserEvent.finalMessage?.({ type: 'string', value: 'Recovered and created a text node.' });
+    }),
+  );
+
+  assert.equal(result.status, 'ready-for-preview');
+  assert.equal(result.status === 'ready-for-preview' ? result.draft.graphs[graphId]?.nodes.length : 0, 1);
+  assert.deepEqual(rejectedResult, {
+    type: 'object',
+    value: {
+      draftRevision: 0,
+      error: 'Unknown or unsupported node type: Not A Registered Node Type',
+      retryable: true,
+    },
+  });
+});
+
+test('legacy draft runner can configure MCP discovery and static tool calls', async () => {
+  const result = await runLegacyGraphBuilderDraft(
+    options(async ({ externalFunctions, onUserEvent }) => {
+      const discovery = await externalFunctions.createNode!(
+        {} as ExternalFunctionProcessContext,
+        'MCP Discovery',
+      );
+      const toolCall = await externalFunctions.createNode!({} as ExternalFunctionProcessContext, 'MCP Tool Call');
+      const discoveryId = (discovery.value as { result: string }).result;
+      const toolCallId = (toolCall.value as { result: string }).result;
+
+      await externalFunctions.editNode!({} as ExternalFunctionProcessContext, discoveryId, 'serverId', 'brep-server');
+      await externalFunctions.editNode!({} as ExternalFunctionProcessContext, toolCallId, 'serverId', 'brep-server');
+      await externalFunctions.editNode!({} as ExternalFunctionProcessContext, toolCallId, 'toolName', 'create_model');
+      await externalFunctions.editNode!(
+        {} as ExternalFunctionProcessContext,
+        toolCallId,
+        'toolArguments',
+        '{"width":40,"height":20,"depth":10}',
+      );
+      await externalFunctions.editNode!(
+        {} as ExternalFunctionProcessContext,
+        toolCallId,
+        'useToolNameInput',
+        false,
+      );
+      await externalFunctions.editNode!(
+        {} as ExternalFunctionProcessContext,
+        toolCallId,
+        'useToolArgumentsInput',
+        false,
+      );
+      onUserEvent.finalMessage?.({ type: 'string', value: 'Configured the BREP MCP nodes.' });
+    }),
+  );
+
+  assert.equal(result.status, 'ready-for-preview');
+  if (result.status !== 'ready-for-preview') return;
+  const discovery = result.draft.graphs[graphId]!.nodes.find((node) => node.type === 'mcpDiscovery')!;
+  const toolCall = result.draft.graphs[graphId]!.nodes.find((node) => node.type === 'mcpToolCall')!;
+  assert.equal((discovery.data as { serverId?: string }).serverId, 'brep-server');
+  assert.deepEqual(toolCall.data, {
+    ...(toolCall.data as Record<string, unknown>),
+    serverId: 'brep-server',
+    toolName: 'create_model',
+    toolArguments: '{"width":40,"height":20,"depth":10}',
+    useToolNameInput: false,
+    useToolArgumentsInput: false,
+  });
+});
