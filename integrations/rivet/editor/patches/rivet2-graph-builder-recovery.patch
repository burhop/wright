+const WRIGHT_MCP_NODE_TYPES = new Set(['mcpDiscovery', 'mcpToolCall']);
+const WRIGHT_OWNED_MCP_CONNECTION_DEFAULTS: Readonly<Record<string, PortableJsonValue>> = {
+  serverId: '',
+  serverUrl: '',
+  command: '',
+  args: [],
+  env: {},
+  environment: {},
+  headers: {},
+  authorization: '',
+};
+
+function applyWrightMcpNodeDefaults(node: ChartNode): ChartNode {
+  if (!WRIGHT_MCP_NODE_TYPES.has(node.type)) {
+    return node;
+  }
+
+  const nextNode = cloneDeep(node);
+  const data = nextNode.data as Record<string, unknown>;
+  for (const [key, value] of Object.entries(WRIGHT_OWNED_MCP_CONNECTION_DEFAULTS)) {
+    if (Object.hasOwn(data, key)) {
+      data[key] = cloneDeep(value);
+    }
+  }
+  if (node.type === 'mcpToolCall') {
+    data.useToolNameInput = false;
+  }
+  return nextNode;
+}
