+function lintLegacyMcpConfiguration(graph: NodeGraph): string[] {
+  const warnings: string[] = [];
+  for (const node of graph.nodes) {
+    if (node.type !== 'mcpToolCall') continue;
+    const data = node.data as Record<string, unknown>;
+    const hasConnectionSettings = [
+      'serverId',
+      'serverUrl',
+      'command',
+      'args',
+      'env',
+      'environment',
+      'headers',
+      'authorization',
+    ].some((key) => {
+      const value = data[key];
+      if (Array.isArray(value)) return value.length > 0;
+      if (value && typeof value === 'object') return Object.keys(value).length > 0;
+      return value !== undefined && value !== null && value !== '';
+    });
+    if (hasConnectionSettings) {
+      warnings.push(
+        `MCP Tool Call ${node.id} contains connection settings. Leave server connection settings empty; Wright binds the workspace tool at run time.`,
+      );
+    }
+    if (data.useToolNameInput !== false) {
+      warnings.push(
+        `MCP Tool Call ${node.id} has a dynamic tool identity. Set useToolNameInput to false and configure one exact toolName.`,
+      );
+    }
+    if (typeof data.toolName !== 'string' || !data.toolName.trim()) {
+      warnings.push(
+        `MCP Tool Call ${node.id} has no toolName. Configure the exact workspace tool name before finishing.`,
+      );
+    }
+  }
+
+  return warnings;
+}
