+  const schemaFailure = formatLegacyGraphBuilderFailure(
+    new Error('translation_invalid arguments did not match schema secret-token'),
+  );
+  const timeoutFailure = formatLegacyGraphBuilderFailure(new Error('request timed out at https://private.example'));
+  const unknownFailure = formatLegacyGraphBuilderFailure(new Error('private provider detail secret-token'));
+
+  assert.equal(schemaFailure, 'The AI returned a graph command that did not match the required format.');
+  assert.equal(timeoutFailure, 'The AI request timed out before the graph draft was complete.');
+  assert.equal(unknownFailure, 'The Graph Builder request failed before the graph draft was complete.');
+  assert.doesNotMatch(`${schemaFailure} ${timeoutFailure} ${unknownFailure}`, /secret-token|private\.example/);
+});
