+/**
+ * Turns provider and transport failures into a small user-facing reason without
+ * copying response bodies, prompts, URLs, credentials, or other raw details
+ * into the in-editor activity transcript.
+ */
+export function formatLegacyGraphBuilderFailure(error: unknown): string {
+  const message = error instanceof Error ? error.message.toLowerCase() : '';
+  if (
+    message.includes('translation_invalid') ||
+    message.includes('tool-decision') ||
+    (message.includes('argument') && message.includes('schema'))
+  ) {
+    return 'The AI returned a graph command that did not match the required format.';
+  }
+  if (message.includes('timeout') || message.includes('timed out')) {
+    return 'The AI request timed out before the graph draft was complete.';
+  }
+  if (message.includes('401') || message.includes('403') || message.includes('unauthorized')) {
+    return 'Rivet AI authorization expired while the graph draft was running.';
+  }
+  if (message.includes('502')) {
+    return 'The AI bridge rejected the last graph command after retrying it.';
+  }
+  return 'The Graph Builder request failed before the graph draft was complete.';
+}
