task validate_design
  name: "5. Validate the actual CAD and capture three views"
  purpose: "5. Validate the actual CAD and capture three views"
  step_type: "work"
  performed_by: "ai_assisted"
  group: null
  inputs: [{"key":"validate_design_design_document","name":"validate design design document","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"validate_design_test_plan","name":"validate design test plan","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"validate_design_created_design","name":"validate design created design","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  outputs: [{"key":"validate_design_response","name":"validate design response","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"isometric","name":"isometric","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"top","name":"top","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"front","name":"front","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  prompt: "Inspect only the exact document/revision/build from the connected creation result. Read the document to confirm its revision. Apply the connected pre-existing test plan without changing requirements. Separate observations from presentation captures. First call inspect_model with view=null and checks=[\"machining\"] to obtain actual B-rep holes/round faces and positions. Then capture view=isometric, top and front, exactly once each, with checks=[]. Use actual numeric bounds, solids, volumes, hole/round-face diameter, axis, at_mm and length_mm to evaluate the relevant requirements. Do not infer dimensions from pixels or treat written source as measured geometry. Record every measured value, tolerance, comparison and evidence location. Mark missing evidence UNVERIFIED, not PASS. Evaluate only requirements assigned to CAD geometry and CAD captures in this stage. Return presentation/rendering and final-review requirements separately in deferred_tests with their planned evaluation stage; they must not make the CAD overall_status FAIL or UNVERIFIED simply because downstream work has not run. Do not judge studio appearance from CAD colors. For assemblies or printing, discover and read the exact relevant skills and inspect the declared fit/interference, joint/animation or dfam checks. Read exact-revision built kinematics and fit/animation results from read_design before requesting another computation. Reuse those actual results when they already cover the declared tests, citing their bounded sampling; do not infer continuous collision freedom. These additional numeric checks use view=null so each named capture still has one unambiguous response. Never edit the design here. Report unfinished checks and scope gaps honestly. The runtime saves declared returned images; you need not create local files. Return JSON with document_id, revision, build_id, observations (complete numerical measurement objects), tests [{requirement_id,expected,actual,tolerance,status,evidence}], overall_status, deferred_tests and unresolved_findings. No human acceptance or certification is implied.\nEnvelope identifiers: if you record a new assumption, affected_outputs must use these declared output IDs: validate_design_response, isometric, top, front. Requirement IDs such as R01 belong in the document and test table, not affected_outputs. Preserve upstream assumptions as cited design choices; do not reissue them as new assumptions for this step."
  settings: {"authoring_template":"mcp-task","output_format":"json","save_output":true,"output_filename":"render-proofs/native-chain-001/renders/{{wright.run_id}}/validate_design.json","file_policy":"indexed","run_path_template":"wright.run-path/1","mcp_server":"stevecad-mcp","mcp_task_tools":["read_design","inspect_model","api_reference","list_skills","read_skill"],"max_tool_calls":16,"timeout_seconds":600,"mcp_context_budget_bytes":1048576,"expected_files":"render-proofs/native-chain-001/renders/{{wright.run_id}}/cad-isometric.png\nrender-proofs/native-chain-001/renders/{{wright.run_id}}/cad-top.png\nrender-proofs/native-chain-001/renders/{{wright.run_id}}/cad-front.png","expected_file_ports":{"isometric":"render-proofs/native-chain-001/renders/{{wright.run_id}}/cad-isometric.png","top":"render-proofs/native-chain-001/renders/{{wright.run_id}}/cad-top.png","front":"render-proofs/native-chain-001/renders/{{wright.run_id}}/cad-front.png"},"mcp_image_outputs":"{\"isometric\": {\"tool\": \"inspect_model\", \"arguments\": {\"view\": \"isometric\"}, \"image_index\": 0}, \"top\": {\"tool\": \"inspect_model\", \"arguments\": {\"view\": \"top\"}, \"image_index\": 0}, \"front\": {\"tool\": \"inspect_model\", \"arguments\": {\"view\": \"front\"}, \"image_index\": 0}}"}
  tool: null
  reusable_step: null
end

