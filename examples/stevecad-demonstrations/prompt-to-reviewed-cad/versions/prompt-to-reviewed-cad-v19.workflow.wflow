  from: "design_prompt.prompt"
  to: "design_document.design_document_design_prompt"
  label: "design document design prompt"
  when: null
end

task test_plan
  name: "3. Define the tests before building"
  purpose: "3. Define the tests before building"
  step_type: "work"
  performed_by: "ai_assisted"
  group: null
  inputs: [{"key":"test_plan_design_document","name":"test plan design document","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"test_plan_supplied_prompt","name":"test plan supplied prompt","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  outputs: [{"key":"test_plan_response","name":"test plan response","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  prompt: "Create a compact test plan in at most 2200 words for the connected design document. Do not repeat its prose. For every requirement ID give the expected value, units, tolerance, numerical comparison and actual geometric observation needed. Preserve each test's exact named subject, subset, coordinate frame and count; do not apply a subset bound to the whole assembly or invent extra supports/fasteners beyond the specification. Include dimensions, solid/component counts, feature counts/positions/axes/depths and volume where specified; add interfaces/clearances/motion checks when the design requires them. Do not invent inspection capabilities or accept source code as proof of generated geometry. Missing evidence must be UNVERIFIED, measured noncompliance FAIL. Include a traceability table and required isometric/top/front captures. Assign each test its evaluation stage. The CAD inspection checks geometry and captures only. Rendering/appearance and final-document tests are deferred to the final review, after those outputs exist; they are not failures during CAD inspection. A final visual comparison can check visible feature count, silhouette, orientation and appearance; it must not claim metrical verification from pixels. This plan precedes CAD creation and cannot be weakened later to obtain a pass. Output Markdown.\nEnvelope identifiers: if you record a new assumption, affected_outputs must use these declared output IDs: test_plan_response. Requirement IDs such as R01 belong in the document and test table, not affected_outputs. Preserve upstream assumptions as cited design choices; do not reissue them as new assumptions for this step.\nUse the connected original design prompt to verify requirement provenance before construction. Keep a simple single-part plan to about 600 words, using concise tables while preserving all values, tolerances and methods. Do not promote a documented presentation choice into a new supplied requirement. Evaluate presentation-only finish on the three studio renders, and original CAD captures for geometric view evidence, unless the original prompt explicitly requires a CAD display finish. Keep supplied geometry requirements intact; flag any specification conflict explicitly."
  settings: {"authoring_template":"ai-prompt","output_format":"markdown","save_output":true,"output_filename":"render-proofs/native-chain-001/renders/{{wright.run_id}}/test_plan.md","file_policy":"indexed","run_path_template":"wright.run-path/1"}
  tool: null
  reusable_step: null
end

