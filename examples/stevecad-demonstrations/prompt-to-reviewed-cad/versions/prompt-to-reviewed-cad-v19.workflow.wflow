  type: "item"
  from: "design_document.design_document_response"
  to: "test_plan.test_plan_design_document"
  label: "test plan design document"
  when: null
end

task create_design
  name: "4. Build the design in SteveCAD"
  purpose: "4. Build the design in SteveCAD"
  step_type: "work"
  performed_by: "ai_assisted"
  group: null
  inputs: [{"key":"create_design_design_document","name":"create design design document","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  outputs: [{"key":"create_design_response","name":"create design response","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  prompt: "Use the engineering design document to create a NEW editable SteveCAD document for this run. If the supplied prompt explicitly identifies a previously created document/revision/build for this exercise's recovery, reconcile that exact document instead of creating a duplicate: read its source/current revision, compare with the supplied design, then generate or inspect the existing revision. Report its original identity honestly. At most one correction to this explicitly identified exercise document is permitted after a confirmed feature error or measured mismatch. Your deliverable is the generated geometry and exact document receipt. Geometric validation, CAD screenshots, presentation rendering and the review are separate downstream tasks. Do not treat those later tasks as prerequisites for completing this CAD receipt. Do not call Model.material by inventing a physical material just to tint a body. When the design document declares a material or a labeled reference-material assumption, read the discovered materials skill and assign it with the specified native finish/color before returning the component. Record unknown material IDs and do not claim physical mass or properties from an envelope. Use the name Wright reviewed design {{wright.run_id}}. Call api_reference without a name, then read the exact method references needed before writing source; avoid fetching an entire class when a few method signatures suffice. Single-part modeling does not require a named skill. For an assembly or specialized capability, call list_skills and read only exact skill names actually returned. Do not invent skill names or edit an existing user document. Use the documented Model/Component/Design API and named editable features; prefer Model.hole for holes so native geometric inspection can identify them. Use valid lowercase feature IDs, separate from requirement IDs. Do not assume a face's sketch origin is its centroid; use the documented or supplied coordinate convention. Use as few calls as practical; batch the initial source in write_design. Generate the saved exact revision. You may correct your own new document at most once after an explicit failed build or measured mismatch: read its current source/revision and use one uniquely matching full fragment in edit_design, or one revision-checked write_design batch for the explicitly identified owned multi-file document. A batch preserves all unaffected files and records every corrected file; it is one correction, not authority for an unbounded rewrite loop. Then generate the new revision. A timeout or queued build is not a completed design. The saved reconciliation contract permits at most four same-argument observations of generate_model while its exact receipt is queued/running; this joins the documented existing build and never authorizes another document or revision. On every generate_model request include document_id, revision, branch=null, download=null and route=false explicitly so the observation matches the accepted contract. Inspect component feature errors as well as the top-level build status. For an assembly, verify every required moving instance belongs to the correct connected rigid/joint group; do not leave motor housings, horns or retaining hardware independently grounded. Declare and execute required fit/animation checks in the source; a named animation with check=False is not a performed collision test. An open semicircular groove is not a closed through pivot bore. Preserve its document/build identities and report the actual condition without creating duplicate designs or replaying uncertain mutations. Do not request one-time download credentials. On success return a JSON object containing document_id, revision, build_id, document_url, source_code, document_kind, generated_measurements and the names of the created features/components. Include source_files for a multi-file design and actual kinematics/fit/print metadata when available. Preserve supplied requirements.\nEnvelope identifiers: if you record a new assumption, affected_outputs must use these declared output IDs: create_design_response. Requirement IDs such as R01 belong in the document and test table, not affected_outputs. Preserve upstream assumptions as cited design choices; do not reissue them as new assumptions for this step.\nFor a Z-directed through hole in a box that starts at Z=0, anchor Model.hole to the actual top face of the target body using a STRING selector, for example on=\"block.top\", not a Python attribute and not the global XY plane at the bottom. Specify the full known thickness as depth and verify the returned volume. Use the supplied coordinate convention. The saved write/edit receipt and successful generate_model response already provide the current revision, built geometry and feature status. Do not make a redundant read_design call after generation. Reserve read_design for the explicit recovery case or revision-safe correction. The selected provider does not declare repeatability for read_design, so Wright will reject a duplicate completed call within this task. Do not vary arguments to evade that guard. Validation independently reads the document in its own stage.\nVerified basic API pattern, with dimensions/locations replaced by this design's actual specified values:\nmodel = Model(\"part\")\nmodel.box(\"stock\", length=L, width=W, height=H, at=(0,0,0), centered=False)\nmodel.hole(\"bore\", on=\"stock.top\", points=[(x,y)], diameter=d, depth=H, kind=\"simple\")\nresult = model.result()\nThe box method returns None, and Model.feature(...) does not provide a Python .top attribute. Do not write stock=model.box(...), stock.top or model.feature(...).top. Selectors such as stock.top are quoted strings. This is API usage guidance, not additional geometry or a restriction to blocks. Adapt feature IDs, stock shape and operations to the supplied design."
  settings: {"authoring_template":"mcp-task","output_format":"json","save_output":true,"output_filename":"render-proofs/native-chain-001/renders/{{wright.run_id}}/create_design.json","file_policy":"indexed","run_path_template":"wright.run-path/1","mcp_server":"stevecad-mcp","mcp_task_tools":["list_skills","read_skill","api_reference","list_designs","read_design","write_design","generate_model","create_component","link_design","edit_design"],"max_tool_calls":32,"timeout_seconds":600,"mcp_context_budget_bytes":1048576,"mcp_reconciliation_contracts":"{\"generate_model\": {\"pending_status_path\": [\"model\", \"status\"], \"pending_status_values\": [\"queued\", \"running\"], \"terminal_status_values\": [\"succeeded\", \"failed\", \"cancelled\"], \"receipt_path\": [\"model\", \"id\"], \"argument_bindings\": {\"document_id\": [\"document\", \"id\"], \"revision\": [\"document\", \"revision\"]}, \"fixed_arguments\": {\"branch\": null, \"download\": null, \"route\": false}, \"max_polls\": 4}}"}
  tool: null
  reusable_step: null
end

