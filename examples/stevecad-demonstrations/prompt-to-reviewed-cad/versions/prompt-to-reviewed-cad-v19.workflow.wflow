task design_review
  name: "7. Produce the illustrated design review"
  purpose: "7. Produce the illustrated design review"
  step_type: "work"
  performed_by: "ai_assisted"
  group: null
  inputs: [{"key":"design_review_design_document","name":"design review design document","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_test_plan","name":"design review test plan","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_create_design","name":"design review create design","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_validate_design","name":"design review validate design","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_cad_isometric","name":"design review cad isometric","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_cad_top","name":"design review cad top","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_cad_front","name":"design review cad front","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_supplied_prompt","name":"design review supplied prompt","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_render_isometric","name":"design review render isometric","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_render_top","name":"design review render top","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_render_front","name":"design review render front","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_export_identity","name":"design review export identity","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"design_review_render_geometry_check","name":"design review render geometry check","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  outputs: [{"key":"design_review_response","name":"design review response","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  prompt: "Produce a compact self-contained HTML design review in at most 1500 words for the connected exact design and test results. Include design intent, dimensions and feature table, complete requirement-by-requirement test results, actual measured values, unresolved findings and links to the editable SteveCAD document/revision. Include the three actual CAD captures and the three realistic renderings in clearly captioned separate sections. Use img src filenames cad-isometric.png, cad-top.png, cad-front.png, render_isometric.png, render_top.png and render_front.png, which are siblings of this document. Show all three captured views and all three presentation views. Preserve actual CAD FAIL and UNVERIFIED findings prominently. Now evaluate the deferred presentation tests using the supplied image pairs: record specific visual observations of feature count, silhouette, camera orientation and requested appearance. Evaluate final-document completeness against the actual outputs. Do not carry a merely deferred earlier-stage test as a failure after evaluating its now-available evidence. Do not claim exact dimensional or pixel identity from visual inspection. If an image is unavailable for visual inspection, mark that check UNVERIFIED. A rendered image never proves a geometric requirement. Distinguish measured geometry from qualitative image checks. State that the report records a digital design review and does not record human acceptance. Use clean engineering typography and compact tables, no JavaScript or external assets. Keep long IDs and evidence paths wrapped (overflow-wrap:anywhere); constrain tables and images to the page width. Do not add an exact B-rep equivalence requirement for presentation images when the test plan specifies qualitative visible-feature comparison. Return complete HTML beginning with <!doctype html>.\nEnvelope identifiers: if you record a new assumption, affected_outputs must use these declared output IDs: design_review_response. Requirement IDs such as R01 belong in the document and test table, not affected_outputs. Preserve upstream assumptions as cited design choices; do not reissue them as new assumptions for this step.\nThe presentation images are native Blender renders of the actual validated STEP mesh, using the three captured orientation conventions. Compare each with its original CAD capture. Cite the exact export revision/build and geometry-matching report. A new full-build ID on the same revision is a separate export identity, not evidence of a geometry change or byte equivalence. Native color metadata is used when available, otherwise a declared neutral matte gray fallback. Retain appearance mismatches if the prompt calls for another finish.\nThe connected original prompt establishes supplied requirements. Keep original inspection verdicts and any actual specification/test conflict visible; do not silently waive a failed test. A presentation-only finish is evaluated on derived studio renders, with original CAD captures kept as provider-colored geometric evidence unless CAD viewport appearance was explicitly requested. Compare camera and visible geometry across each pair. Keep a simple part review concise, with complete requirement and evidence tables rather than repeated specification prose."
  settings: {"authoring_template":"ai-prompt","output_format":"html","save_output":true,"output_filename":"render-proofs/native-chain-001/renders/{{wright.run_id}}/design_review.html","file_policy":"indexed","run_path_template":"wright.run-path/1"}
  tool: null
  reusable_step: null
end

