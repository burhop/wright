task prepare_native_arguments
  name: "6. Bind native bodies to their rendering"
  purpose: "6. Bind native bodies to their rendering"
  step_type: "work"
  performed_by: "configured_tool"
  group: null
  inputs: [{"key":"prepare_native_arguments_input","name":"prepare native arguments input","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"prepare_native_arguments_identity","name":"prepare native arguments identity","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  outputs: [{"key":"prepare_native_arguments_response","name":"prepare native arguments response","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"native_arguments","name":"native arguments","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  prompt: "Execute the declared operation on its connected exact inputs. Preserve failures and uncertainty."
  settings: {"authoring_template":"mcp-tool","mcp_server":"81be7bf8-1e8e-4a77-be0d-5acc6236a0b4","mcp_tool":"81be7bf8-1e8e-4a77-be0d-5acc6236a0b4__shell_execute","mcp_schema_digest":"5be49730ebc2f82fddd46ef0284d05c3bc1e304c70dff4d0a6a4c1a0eb77327f","mcp_arguments":"{\"command\": [\"jq\", \"-ec\", \"--slurpfile\", \"identity\", \"native-identity.json\", \".content[0].text|fromjson | if .status==\\\"success\\\" and ._exit_code==0 and .validation.is_valid==true and .mesh_validation.glb.is_valid==true and .validation.layers.structure.solid_count==$identity[0].metadata.solids then . else error(\\\"Native CAD and written mesh validation required\\\") end | ($identity[0] as $i | ($i.metadata.modeling) as $m | {document_id:$i.document_id,revision:$i.revision,build_id:$i.build_id,units:$i.metadata.units,solids:$i.metadata.solids,extent_mm:$i.metadata.extent_mm,items:(if $m.design then [$m.design.instances[] as $inst | $inst.bodies|to_entries[] | . as $body | $m.design.components[$inst.component].bodies[$body.key] as $part | {instance:($inst.name+\\\"/\\\"+$body.key),component:$inst.component,extent_mm:$body.value,color:$part.color,material:$part.material,finish:$part.finish}] else [$m.bodies|to_entries[] | {instance:.key,component:.key,extent_mm:.value.extent_mm,color:.value.color,material:.value.material,finish:.value.finish}] end)}) as $basis | if ($basis.items|length)==$basis.solids and $basis.solids>0 then {code:(\\\"\\\\\\\"\\\\\\\"\\\\\\\"Native presentation template, embedded in the accepted workflow source.\\\\n\\\\nThe metadata marker is replaced with a JSON string literal by the declared jq\\\\nstep. It never substitutes executable source from a design or provider.\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport bpy\\\\nimport json\\\\nfrom mathutils import Matrix, Vector\\\\n\\\\nbasis = json.loads(__WRIGHT_BASIS_JSON_STRING__)\\\\nrun_id = '{{wright.run_id}}'\\\\nassert not bpy.app.is_job_running('RENDER')\\\\nscene_name = 'wright_' + run_id\\\\nassert bpy.data.scenes.get(scene_name) is None\\\\nassert basis['units'] == 'mm'\\\\nitems = basis['items']\\\\nassert items and len(items) == basis['solids']\\\\nscene = bpy.data.scenes.new(scene_name)\\\\nscene.world = bpy.data.worlds.new(scene_name + '_world')\\\\nbpy.context.window.scene = scene\\\\nscene['wright_render_run'] = run_id\\\\nscene['wright_cad_scene_owner'] = basis['build_id']\\\\nscene['wright_cad_document'] = basis['document_id']\\\\nscene['wright_cad_revision'] = basis['revision']\\\\nscene.unit_settings.system = 'METRIC'\\\\nscene.unit_settings.scale_length = 1.0\\\\nbpy.ops.import_scene.gltf(filepath='/inputs/automatic-transfer-001/{{wright.run_id}}/design.glb')\\\\nloaded = [obj for obj in scene.objects if obj.type == 'MESH']\\\\nassert len(loaded) == len(items)\\\\nbefore = [(obj, obj.matrix_world.copy()) for obj in loaded]\\\\nfor obj, world in before:\\\\n    obj.parent = None\\\\n    obj.matrix_world = Matrix.Scale(.001, 4) @ world\\\\nbpy.context.view_layer.update()\\\\nmaterials = {}\\\\nmatched = []\\\\nrecords = []\\\\nall_corners = []\\\\nfor obj in loaded:\\\\n    vertices = [obj.matrix_world @ v.co for v in obj.data.vertices]\\\\n    measured = [min(v[k] for v in vertices)*1000 for k in range(3)] + [max(v[k] for v in vertices)*1000 for k in range(3)]\\\\n    candidates = [i for i in items if max(abs(a-b) for a,b in zip(measured, i['extent_mm'])) <= .1]\\\\n    assert len(candidates) == 1, (obj.name, measured, len(candidates))\\\\n    item = candidates[0]\\\\n    assert item['instance'] not in matched\\\\n    matched.append(item['instance'])\\\\n    obj.name = item['instance']\\\\n    obj['wright_cad_body'] = True\\\\n    obj['cad_component'] = item['component']\\\\n    obj['cad_revision'] = basis['revision']\\\\n    all_corners.extend(vertices)\\\\n    error = max(abs(a-b) for a,b in zip(measured,item['extent_mm']))\\\\n    color = item.get('color') or '#aaaaaa'\\\\n    assert len(color) == 7 and color[0] == '#'\\\\n    metal = item.get('material') == 'stainless-304'\\\\n    key = (color, metal, item.get('finish'))\\\\n    if key not in materials:\\\\n        material = bpy.data.materials.new('native_' + color[1:] + str(metal))\\\\n        material.use_nodes = True\\\\n        shader = material.node_tree.nodes['Principled BSDF']\\\\n        rgb = [int(color[i:i+2],16)/255 for i in (1,3,5)]\\\\n        linear = [v/12.92 if v <= .04045 else ((v+.055)/1.055)**2.4 for v in rgb]\\\\n        shader.inputs['Base Color'].default_value = tuple(linear) + (1,)\\\\n        shader.inputs['Metallic'].default_value = 1 if metal else 0\\\\n        shader.inputs['Roughness'].default_value = .28 if metal else .55\\\\n        materials[key] = material\\\\n    obj.data.materials.clear()\\\\n    obj.data.materials.append(materials[key])\\\\n    records.append({'instance':item['instance'], 'extent_error_mm':error, 'polygons':len(obj.data.polygons), 'color':color})\\\\nassert len(matched) == len(items)\\\\nbounds = [min(v[k] for v in all_corners) for k in range(3)] + [max(v[k] for v in all_corners) for k in range(3)]\\\\nassert max(abs(bounds[k]*1000-basis['extent_mm'][k]) for k in range(6)) <= .1\\\\ntarget = Vector([(bounds[k]+bounds[k+3])/2 for k in range(3)])\\\\nspan = max(bounds[k+3]-bounds[k] for k in range(3))\\\\nassert .001 < span < 2, 'Qualified presentation size is 1 mm to 2 m'\\\\nbpy.ops.mesh.primitive_plane_add(size=span*12, location=(target.x,target.y,bounds[2]-.00002))\\\\nfloor = bpy.context.object\\\\nfloor.name = 'studio_floor_presentation_only'\\\\nfloor['presentation_fixture'] = True\\\\nmaterial = bpy.data.materials.new('neutral_studio_floor')\\\\nmaterial.use_nodes = True\\\\nshader = material.node_tree.nodes['Principled BSDF']\\\\nshader.inputs['Base Color'].default_value = (.70,.70,.70,1)\\\\nshader.inputs['Roughness'].default_value = .9\\\\nfloor.data.materials.append(material)\\\\nfor name, offset, power, size in [('key',(.7,-.9,1.6),6,.95),('fill',(-1.1,-.3,1.1),3,1.1),('rim',(.3,1.4,1.4),4,.8)]:\\\\n    data = bpy.data.lights.new(name,'AREA')\\\\n    data.energy = power*(span/.37)**2\\\\n    data.shape = 'DISK'\\\\n    data.size = size*span\\\\n    obj = bpy.data.objects.new(name,data)\\\\n    scene.collection.objects.link(obj)\\\\n    obj.location = target + Vector(offset)*span\\\\n    obj.rotation_euler = (target-obj.location).to_track_quat('-Z','Y').to_euler()\\\\ncamera = bpy.data.objects.new('studio_camera',bpy.data.cameras.new('studio_camera'))\\\\nscene.collection.objects.link(camera)\\\\nscene.camera = camera\\\\ncamera.data.type = 'ORTHO'\\\\ncamera.data.clip_start = .0001\\\\ncamera.data.clip_end = 20\\\\nscene['wright_cad_target'] = list(target)\\\\nscene['wright_native_mesh_count'] = len(records)\\\\nscene.world.use_nodes = True\\\\nscene.world.node_tree.nodes['Background'].inputs['Color'].default_value = (.84,.84,.84,1)\\\\nscene.world.node_tree.nodes['Background'].inputs['Strength'].default_value = .2\\\\nscene.render.resolution_x = 1000\\\\nscene.render.resolution_y = 720\\\\nscene.render.resolution_percentage = 100\\\\nscene.render.engine = 'CYCLES'\\\\nscene.cycles.samples = 128\\\\nscene.cycles.use_denoising = False\\\\nscene.view_settings.view_transform = 'Standard'\\\\nscene.view_settings.look = 'None'\\\\nscene.view_settings.exposure = -1\\\\nprint(json.dumps({'document_id':basis['document_id'],'revision':basis['revision'],'build_id':basis['build_id'],'run_id':run_id,'CAD_meshes':len(records),'meters_per_input_mm':.001,'geometry_changes':False,'records':records}))\\\\n\\\"|split(\\\"__WRIGHT_BASIS_JSON_STRING__\\\")|join($basis|tojson|tojson)),user_prompt:\\\"Create three ultrarealistic renderings of the design starting with a screen capture of the part in different orientations. Use the actual CAD surfaces, preserve all geometry and include the results in the design review.\\\"} else error(\\\"One native body per mesh with exact metadata required\\\") end\", \">\", \"native-arguments.json\"], \"directory\": \"/outputs/{{wright.run_id}}\", \"timeout\": 15}","output_format":"json","save_output":true,"file_policy":"indexed","run_path_template":"wright.run-path/1","output_filename":"render-proofs/native-chain-001/automatic-transfer-001/{{wright.run_id}}/prepare_native_arguments.json","expected_files":"render-proofs/native-chain-001/automatic-transfer-001/{{wright.run_id}}/native-arguments.json","expected_file_ports":{"native_arguments":"render-proofs/native-chain-001/automatic-transfer-001/{{wright.run_id}}/native-arguments.json"},"mcp_argument_ports":"{\"prepare_native_arguments_input\": \"stdin\"}","mcp_file_dependencies":{"prepare_native_arguments_identity":{"source":"connected_output"}}}
  tool: null
  reusable_step: null
end

