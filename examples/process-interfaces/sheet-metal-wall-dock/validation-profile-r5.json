      },
      {
        "id": "SHEET01-FEATURES",
        "text": "Retain rear slots 5.5 by 12 mm at X20/90,Z38, R2.75 ends; R5 notch X46..64,Y110..130 with R3 roots, split lips and original external corner treatment. Preserve centered 65 by 50 mm reference footprint and minimum 6 mm side clearance.",
        "scope": "design",
        "sources": [
          {
            "artifact_ref": "tests/datasets/engineering-workflows/scenarios/sheet-metal-supplier-handoff/01-barcode-reader-wall-dock/context.md",
