          }
        ],
        "mandatory": true,
        "review_required": true
      },
      {
        "id": "SHEET01-GEOMETRY",
        "text": "R5 outside virtual-sharp shelf is 110 by 130 mm, rear top Z60 and split lip tops Z12, sides open, all bends upward. Native offsets use actual selected T/R; preserve the original 75 mm revision separately.",
        "scope": "design",
        "sources": [
          {
            "artifact_ref": "tests/datasets/engineering-workflows/scenarios/sheet-metal-supplier-handoff/01-barcode-reader-wall-dock/context.md",
