{
  "compilerOptions": {
    "target": "es2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext", "moduleResolution": "bundler", "strict": true,
    "jsx": "react-jsx", "noEmit": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
