{"baseline":{"amendments":[{"artifact_ref":"specs/081-engineering-workflow-templates/dataset-campaign/modelica-selected-kit.md","locator":"Physical and numerical contract","sha256":"80d7746c5ef13d7198894f2ca7c112be95a1031fa794aa5e29b151f376d5cc56"}],"id":"water-heater-sizing-03-basis","requirements":[{"id":"WATER03-MODEL","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Model execution boundary","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"},{"artifact_ref":"specs/081-engineering-workflow-templates/dataset-campaign/modelica-selected-kit.md","locator":"Physical and numerical contract","sha256":"80d7746c5ef13d7198894f2ca7c112be95a1031fa794aa5e29b151f376d5cc56"}],"text":"Every supported candidate/loss combination is executed with the approved wright-water-heater-v1@0.1.0 recorded Modelica kit and accepted schema; analytical estimates remain separately labeled."},{"id":"WATER03-PHYSICS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/parameters.csv","locator":"water_mass through electrical_to_thermal_efficiency","sha256":"6ef577f5476401864bd25b360de04ebc7258d690497c1da594d82e0197a1d300"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Declared parameter study; Shared physical assumptions","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"}],"text":"Runs use 1.500 kg water, 4180 J/(kg·K), 480 J/K vessel capacity, 20 °C initial/ambient temperature and heater efficiency 0.94 without silent substitution."},{"id":"WATER03-GRID","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/power-candidates.csv","locator":"all rows","sha256":"f138c639e47139024210c723fa4393cd4803efa847ebb05a34019bed1094b1fd"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/loss-cases.csv","locator":"all rows","sha256":"e5825d538ecf22eea0b618b7964493301f4e0d962ab49de5d242b6f181325141"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Declared parameter study","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"}],"text":"The study retains all nine supported combinations of P1200/P1500/P1800 with low 1.92, nominal 2.40 and high 2.88 W/K UA, or explicitly blocks each unsupported combination."},{"id":"WATER03-CONTROL","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Shared physical assumptions","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"},{"artifact_ref":"specs/081-engineering-workflow-templates/dataset-campaign/modelica-selected-kit.md","locator":"Physical and numerical contract","sha256":"80d7746c5ef13d7198894f2ca7c112be95a1031fa794aa5e29b151f376d5cc56"}],"text":"Constant power is applied until the first 90 °C crossing using the selected kit's 2 K hysteresis semantics and the target-crossing energy horizon."},{"id":"WATER03-TARGET","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/parameters.csv","locator":"target_temperature,heat_up_limit","sha256":"6ef577f5476401864bd25b360de04ebc7258d690497c1da594d82e0197a1d300"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Business objective and allowed scope","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"}],"text":"Each combination's compliance uses the independently interpolated first 90 °C crossing and inclusive 400 s heat-up limit."},{"id":"WATER03-SELECTION","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/prompt.txt","locator":"worst-case selection request","sha256":"e3c159b6c6c0f1bdfefb6ba7920f4aabcd06828fe6b816bf9fe26c09c91e9cb9"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Mechanical and team context","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"}],"text":"The recommendation selects the lowest declared power meeting 400 s in every declared supported loss case and reports unmet/unsupported cases without changing bounds."},{"id":"WATER03-HORIZON","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/parameters.csv","locator":"requested_stop_time,requested_output_interval","sha256":"6ef577f5476401864bd25b360de04ebc7258d690497c1da594d82e0197a1d300"},{"artifact_ref":"specs/081-engineering-workflow-templates/dataset-campaign/modelica-selected-kit.md","locator":"Physical and numerical contract","sha256":"80d7746c5ef13d7198894f2ca7c112be95a1031fa794aa5e29b151f376d5cc56"}],"text":"Baseline runs use the accepted 700 s horizon and 1 s output grid and preserve explicit unreached-target outcomes."},{"id":"WATER03-ENERGY","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Shared physical assumptions","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"}],"text":"For every combination, results distinguish electrical input energy, modeled heat transferred and ambient loss through target crossing or the complete horizon when unreached."},{"id":"WATER03-REFINEMENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Mechanical and team context; Requested outputs and initial validation","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"},{"artifact_ref":"specs/081-engineering-workflow-templates/dataset-campaign/modelica-selected-kit.md","locator":"Canonical handoff","sha256":"80d7746c5ef13d7198894f2ca7c112be95a1031fa794aa5e29b151f376d5cc56"}],"text":"The controlling candidate at every loss level retains the authorized tighter integration run and reports target-time and final-energy sensitivity."},{"id":"WATER03-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/prompt.txt","locator":"requested outputs","sha256":"e3c159b6c6c0f1bdfefb6ba7920f4aabcd06828fe6b816bf9fe26c09c91e9cb9"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Requested outputs and initial validation","sha256":"54d06c140afd5aecffb999001be45909a6b09e5c91aa91993b09664faa85f21a"}],"text":"The output set contains complete scenario-identified temperature-time, power-comparison and energy-summary tables, curves, selection report and exact kit parameter/provenance JSON."},{"id":"WATER03-CLAIM-SCOPE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/water-heater-sizing/03-pilot-batch-dispensing/context.md","locator":"Business objective and allowed scope; Mecha