{"baseline":{"amendments":[],"id":"robot-tracking-diagnosis-02-basis","requirements":[{"id":"ROBOT02-INPUT-LINEAGE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/context.md","locator":"Data contract and reproducibility","sha256":"f01fc44c0d1d82eaa750de57bf80845f534c1b6470e7ab25f7fa26b3998f3c30"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/bag-conversion.md","locator":"complete mapping","sha256":"76dc930e6976dbf21f065aa8016ccdfb634075372c12ce4db6ac49af24f3536d"}],"text":"Any ROS 2 analysis uses a traceable CSV-to-bag conversion with the documented topic/message map, retains the original CSVs, and preserves the recorded frame and both time columns."},{"id":"ROBOT02-SPATIAL-ALIGNMENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/context.md","locator":"Cornering run and survey note","sha256":"f01fc44c0d1d82eaa750de57bf80845f534c1b6470e7ab25f7fa26b3998f3c30"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/external-pose.csv","locator":"frame_id,x_m,y_m,yaw_rad","sha256":"a0db96afd41e70a05c9a687338383313d328f13dd9c31a5f8c170a6bf8e404b8"}],"text":"Aligned external poses apply x_map=x_tracker−1.000 m and y_map=y_tracker+2.000 m with yaw unchanged exactly once."},{"id":"ROBOT02-TIME-ALIGNMENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/context.md","locator":"Cornering run and survey note","sha256":"f01fc44c0d1d82eaa750de57bf80845f534c1b6470e7ab25f7fa26b3998f3c30"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/external-pose.csv","locator":"time_s,timestamp_s","sha256":"a0db96afd41e70a05c9a687338383313d328f13dd9c31a5f8c170a6bf8e404b8"}],"text":"Aligned external poses remove the +0.150 s tracker-header offset exactly once, using acquisition time_s as the robot-time comparison coordinate."},{"id":"ROBOT02-METRICS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/context.md","locator":"Cornering run and survey note; Data contract and reproducibility","sha256":"f01fc44c0d1d82eaa750de57bf80845f534c1b6470e7ab25f7fa26b3998f3c30"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/planned-path.csv","locator":"all rows","sha256":"b2c05ebc0f6a0427967d9d1314e55a0f8cb9d1ed23db5830c5c61307ad271cea"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/odometry.csv","locator":"all rows","sha256":"dc7e4cd5e14522c43a0d6d140a7ea77fa107f9d76b423c942d1007687651f91c"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/velocity-command.csv","locator":"all rows","sha256":"51e6b341a7b340bb2df934408cb05350dfb07afbb431d2a7108513feb4e1261e"}],"text":"Only aligned data supports duration, retained sample count, lateral RMSE, position-error RMSE, and velocity-disagreement metrics over the common valid samples."},{"id":"ROBOT02-EVENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/events.csv","locator":"row:E01","sha256":"aa78a012e7b60f742fb9823e5ffa76d69d41a842bfd138df7376d2d5d37e2862"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/02-corner-time-alignment/context.md"