beb58d2fe"}],"text":"H2 bushing-seat center X is 170.00 ±0.20 mm in the lower-left workpiece top-face datum."},{"id":"JIG01-H2-Y","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/holes.csv","locator":"row:H2:y_mm,center_tolerance_mm","sha256":"6e5b0926cac3e33c35b7efc94bb208753212f39c71bd04d23bdeeccb2d3b3fbd"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/context.md","locator":"Shop purpose and coordinates","sha256":"bc93a8a1897b3a83290d6835cbe800bb2ddbeabe7177d8cf66026d6beb58d2fe"}],"text":"H2 bushing-seat center Y is 30.00 ±0.20 mm in the lower-left workpiece top-face datum."},{"id":"JIG01-BODY-SEATS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/bushings.csv","locator":"row:B5:body_od_mm,body_diametral_clearance_mm","sha256":"dfb19843fd1a2523e91d0c32ce375712121c54868ab8e55b11e916a44c240474"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/context.md","locator":"Jig and bushing intent","sha256":"bc93a8a1897b3a83290d6835cbe800bb2ddbeabe7177d8cf66026d6beb58d2fe"}],"text":"Both guide-body seats are 10.20 ±0.10 mm diameter from the 10.0 mm body OD plus 0.20 mm diametral slip clearance."},{"id":"JIG01-FLANGE-SEATS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/bushings.csv","locator":"row:B5:flange_od_mm,flange_thickness_mm,flange_diametral_clearance_mm","sha256":"dfb19843fd1a2523e91d0c32ce375712121c54868ab8e55b11e916a44c240474"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/context.md","locator":"Jig and bushing intent","sha256":"bc93a8a1897b3a83290d6835cbe800bb2ddbeabe7177d8cf66026d6beb58d2fe"}],"text":"Both flange pockets are 14.30 mm nominal diameter and 2.0 mm deep, support the flange from above, and leave the guide body unobstructed."},{"id":"JIG01-STACKUP","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/context.md","locator":"Jig and bushing intent","sha256":"bc93a8a1897b3a83290d6835cbe800bb2ddbeabe7177d8cf66026d6beb58d2fe"}],"text":"The 12 mm plate and 12 mm bushing body stackup is reported without silently shortening the bushing or claiming a press fit."},{"id":"JIG01-DATUMS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/prompt.txt","locator":"registration request","sha256":"8d13260603227cb28cac70b95797fb053e68a3672e9f0dd3ffdc378a768d2b3e"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/context.md","locator":"Jig and bushing intent","sha256":"bc93a8a1897b3a83290d6835cbe800bb2ddbeabe7177d8cf66026d6beb58d2fe"}],"text":"The jig registers on the workpiece left end and lower long edge with datum fences extending no more than 8 mm down the sides and 0.30 mm nominal clearance at the opposite non-datum edge."},{"id":"JIG01-KEEPOUTS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/keepouts.csv","locator":"rows:CLAMP_LEFT,CLAMP_RIGHT","sha256":"3a803c16e9d3fc1babbc3915da92be29a7e488bbf34a86f03c560e75af0c7083"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/01-furniture-rail-insert-jig/context.md","locator":"Workholding and capabil