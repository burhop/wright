{"baseline":{"amendments":[{"artifact_ref":"specs/082-output-content-validation/campaign-example-renewal-lineup.json","locator":"cases/parametric-drill-jig-02/final_deliverable","sha256":"9a7992ac2ec340b7e8fb511b16b87d1effd341dc5e768cd81834065e891ef199"}],"id":"parametric-drill-jig-02-basis","requirements":[{"id":"JIG02-H1","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/holes.csv","locator":"row:H1","sha256":"38f9761fe747c97fa80904de7258dc5d4459e800cb033be99f6f2c3952133140"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Hole and fixture requirements","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"H1 seat center is (30.00,20.00) mm within ±0.15 mm per axis in the exterior top-face workpiece datum."},{"id":"JIG02-H2","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/holes.csv","locator":"row:H2","sha256":"38f9761fe747c97fa80904de7258dc5d4459e800cb033be99f6f2c3952133140"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Hole and fixture requirements","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"H2 seat center is (30.00,60.00) mm within ±0.15 mm per axis in the exterior top-face workpiece datum."},{"id":"JIG02-H3","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/holes.csv","locator":"row:H3","sha256":"38f9761fe747c97fa80904de7258dc5d4459e800cb033be99f6f2c3952133140"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Hole and fixture requirements","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"H3 seat center is (150.00,20.00) mm within ±0.15 mm per axis in the exterior top-face workpiece datum."},{"id":"JIG02-H4","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/holes.csv","locator":"row:H4","sha256":"38f9761fe747c97fa80904de7258dc5d4459e800cb033be99f6f2c3952133140"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Hole and fixture requirements","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"H4 seat center is (150.00,60.00) mm within ±0.15 mm per axis in the exterior top-face workpiece datum."},{"id":"JIG02-SEATS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/bushings.csv","locator":"row:B66","sha256":"16c1f97b7c45e77ed1bd55e275c4b26957f28208ef7295d2ed59ee92d2e97f86"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Authorized prototype design decisions","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"Every bushing uses a 12.15 mm body hole and an 18.30 mm diameter by 2.50 mm deep top counterbore with the flange bearing downward."},{"id":"JIG02-STACKUP","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Hole and fixture requirements; Authorized prototype design decisions","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"The 15.00 mm body spans the remaining bridge thickness and no secondary retainer or straight-sleeve substitution is asserted."},{"id":"JIG02-CHIP-WINDOW","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/keepouts.csv","locator":"row:CHIP_WINDOW","sha256":"651ff9df2177886650835e7f2b974d2ce07056163b772c0c22ab1b79b907519a"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Hole and fixture requirements","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"No jig material occupies X=65..115 mm, Y=15..65 mm in the declared chip-removal region, and the workpiece is not cut there."},{"id":"JIG02-CLAMPS","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/keepouts.csv","locator":"rows:FRONT_CLAMP,REAR_CLAMP","sha256":"651ff9df2177886650835e7f2b974d2ce07056163b772c0c22ab1b79b907519a"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Authorized prototype design decisions","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"Jig material has no positive-volume intersection with FRONT_CLAMP or REAR_CLAMP; the approved 2.85 mm end-facing ligaments remain outside those volumes."},{"id":"JIG02-DATUMS","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Authorized prototype design decisions","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"Two front pads occupy the approved X=-4..0 ranges, the left fence occupies X=18..162,Y=-4..0,Z=0..12, and their connector remains at Y=-8..0 outside clamps."},{"id":"JIG02-KEY","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Authorized prototype design decisions","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"One integral key tongue occupies X=0..3.8,Y=9.2..14.8,Z=-2.8..0 when seated, matching but not altering the supplied indexing notch with 0.20 mm in-plane clearance per side."},{"id":"JIG02-ACCESS","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Authorized prototype design decisions","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"The jig is no more than 17.5 mm above the tube top and non-bushing material stays outside a 25 mm diameter vertical access cylinder at every drill axis."},{"id":"JIG02-DRILL-INTENT","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/prompt.txt","locator":"top-wall-only instruction","sha256":"730ff730de0c7d178c438f0485eabb35f5ccca9bbbecea370aaaecfbdad7ccab"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/holes.csv","locator":"drill_diameter_mm,nominal_wall_mm","sha256":"38f9761fe747c97fa80904de7258dc5d4459e800cb033be99f6f2c3952133140"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Workpiece and production context","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"The design guides 6.6 mm drilling through only the nominal 3 mm top wall and does not imply drilling or locating from the opposite wall."},{"id":"JIG02-MARKING","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/prompt.txt","locator":"front-arrow request","sha256":"730ff730de0c7d178c438f0485eabb35f5ccca9bbbecea370aaaecfbdad7ccab"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Authorized prototype design decisions","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"A clear front arrow provides visual wrong-end confirmation in addition to the positive key."},{"id":"JIG02-MATERIAL","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Capability, policy, and limits","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"The design note explicitly identifies machined acetal as the assumed digital-study material and does not imply production approval."},{"id":"JIG02-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/prompt.txt","locator":"requested outputs","sha256":"730ff730de0c7d178c438f0485eabb35f5ccca9bbbecea370aaaecfbdad7ccab"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/02-extrusion-panel-mount-jig/context.md","locator":"Capability, policy, and limits","sha256":"ff90ef7bec7a1e3b1694a0920086617dde8602159766918789f7898fe9298c7a"}],"text":"The output set contains a STEP or STL jig, hole-layout DXF, and machine-readable dim