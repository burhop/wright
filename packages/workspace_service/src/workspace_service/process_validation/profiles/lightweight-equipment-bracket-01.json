{"baseline":{"amendments":[],"id":"lightweight-equipment-bracket-01-basis","requirements":[{"id":"BRACKET01-GEOMETRY","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/dimensions.csv","locator":"all rows","sha256":"4a5521be30236d7119dd30b407fdb1770210541b063d1514a618582c30822e64"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Geometry and coordinate convention","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Baseline and revision preserve the declared wall/shelf envelope, both Ø6.6 wall holes, both Ø4.5 camera holes, 10 mm hole keepouts and complete camera contact surface."},{"id":"BRACKET01-MANUFACTURING","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Business and fabrication","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"The lighter single-solid machined design respects 6 mm minimum tool diameter, 3 mm internal radius and 3 mm residual wall without moving protected features."},{"id":"BRACKET01-LOAD","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/load-case.csv","locator":"row:service_100N","sha256":"da4230b103562f04aee83976960735df448b188114c0b5edb1e1b05aeef66618"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Fixture and load","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Both revisions use exactly the distributed (0,0,-100) N s