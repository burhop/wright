ifact_ref":"tests/datasets/engineering-workflows/scenarios/heat-spreader-sizing/01-eink-sign-controller-strap/alternatives.csv","locator":"conductivity_w_mk,density_kg_m3","sha256":"29d9f7d3b89d687edc7cdf14ded48e4357257a9f27764df212051c8ed02c328f"}],"text":"The model uses constant thermal conductivity 200 W/(m·K); density 2700 kg/m³ is used only for comparative mass and is not presented as certified alloy data."},{"id":"HEAT01-FIELDS","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/heat-spreader-sizing/01-eink-sign-controller-strap/prompt.txt","locator":"requested numerical temperature fields","sha256":"f08a8caa5bc41b282b5386578be028bf60312da099b5613c600db9b73635e5d1"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/heat-spreader-sizing/01-eink-sign-controller-strap/context.md","locator":"Reporting policy","sha256":"4817f9a8f0dbaa6bb6ccd4ba03af8ba7347d9d1129b7b06c40685e42a0448feb"}],"text":"Both width candidates retain actual coarse and refined numerical temperature fields distinct from the analytical calculation and the input diagram."},{"id":"HEAT01-ANALYTICAL","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/heat-spreader-sizing/01-eink-sign-controller-strap/context.md","locator":"Geometry and boundary definitions; Reporting policy","sha256":"4817f9a8f0dbaa6bb6ccd4ba03af8ba7347d9d1129b7b06c40685e42a0448feb"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/heat-spreader-sizing/01-eink-sign-controller-strap/alternatives.csv","locator":"all rows","sha256":"29d9f7d3b89d687edc7cdf14ded48e4357257a9f27764df212051c8ed02c328f"}],"text":"Each numerical hot-end temperature rise agrees within 2% of Q·L/(k·W·t) using that candidate's declared dimensions and inputs."},{"id":"HEAT01-BALANCE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tes