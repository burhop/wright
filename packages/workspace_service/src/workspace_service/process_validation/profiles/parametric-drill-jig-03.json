engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Workpiece and frame","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"H6 seat center is (25.000,-43.301) mm within ±0.10 mm per axis in the center and keyed +X workpiece datum."},{"id":"JIG03-SEATS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/bushings.csv","locator":"row:B66R","sha256":"a66b71c6edb2d431f1ff5955592779eca9606a17e09add7acc785f76a0b8bee0"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"Every bushing body seat is 12.20 mm nominal diameter and every flange pocket is 18.30 mm nominal diameter for the declared diametral clearances."},{"id":"JIG03-STACKUP","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/bushings.csv","locator":"row:B66R","sha256":"a66b71c6edb2d431f1ff5955592779eca9606a17e09add7acc785f76a0b8bee0"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"The 16 mm local seat thickness, 16 mm body, 2.5 mm flange, seating direction, and proposed counterbore depth are reported without treating the flange as withdrawal retention."},{"id":"JIG03-CENTER-OPENING","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"The annular jig preserves a central circular debris-removal opening at least 55 mm in diameter."},{"id":"JIG03-COLLAR","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Workpiece and frame; Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"The outer collar registers over the 152 mm workpiece rim with 0.20 mm radial clearance."},{"id":"JIG03-KEY","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/prompt.txt","locator":"notch authority","sha256":"f1affe8f3e6b565dd81119c9c28cfe24479c04595a47f15406c3de51d3843daf"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Workpiece and frame; Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"A tab keys to the existing +X notch with 0.15 mm clearance per side, does not extend below the workpiece base, and does not add or alter a workpiece feature."},{"id":"JIG03-KEEPOUTS","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/keepouts.csv","locator":"all rows","sha256":"7f6aa7b34476d63f4fa1d76b671fd86b1b34c51b57b95ca9a7b8f0a6cdbabbeb"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"Jig material does not intersect the WEST_CLAMP or SOUTHEAST_CLAMP occupied volumes; any unresolved conflict is reported without relocating holes."},{"id":"JIG03-WALL","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"At least 5 mm nominal wall remains outside flange pockets except at explicitly reviewed clamp or service cutouts."},{"id":"JIG03-MARKING","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Jig construction and fits","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"A +X DATUM mark appears adjacent to the notch in an accessible exterior region."},{"id":"JIG03-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/prompt.txt","locator":"requested outputs","sha256":"f1affe8f3e6b565dd81119c9c28cfe24479c04595a47f15406c3de51d3843daf"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig/03-indexable-circular-fixture-jig/context.md","locator":"Lab policy and validation boundary","sha256":"e4dda84d5c9ab5d8a073dce9bda8f4d14ed380d29d30ca6ac4c3c4a66848bce6"}],"text":"The output set contains a STEP or STL jig, hole-location DXF, and machine-readable dimension report with datum transform and bushing clearances."},{"id":"JIG03-CLAIM-SCOPE","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/parametric-drill-jig