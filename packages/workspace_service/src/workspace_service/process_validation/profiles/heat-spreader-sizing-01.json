            "locator": "Geometry and boundary definitions"
          }
        ],
        "mandatory": true,
        "review_required": false
      },
      {
        "id": "HEAT-ANALYTICAL",
        "text": "Each field's numerical temperature rise agrees within 2% of Q*L/(k*W*t) using 4 W, 100 mm, 2 mm, k=200 W/(m K), and a 25 C cold face.",
        "scope": "design",
