{"baseline":{"amendments":[],"id":"printed-replacement-part-01-basis","requirements":[{"id":"PRINT01-ENVELOPE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/prompt.txt","locator":"38 mm scale reference","sha256":"818f0b80f8417670c7d8b7a1af4514cbf4bb41236ae0848c80820d663f116631"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Geometry and use","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"The complete wheel is no more than 38.0 mm diameter and 18.0 mm high including the 2 mm raised front hub."},{"id":"PRINT01-GRIP","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/prompt.txt","locator":"six scallops and grip dots","sha256":"818f0b80f8417670c7d8b7a1af4514cbf4bb41236ae0848c80820d663f116631"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Geometry and use","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"The wheel has six equally spaced shallow scallops, at least 33 mm minimum grip diameter, nominal 1.0 mm exposed-edge rounds and subtle raised grip dots that do not form glove catches."},{"id":"PRINT01-SOCKET","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/prompt.txt","locator":"shaft and socket request","sha256":"818f0b80f8417670c7d8b7a1af4514cbf4bb41236ae0848c80820d663f116631"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Geometry and use","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"The concentric blind D socket is 10.0 mm deep and derives from a 6.00 mm round boundary and 5.20 mm across-flat shaft with 0.20 mm radial and 0.20 mm flat clearance."},{"id":"PRINT01-SOCKET-WALL","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Geometry and use","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"At least 3.0 mm material remains above the blind socket and no set screw, insert, taper or keyway is added."},{"id":"PRINT01-MESH-LINEAGE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/prompt.txt","locator":"requested mesh lineage","sha256":"818f0b80f8417670c7d8b7a1af4514cbf4bb41236ae0848c80820d663f116631"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Review and outputs","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"Source and repaired printable meshes are distinct, correspond to the same approved geometry, and the final slice package binds to the repaired mesh revision."},{"id":"PRINT01-SLICE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Capabilities and internal policy","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"The final package uses installed matching P1S 0.4 mm PETG profiles, 0.20 mm layers, four perimeters and 35% infill; any PLA geometry prototype is explicitly labeled and cannot satisfy PETG."},{"id":"PRINT01-ORIENTATION","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/prompt.txt","locator":"orientation request","sha256":"818f0b80f8417670c7d8b7a1af4514cbf4bb41236ae0848c80820d663f116631"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Review and outputs","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"Orientation and support decisions protect the upward-facing blind socket where feasible, retain an actual support/slicing preview, and identify any required support."},{"id":"PRINT01-TOLERANCE","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Capabilities and internal policy","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"Non-mating prototype dimensions use the proposed ±0.25 mm tolerance while D-socket design values remain separate from future measured fit values."},{"id":"PRINT01-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/prompt.txt","locator":"requested outputs","sha256":"818f0b80f8417670c7d8b7a1af4514cbf4bb41236ae0848c80820d663f116631"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Review and outputs","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"The output set contains source mesh, repaired printable mesh, support/slicing preview, final P1S PETG package and a digest-bound local simulator transfer receipt."},{"id":"PRINT01-ACTION-SCOPE","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/01-observatory-focus-wheel/context.md","locator":"Capabilities and internal policy; Review and outputs","sha256":"89fb96796f499c0412d1eeacb8e27c855ce331cae0f36f9f9a236d13460f43ff"}],"text":"The result does not claim strength, fit, accuracy, standards compliance or successful printing and does not use printer credentials, transfer to a physical printer or start a print."}],"unresolved_decisions":[],"version":"1"},"checks":[{"applicability_reason":null,"constraint":{"expected":null,"inclusive":true,"maximum":38.0,"minimum":null,"operator":"range","target":null,"tolerance":null},"evidence_method":"independent_measurement","frame":"model_axes","id":"repaired-envelope-x","parameters":{"operation":"stl_dimension","unit_convention":"mm"},"reader":"printing","requirement_ids":["PRINT01-ENVELOPE"],"selector":"mesh/x_span_mm","subject_role":"repaired_mesh","unit":"mm","version":"1"},{"applicability_reason":null,"constraint":{"expected":null,"inclusive":true,"maximum":38.0,"minimum":null,"operator":"range","target":null,"tolerance":null},"evidence_method":"independent_measurement","frame":"model_axes","id":"repaired-envelope-y","parameters":{"operation":"stl_dimension","unit_convention":"mm"},"reader":"printing","requirement_ids":["PRINT01-ENVELOPE"],"selector":"mesh/y_span_mm","subject_role":"repaired_mesh","unit":"mm","version":"1"},{"applicability_reason":null,"constraint":{"expected":null,"inclusive":true,"maximum":18.0,"minimum":null,"operator":"range","target":null,"tolerance":null},"evidence_method":"independent_measurement","frame":"model_axes","id":"repaired-envelope-z","parameters":{"operation":"stl_dimension","unit_convention":"mm"},"reader":"printing","requirement_ids":["PRINT01-ENVELOPE"],"selector":"mesh/z_span_mm","subject_role":"repaired_mesh","unit":"mm","version":"1"},{"a