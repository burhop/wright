{"baseline":{"amendments":[{"artifact_ref":"specs/082-output-content-validation/campaign-example-renewal-engineering-input-proposal.json","locator":"cases/robot-tracking-diagnosis-01/new_fixed_requirements","sha256":"4695823e0fb488fa0d5a309288505e56dffaaf13c0a59bb8b22775409dc23840"}],"id":"robot-tracking-diagnosis-01-basis","requirements":[{"id":"ROBOT01-INPUT-LINEAGE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Data contract and reproducibility","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/bag-conversion.md","locator":"complete mapping","sha256":"76dc930e6976dbf21f065aa8016ccdfb634075372c12ce4db6ac49af24f3536d"}],"text":"Any ROS 2 analysis uses a traceable CSV-to-bag conversion with the documented topic/message map, retains the original CSVs, and preserves their map frame and elapsed-time origin."},{"id":"ROBOT01-ALIGNMENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Aisle seam investigation","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/external-pose.csv","locator":"time_s,frame_id,valid","sha256":"bce2ebe559eb3e22659a2ea4f6d8538f28036389a05ea6afd167f590b59478a3"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/odometry.csv","locator":"time_s,frame_id","sha256":"ad64361e94798e145377a2c4628bbd3e30b363e58ee4c1fc1140ecab0bbb4b88"}],"text":"Comparison uses the common valid 0..30 s interval without applying a frame or clock correction because all supplied sources are already map-aligned with one elapsed-time origin."},{"id":"ROBOT01-METRICS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Data contract and reproducibility","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/planned-path.csv","locator":"all rows","sha256":"018d83f6cbcac87544c81b58b264ce456d1f7b5ca1259fc92f1c6ac0b7de7283"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/odometry.csv","locator":"all rows","sha256":"ad64361e94798e145377a2c4628bbd3e30b363e58ee4c1fc1140ecab0bbb4b88"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/velocity-command.csv","locator":"all rows","sha256":"0a31444dc0c9e9631cc2f8ad3b33c5914a47985f6310d75a705d58d2b7970d4b"}],"text":"Metrics independently report duration, retained sample count, lateral RMSE, position-error RMSE, and command/odometry velocity disagreement from the supplied samples and stated interpolation."},{"id":"ROBOT01-EVENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/events.csv","locator":"row:E01","sha256":"fa876752cf2877fd795061ab932135ac8bc5f269bbb29b1656b877c3be1690ef"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Aisle seam investigation; Data contract and reproducibility","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"}],"text":"Timeline and diagnosis correlate E01 at 15.0 s to the taped seam crossing within one 0.5 s sample without treating the annotation as a cause."},{"id":"ROBOT01-PLOTS","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/prompt.txt","locator":"plot request","sha256":"300c6c5330978304327b4aa933eed705d368c18873c452eca5a356fee7fdc0f4"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Requested outputs","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"}],"text":"The trajectory overlay shows planned, odometry, and external-pose paths in the declared map frame, and the tracking-error evidence remains linked to exact time ranges."},{"id":"ROBOT01-DIAGNOSIS","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/prompt.txt","locator":"causation constraint","sha256":"300c6c5330978304327b4aa933eed705d368c18873c452eca5a356fee7fdc0f4"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Aisle seam investigation; Data contract and reproducibility","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"}],"text":"The diagnosis separates observations from hypotheses, does not claim wheel slip from speed disagreement alone, lists uncertainty from unknown tracker repeatability, and recommends one inexpensive follow-up experiment."},{"id":"ROBOT01-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Requested outputs","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"}],"text":"The output set contains timeline.csv, a trajectory overlay SVG or PNG, tracking metrics CSV or JSON, and an evidence-linked diagnosis Markdown or PDF."},{"id":"ROBOT01-ACTION-SCOPE","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/01-aisle-floor-seam/context.md","locator":"Aisle seam investigation; Data contract and reproducibility","sha256":"a3cc366ae9f2356e19a0f639af55942bea2b99ad5a1943482bf5766402c98d0f"}],"text":"The result does not command a robot, change controller settings, connect to a production ROS graph, or present synthetic logs as a real failure record."},{"id":"ROBOT01-DESIGN-CONTRACT","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"specs/082-output-content-validation/campaign-example-renewal-engineering-input-proposal.json","locator":"cases/robot-tracking-diagnosis-01/new_fixed_requirements","sha256":"4695823e0fb488fa0d5a309288505e56dffaaf13c0a59bb8b22775409dc23840"}],"text":"Corrective hardware preserves every independently approved site, interface, material, load, envelope and mass requirement and changes only the permitted design choices; tracking correlation is not treated as causal proof."},{"id":"ROBOT01-CORRECTIVE-CAD","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"specs/082-output-content-validation/campaign-example-renewal-engineering-input-proposal.json","locator":"cases/robot-tracking-diagnosis-01/new_fixed_requirements","sha256":"4695823e0fb488fa0d5a309288505e56dffaaf13c0a59bb8b22775409dc23840"}],"text":"The final corrective-hardware CAD is an inspectable same-attempt STEP with reopened measurements bound to the approved interfaces."},{"id":"ROBOT01-CORRECTIVE-FEA","mandatory":true,"review_required":true,"scope":"design","sources":[{"artifact_ref":"specs/082-output-content-validation/campaign-example-renewal-engineering-input-proposal.json","locator":"cases/robot-tracking-diagnosis-01/new_fixed_requirements","sha256":"4695823e0fb488fa0d5a309288505e56dffaaf13c0a59bb8b22775409dc23840"}],"text":"The exact final STEP is checked with coarse/fine CalculiX fields, reaction equilibrium, approved stress and deflection limits, and explicit limitations."},{"id":"ROBOT01-COMMISSIONING","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"specs/082-output-content-validation/campaign-example-renewal-engineering-input-proposal.json","locator":"cases/robot-tracking-diagnosis-01/new_fixed_requirements","sha256":"4695823e0fb488fa0d5a309288505e56dffaaf13c0a59bb8b22775409dc23840"}],"text":"The final package includes a bounded installation and commissioning plan that preserves unperformed physical, causal and authority-dependent checks."}],"unresolved_decisions":[],"version":"1"},"checks":[{"applicability_reason":null,"constraint":{"expected":"ROS2 sqlite3 CDR","inclusive":true,"maximum":null,"minimum":null,"operator":"equals","target":null,"tolerance":null},"evidence_method":"structured_value","frame":null,"id":"conversion-format","parameters":{},"reader":"structured","requirement_ids":["ROBOT01-INPUT-LINEAGE"],"selector":"/format","subject_role":"conversion_manifest","unit":null,"version":"1"},{"applicability_reason":null,"constraint":{"expected":false,"inclusive":true,"maximum":null,"minimum":null,"operator":"equals","target":null,"tolerance":null},"evidence_method":"structured_value","frame":null,"id":"conversion-frame","parameters":{},"reader":"structured","requirement_ids":["ROBOT01-INPUT-LINEAGE"],"selector":"/frame_transform_applied","subject_role":"conversion_manifest","unit":null,"version":"1"},{"applicability_reason":null,"constraint":{"expected":false,"inclusive":true,"maximum":null,"minimum":null,"operator":"equals","target":null,"tolerance":null},"evidence_method":"structured_value","frame":null,"id":"conversion-clock","parameters":{},"reader":"structured","requirement_ids":["ROBOT01-INPUT-LINEAGE"],"selector":"/header_clock_corrected","subject_role":"conversion_manif