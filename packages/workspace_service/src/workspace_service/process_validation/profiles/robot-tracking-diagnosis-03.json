{"baseline":{"amendments":[],"id":"robot-tracking-diagnosis-03-basis","requirements":[{"id":"ROBOT03-INPUT-LINEAGE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/context.md","locator":"Data contract and reproducibility","sha256":"f1cf9a1239e4f6ac2af85bb6ba522f3b67e54548d5079c66fd39decb4766bb01"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/bag-conversion.md","locator":"complete mapping","sha256":"76dc930e6976dbf21f065aa8016ccdfb634075372c12ce4db6ac49af24f3536d"}],"text":"Any ROS 2 analysis uses a traceable CSV-to-bag conversion with the documented topic/message map, retains the original CSVs, and preserves timing, validity masks and map frame."},{"id":"ROBOT03-OCCLUSION","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/context.md","locator":"Curved-route test with occlusion","sha256":"f1cf9a1239e4f6ac2af85bb6ba522f3b67e54548d5079c66fd39decb4766bb01"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/external-pose.csv","locator":"rows:time_s 14.0..16.0","sha256":"87373d30578412e4ab90fe5d13ba56e2a4265540d2c4c984843a2ef66b5b8eec"}],"text":"External poses from 14.0 through 16.0 s inclusive remain missing and are neither zero-filled nor represented as measured or silently interpolated evidence."},{"id":"ROBOT03-SAMPLE-SCOPE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/context.md","locator":"Curved-route test with occlusion; Data contract and reproducibility","sha256":"f1cf9a1239e4f6ac2af85bb6ba522f3b67e54548d5079c66fd39decb4766bb01"