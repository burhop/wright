es, treats telemetry as context rather than proof, lists uncertainty, and recommends an additional observation."},{"id":"ROBOT03-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/prompt.txt","locator":"requested outputs","sha256":"3da4ce8141dfc8ec7320df659d2d0bbf99a65b34ac1f552492bba72f101294ef"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/context.md","locator":"Requested outputs","sha256":"f1cf9a1239e4f6ac2af85bb6ba522f3b67e54548d5079c66fd39decb4766bb01"}],"text":"The output set contains aligned data/timeline, trajectory overlay SVG or PNG, tracking metrics CSV or JSON, and an evidence-linked diagnosis Markdown or PDF."},{"id":"ROBOT03-ACTION-SCOPE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/robot-tracking-diagnosis/03-figure-eight-occlusion/context.md","locator":"Curved-route test with occlusion; Data contract and reproducibility","sha256":"f1cf9a1239e4f6ac2af85bb6ba522f3b67e54548d5079c66fd39decb4766bb01"}],"text":"The result does not command a physical robot, change its controller, connect to production ROS, or present synthetic data as a real failure record."}],"unresolved_decisions":[],"version":"1"},"checks":[{"applicability_reason":null,"constraint":{"expected":"ROS2 sqlite3 CDR","inclusive":true,"maximum":null,"minimum":null,"operator":"equals","target":null,"tolerance":null},"evidence_method":"structured_value","frame":null,"id":"conversion-format","parameters":{},"reader":"structured","requirement_ids":["ROBOT03-INPUT-LINEAGE"],"selector":"/format","subject_role":"conversion_manifest","unit":null,"version":"1"},{"applicability_reason":null,"constraint":{"expected":false,"inclusive":true,"maximum":null,"minimum":null,"operator":"equals","target":null,"