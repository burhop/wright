{"amendments":[],"id":"printed-replacement-part-02-basis","requirements":[{"id":"PRINT02-MOUNTING","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/prompt.txt","locator":"mounting request","sha256":"95eb1233ff0498c5bc96d5659b7f9538a89f98c4bdc916a61442cf5f3da41834"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Coordinate system and supplied measurements","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"The two 4.5 mm through-hole centers are exactly 96.0 mm apart on flat 18 by 24 by 5 mm mounting pads at Z=0, with no threaded plastic bosses."},{"id":"PRINT02-LABEL-KEEPOUT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Coordinate system and supplied measurements","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"No mounting pad or handle material overlaps the drawer-label region below Y=-18 mm."},{"id":"PRINT02-ENVELOPE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Coordinate system and supplied measurements","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"The handle outer envelope is at most 118 mm wide, 28 mm high and 34 mm proud of the drawer."},{"id":"PRINT02-FINGER-CLEARANCE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Coordinate system and supplied measurements","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"At least 25 mm clearance exists between the rear of the grip and drawer plane over the central 65 mm span."},{"id":"PRINT02-GRIP","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/prompt.txt","locator":"arched bow and thumb recess","sha256":"95eb1233ff0498c5bc96d5659b7f9538a89f98c4bdc916a61442cf5f3da41834"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Coordinate system and supplied measurements","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"The bow uses a nominal 12 by 9 mm oval grip, internal blends at least 3 mm where space permits, touched-edge rounds at least 1 mm, and a shallow 1.5 mm thumb recess over the central 40 mm."},{"id":"PRINT02-MESH-LINEAGE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/prompt.txt","locator":"build and repair request","sha256":"95eb1233ff0498c5bc96d5659b7f9538a89f98c4bdc916a61442cf5f3da41834"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Process and company policy","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"Source and repaired meshes remain distinct and the final 3MF and support preview bind to the reviewed repaired-mesh revision."},{"id":"PRINT02-SLICE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Process and company policy","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"The final slice uses installed P1S 0.4 mm PETG profiles, 0.20 mm layers, five walls and 40% infill without silent material substitution."},{"id":"PRINT02-ORIENTATION","mandatory":true,"review_required":true,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Process and company policy","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"A recorded review compares pads-down and side orientations, retains the selected support preview and identifies support-contact locations."},{"id":"PRINT02-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/prompt.txt","locator":"requested package","sha256":"95eb1233ff0498c5bc96d5659b7f9538a89f98c4bdc916a61442cf5f3da41834"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Process and company policy","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"The output set contains source mesh, repaired mesh, support preview, final 3MF and a digest-bound clearly simulated local transfer receipt."},{"id":"PRINT02-ACTION-SCOPE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/prompt.txt","locator":"prototype limitation","sha256":"95eb1233ff0498c5bc96d5659b7f9538a89f98c4bdc916a61442cf5f3da41834"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/printed-replacement-part/02-repair-cart-bow-handle/context.md","locator":"Work setting; Process and company policy","sha256":"2b4ad39c8d07368fa4d0b5bfb257625cbafe5098a0cc106ca80103929cc378ee"}],"text":"The prototype is not represented as a tested lifting/load-restraint handle or certified/fit-validated part, and no real printer connection or print is performed."}],"unresolved_decisions":[],"version":"1"}
