{"amendments":[],"id":"lightweight-equipment-bracket-02-basis","requirements":[{"id":"BRACKET02-GEOMETRY","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/dimensions.csv","locator":"all rows","sha256":"39a355e37976b3f8f1e54a5572f59d0c938a74ac97319e0754c4d354de2a2cbf"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Geometric definition","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"Baseline and revision preserve the declared back plate, shelf, two ribs, four Ø8.5 back holes, two Ø5.5 instrument holes, protected top pad and empty cable corridor."},{"id":"BRACKET02-MANUFACTURING","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Business constraints","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"The lighter single-billet 3-axis design respects 3 mm cutter radius, 4 mm wall and 8 mm material around bolt bores with no welds."},{"id":"BRACKET02-LOAD","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/load-case.csv","locator":"row:instrument_pull","sha256":"e44ad9c0339b61e3e4dd7f378951607b68ac8f6fef9418c9da16b4b2783cd48c"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Load and fixture","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"Both revisions use the distributed vector (60,0,-80) N on x=72..100,y=-25..25,z=72 and cylindrical restraints on all four back holes, preserving eccentricity."},{"id":"BRACKET02-MATERIAL","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Material and analysis basis","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"Both solves use homogeneous linear-elastic material E=69 GPa, ν=0.33 and density 2700 kg/m³."},{"id":"BRACKET02-RESPONSES","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Material and analysis basis","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"Load-point displacement is at most 0.50 mm and evaluated von Mises stress at most 120 MPa under a declared non-singular evaluation while retaining unfiltered fields."},{"id":"BRACKET02-REACTIONS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Load and fixture; Material and analysis basis","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"Support reaction force and moment balance the eccentric applied load and explicitly identify the bearing-restraint simplification."},{"id":"BRACKET02-REFINEMENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Material and analysis basis","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"Baseline and revision each retain consistent coarse/fine meshes with less than 5% change in declared response metrics."},{"id":"BRACKET02-MASS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/prompt.txt","locator":"15% target","sha256":"f8440a1a77991b74a68e1022c3f55759d0c7db7f5ec8d33937ab42dcb7e6ac1b"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Load and fixture","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"The revision is at least 15% lighter or the unmet target remains explicit without changing load, envelope, holes or keepouts."},{"id":"BRACKET02-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/prompt.txt","locator":"requested outputs","sha256":"f8440a1a77991b74a68e1022c3f55759d0c7db7f5ec8d33937ab42dcb7e6ac1b"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Test output request","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"The output set contains baseline/revised STEP, actual solver decks/results, displacement/stress fields, mass comparison and analysis report with exact lineage."},{"id":"BRACKET02-CLAIM-SCOPE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/02-pump-instrument-outrigger/context.md","locator":"Business constraints; Material and analysis basis; Test output request","sha256":"66825947c25c342d0e3e43064bb68e218c7b93cc0dfc47a145c6e12ac9efa582"}],"text":"The static prototype result does not claim fatigue, impact, joint behavior, material certification, a supplier quote or production release."}],"unresolved_decisions":[],"version":"1"}
