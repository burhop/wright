{"amendments":[],"id":"sensor-interface-pcb-03-basis","requirements":[{"id":"PCB03-CONNECTIVITY","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/netlist.csv","locator":"all rows","sha256":"9b3921fbbe3649577a2d9713568c898daf9f1415b4502d1f9f8228777f890210"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Business and system assumptions","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"Native schematic/PCB implement every supplied 24V/GND, 3V3, raw/output tach, pull-up, series-filter, capacitor and test-pad connection exactly, with no cross-channel bridge."},{"id":"PCB03-COMPATIBILITY","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Business and system assumptions","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"The report requires sourced confirmation that selected fans provide open-collector tach compatible with a 3.3 V pull-up and never accepts a push-pull 24 V tach output."},{"id":"PCB03-PARTS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/component-library.csv","locator":"all rows","sha256":"2d67e7c1cfa27391870f1440cfd745a0ea05089da95540ce6e6d933985bd2320"}],"text":"J1..J4, resistors, capacitors and TP1..TP5 match all declared footprints/values/ratings; exact production connectors remain unresolved until sourced."},{"id":"PCB03-POWER-ROUTING","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Layout requirements and limitations","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"Each fan power/return branch uses at least 1.0 mm track width, common supply/return at least 1.5 mm, and 24 V copper remains at least 0.8 mm from logic except defined ground connections."},{"id":"PCB03-PLACEMENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Layout requirements and limitations","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"J3/J4 centers remain (36,16.46)/(20,25.5) mm, TP3 center (32,14) mm, J2 origin (5,19) mm and TP1 origin (10,14) mm with required labels and routing corridor."},{"id":"PCB03-BOARD-RULES","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Board and shop requirements","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"The board is 40 by 30 mm, 1.6 mm two-layer/35 µm copper with declared NPTH holes, 1.0 mm hole-edge copper clearance, 0.25/0.25 mm minimum track/clearance and 0.30 mm via drill."},{"id":"PCB03-CHECKS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Business and system assumptions; Deliverables","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"Native connectivity, ERC and DRC finish with zero unreviewed errors while preserving power/logic-domain constraints and the 0..500 Hz tach assumption."},{"id":"PCB03-CORRESPONDENCE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Deliverables","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"Gerbers, drill and BOM correspond exactly to the same native schematic and routed board revision."},{"id":"PCB03-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/prompt.txt","locator":"requested outputs","sha256":"a5ed394604cd75c25a84820aa4a018fdf19802996b8b8da8818f318ad64c8e43"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Deliverables","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"The output set contains editable KiCad schematic/board, BOM, Gerber copper/outline, drill and ERC/DRC reports."},{"id":"PCB03-ACTION-SCOPE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/prompt.txt","locator":"passive-adapter scope","sha256":"a5ed394604cd75c25a84820aa4a018fdf19802996b8b8da8818f318ad64c8e43"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/sensor-interface-pcb/03-fan-tach-service-board/context.md","locator":"Layout requirements and limitations; Deliverables","sha256":"16524edc56f179eb4e4405c58f50c891802d50d0f6368881c4ed0fec048a398e"}],"text":"The passive adapter is not represented as a fan/safety controller, isolation barrier, production-qualified board or authorization to order hardware."}],"unresolved_decisions":[],"version":"1"}
