{"amendments":[],"id":"lightweight-equipment-bracket-01-basis","requirements":[{"id":"BRACKET01-GEOMETRY","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/dimensions.csv","locator":"all rows","sha256":"4a5521be30236d7119dd30b407fdb1770210541b063d1514a618582c30822e64"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Geometry and coordinate convention","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Baseline and revision preserve the declared wall/shelf envelope, both Ø6.6 wall holes, both Ø4.5 camera holes, 10 mm hole keepouts and complete camera contact surface."},{"id":"BRACKET01-MANUFACTURING","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Business and fabrication","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"The lighter single-solid machined design respects 6 mm minimum tool diameter, 3 mm internal radius and 3 mm residual wall without moving protected features."},{"id":"BRACKET01-LOAD","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/load-case.csv","locator":"row:service_100N","sha256":"da4230b103562f04aee83976960735df448b188114c0b5edb1e1b05aeef66618"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Fixture and load","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Both revisions use exactly the distributed (0,0,-100) N service load on x=60..85,y=-20..20,z=60 and cylindrical restraint on both wall holes; optional gravity remains separate."},{"id":"BRACKET01-MATERIAL","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Material and analysis basis","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Both solves use homogeneous linear-elastic material E=69 GPa, ν=0.33 and density 2700 kg/m³."},{"id":"BRACKET01-RESPONSES","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/load-case.csv","locator":"deflection_limit_mm,stress_limit_MPa","sha256":"da4230b103562f04aee83976960735df448b188114c0b5edb1e1b05aeef66618"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Material and analysis basis","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Load-point displacement is at most 0.50 mm and evaluated von Mises stress is at most 120 MPa in a declared non-singular evaluation region while the unfiltered stress field is retained."},{"id":"BRACKET01-REACTIONS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Material and analysis basis","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Reported support reactions balance the applied force/moment and identify the cylindrical-bearing/joint-compliance simplification."},{"id":"BRACKET01-REFINEMENT","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Material and analysis basis","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"Baseline and revision each retain consistent coarse/fine meshes with less than 5% change in declared response metrics."},{"id":"BRACKET01-MASS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/prompt.txt","locator":"20% target","sha256":"1bb108165a00c2c843c1e78abff9131eed5f0fc5b3cb46a2b0c3379a2c27cd37"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Fixture and load","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"The revision's independently calculated mass is at least 20% below baseline or the unmet target remains explicit without altering protected requirements."},{"id":"BRACKET01-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/prompt.txt","locator":"requested outputs","sha256":"1bb108165a00c2c843c1e78abff9131eed5f0fc5b3cb46a2b0c3379a2c27cd37"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Test output request","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"The output set contains baseline/revised STEP, actual CalculiX-compatible decks, displacement/stress fields, mass comparison and analysis report with exact revision/solve lineage."},{"id":"BRACKET01-CLAIM-SCOPE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/lightweight-equipment-bracket/01-conveyor-vision-mount/context.md","locator":"Material and analysis basis; Test output request","sha256":"ab451fb9eb9b79db2ee13d98503253633db06d687a8cddb1f36935c9a6be355f"}],"text":"The static prototype screening does not claim fatigue, impact, preload, joint slip, material certification or production release."}],"unresolved_decisions":[],"version":"1"}
