{"amendments":[],"id":"raspberry-pi-enclosure-02-basis","requirements":[{"id":"PI02-SOURCE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/prompt.txt","locator":"research request","sha256":"74ee2f275aa9a329f4bff83d02680efb854d3a99914ea73944cad5e2f58a458f"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Field context and research","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"Board and connector geometry uses a cited official Pi 5 source; nominal sketch geometry and any unsourced gland, filter or insert remain assumptions/unresolved."},{"id":"PI02-ENCLOSURE","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Mounting and service requirements","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"The 130×95×60 mm body, 145 mm ear centers/4.5 mm holes, 2.8 mm walls, removable lid, external ears, 30×18 mm underside cable exit, 35 mm drip-loop clearance and status-light access are preserved."},{"id":"PI02-LOADS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/thermal-loads.csv","locator":"all rows","sha256":"0626fe34c83915276b205a57c3641bfd16d3bf31b0315f150c9c46607f0e6a64"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Thermal and flow inputs","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"Matched models use 35 °C ambient, 6 W and 2 W sources at exact thermal-loads.csv geometry with 12 mm separation, gravity toward base and wall k=0.20 W/(m·K)."},{"id":"PI02-VARIANTS","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Thermal and flow inputs","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"Both variants share the lower inlet; one uses downward louvers and one a 20 mm top chimney, each within the body height envelope."},{"id":"PI02-SCREEN","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Thermal and flow inputs","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"Screen resistance is included only as a documented supported assumption; otherwise clear-opening results explicitly leave pressure loss unresolved."},{"id":"PI02-CFD","mandatory":true,"review_required":false,"scope":"design","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/prompt.txt","locator":"comparison request","sha256":"74ee2f275aa9a329f4bff83d02680efb854d3a99914ea73944cad5e2f58a458f"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Thermal and flow inputs","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"Actual comparable fields, convergence, balance and flow summaries evaluate the below-70 °C patch target and disclose debris/temperature tradeoffs."},{"id":"PI02-DELIVERABLES","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/prompt.txt","locator":"requested outputs","sha256":"74ee2f275aa9a329f4bff83d02680efb854d3a99914ea73944cad5e2f58a458f"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Organization policy","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"The output set contains reviewed sourced basis, both measurable CAD/STEP cases, matching fluid domains and field-backed CFD comparison."},{"id":"PI02-SCOPE","mandatory":true,"review_required":false,"scope":"content","sources":[{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/prompt.txt","locator":"rating limitation","sha256":"74ee2f275aa9a329f4bff83d02680efb854d3a99914ea73944cad5e2f58a458f"},{"artifact_ref":"tests/datasets/engineering-workflows/scenarios/raspberry-pi-enclosure/02-greenhouse-sensor-gateway/context.md","locator":"Thermal and flow inputs; Organization policy","sha256":"f290216d9269042ee2aa26d4fdd642757ddd048b6d23a665d6f6ced951031f13"}],"text":"The result claims no waterproof/IP, contamination, UV, moisture or physical qualification and performs no manufacture, device command or supplier transaction."}],"unresolved_decisions":[],"version":"1"}
