{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/schemas/rivet-capability-binding-v2.json",
  "title": "Rivet Provider-Neutral Capability Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "workspace_id",
    "workflow_id",
    "workflow_revision",
    "workflow_digest",
    "graph_id",
    "node_id",
    "node_handle",
    "qualified_tool_name",
    "server_id",
    "server_revision",
    "capability_digest",
    "validation_evidence_id",
    "workspace_grant_digest",
    "input_schema",
    "schema_digest",
    "risk",
    "units_policy",
    "material_defaults",
    "argument_constraints",
    "binding_digest",
    "created_at",
    "provider"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "binding_id": {
      "$ref": "#/$defs/nonempty"
    },
    "workspace_id": {
      "$ref": "#/$defs/nonempty"
    },
    "workflow_id": {
      "$ref": "#/$defs/nonempty"
    },
    "workflow_revision": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_digest": {
      "$ref": "#/$defs/digest"
    },
    "graph_id": {
      "$ref": "#/$defs/nonempty"
    },
    "node_id": {
      "$ref": "#/$defs/nonempty"
    },
    "node_handle": {
      "type": "string",
      "pattern": "^wright:[A-Za-z0-9_-]{16,128}$"
    },
    "requirement_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty"
        },
        {
          "type": "null"
        }
      ]
    },
    "qualified_tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}__[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "server_id": {
      "$ref": "#/$defs/nonempty"
    },
    "server_revision": {
      "$ref": "#/$defs/nonempty"
    },
    "capability_digest": {
      "$ref": "#/$defs/digest"
    },
    "validation_evidence_id": {
      "$ref": "#/$defs/nonempty"
    },
    "workspace_grant_digest": {
      "$ref": "#/$defs/digest"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_digest": {
      "$ref": "#/$defs/digest"
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classes",
        "effect_classes",
        "required_approvals",
        "idempotency"
      ],
      "properties": {
        "data_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "uniqueItems": true
        },
        "effect_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "uniqueItems": true
        },
        "required_approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "uniqueItems": true
        },
        "idempotency": {
          "enum": [
            "idempotent",
            "non_idempotent",
            "unknown"
          ]
        },
        "annotations_untrusted": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "units_policy": {
      "type": "object"
    },
    "material_defaults": {
      "type": "object"
    },
    "argument_constraints": {
      "type": "object"
    },
    "binding_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider_kind",
        "provider_id",
        "capability_id",
        "resource_class",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provider_kind": {
          "enum": [
            "mcp",
            "engineering_model"
          ]
        },
        "provider_id": {
          "$ref": "#/$defs/nonempty"
        },
        "capability_id": {
          "$ref": "#/$defs/nonempty"
        },
        "resource_class": {
          "enum": [
            "small",
            "medium",
            "large",
            "external"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "server_id",
                "server_revision",
                "tool_name",
                "validation_evidence_id",
                "workspace_grant_digest"
              ],
              "properties": {
                "server_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "server_revision": {
                  "$ref": "#/$defs/nonempty"
                },
                "tool_name": {
                  "$ref": "#/$defs/nonempty"
                },
                "validation_evidence_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "workspace_grant_digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_id",
                "package_revision",
                "manifest_digest",
                "variant_id",
                "artifact_set_digest",
                "installation_id",
                "installation_digest",
                "adapter_id",
                "adapter_version",
                "runtime_version",
                "test_evidence_id",
                "test_material_digest",
                "workspace_binding_digest",
                "task_id",
                "input_schema_digest",
                "output_schema_digest",
                "threshold",
                "resource_digest"
              ],
              "properties": {
                "model_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "package_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "manifest_digest": {
                  "$ref": "#/$defs/digest"
                },
                "variant_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "artifact_set_digest": {
                  "$ref": "#/$defs/digest"
                },
                "installation_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "installation_digest": {
                  "$ref": "#/$defs/digest"
                },
                "adapter_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "adapter_version": {
                  "$ref": "#/$defs/nonempty"
                },
                "runtime_version": {
                  "$ref": "#/$defs/nonempty"
                },
                "test_evidence_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "test_material_digest": {
                  "$ref": "#/$defs/digest"
                },
                "workspace_binding_digest": {
                  "$ref": "#/$defs/digest"
                },
                "task_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "input_schema_digest": {
                  "$ref": "#/$defs/digest"
                },
                "output_schema_digest": {
                  "$ref": "#/$defs/digest"
                },
                "threshold": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "exclusiveMaximum": 1
                    }
                  ]
                },
                "resource_digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider_kind": {
                "const": "mcp"
              }
            },
            "required": [
              "provider_kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "required": [
                  "server_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_kind": {
                "const": "engineering_model"
              }
            },
            "required": [
              "provider_kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "required": [
                  "model_id"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
