{
  "$defs": {
    "DependencySpec": {
      "properties": {
        "system": {
          "items": {
            "type": "string"
          },
          "title": "System",
          "type": "array"
        },
        "python": {
          "items": {
            "type": "string"
          },
          "title": "Python",
          "type": "array"
        },
        "node": {
          "items": {
            "type": "string"
          },
          "title": "Node",
          "type": "array"
        }
      },
      "title": "DependencySpec",
      "type": "object"
    },
    "CatalogSourceRecord": {
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "kind": {
          "default": "repository",
          "enum": [
            "repository",
            "vendor_docs",
            "package",
            "container",
            "release",
            "directory",
            "evidence",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "primary": {
          "default": true,
          "title": "Primary",
          "type": "boolean"
        },
        "authority": {
          "default": "unknown",
          "enum": [
            "vendor",
            "publisher",
            "community",
            "directory",
            "unknown"
          ],
          "title": "Authority",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "CatalogSourceRecord",
      "type": "object"
    },
    "EnvVarDefinition": {
      "description": "Metadata about an environment variable an MCP server needs.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "EnvVarDefinition",
      "type": "object"
    },
    "PlatformSupportRecord": {
      "properties": {
        "status": {
          "default": "unknown",
          "enum": [
            "yes",
            "likely",
            "host-dependent",
            "unknown",
            "no"
          ],
          "title": "Status",
          "type": "string"
        },
        "tested": {
          "default": false,
          "title": "Tested",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "PlatformSupportRecord",
      "type": "object"
    },
    "RuntimeRequirements": {
      "properties": {
        "cpu": {
          "default": "standard CPU",
          "title": "Cpu",
          "type": "string"
        },
        "gpu": {
          "default": "not required",
          "title": "Gpu",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "docker": {
          "default": "unknown",
          "enum": [
            "yes",
            "partial",
            "no",
            "unknown"
          ],
          "title": "Docker",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "RuntimeRequirements",
      "type": "object"
    },
    "ValidationSummary": {
      "properties": {
        "status": {
          "default": "not_tested",
          "enum": [
            "passed",
            "dependency_missing",
            "blocked",
            "failed",
            "skipped",
            "not_tested"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "Not yet validated in this environment",
          "title": "Message",
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "missing_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Missing Dependencies",
          "type": "array"
        },
        "validated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validated At"
        },
        "evidence_status": {
          "default": "unverified",
          "enum": [
            "recorded",
            "partial",
            "unverified"
          ],
          "title": "Evidence Status",
          "type": "string"
        }
      },
      "title": "ValidationSummary",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "vendor": {
      "title": "Vendor",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "transport": {
      "enum": [
        "stdio",
        "streamable_http",
        "sse",
        "webmcp"
      ],
      "title": "Transport",
      "type": "string"
    },
    "evidence_class": {
      "enum": [
        "official_production",
        "official_preview",
        "verified_community",
        "community_candidate",
        "user_reported_source_needed",
        "api_wrapper_candidate",
        "documentation_only",
        "blocked_validation",
        "excluded_or_stale"
      ],
      "type": ["string", "null"],
      "default": null
    },
    "command": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "string"
        }
      ],
      "title": "Command"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "repository_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Url"
    },
    "package_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Url"
    },
    "container_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Url"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "auth_model": {
      "default": "unknown",
      "enum": [
        "none",
        "api-key",
        "oauth",
        "desktop-session",
        "license-server",
        "local-host",
        "unknown"
      ],
      "title": "Auth Model",
      "type": "string"
    },
    "install_method": {
      "default": "unknown",
      "enum": [
        "packaged-binary",
        "uvx",
        "pip",
        "npm",
        "source",
        "docker",
        "remote-http",
        "desktop-extension",
        "manual",
        "unknown"
      ],
      "title": "Install Method",
      "type": "string"
    },
    "maturity": {
      "default": "community",
      "enum": [
        "official",
        "reference",
        "community",
        "experimental",
        "watchlist",
        "deprecated"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "capability_summary": {
      "items": {
        "type": "string"
      },
      "title": "Capability Summary",
      "type": "array"
    },
    "source_records": {
      "items": {
        "$ref": "#/$defs/CatalogSourceRecord"
      },
      "title": "Source Records",
      "type": "array"
    },
    "runtime_requirements": {
      "$ref": "#/$defs/RuntimeRequirements"
    },
    "image_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Url"
    },
    "locality": {
      "enum": [
        "local",
        "remote"
      ],
      "title": "Locality",
      "type": "string"
    },
    "weight": {
      "enum": [
        "light",
        "medium",
        "heavy"
      ],
      "title": "Weight",
      "type": "string"
    },
    "env_vars": {
      "items": {
        "$ref": "#/$defs/EnvVarDefinition"
      },
      "title": "Env Vars",
      "type": "array"
    },
    "launch_env": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Launch Env",
      "type": "object"
    },
    "dependencies": {
      "$ref": "#/$defs/DependencySpec"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "verification_state": {
      "default": "user_reported_url_needed",
      "enum": [
        "verified_mcp",
        "verified_docs_mcp",
        "community_mcp",
        "user_reported_url_needed",
        "verified_api_wrapper_candidate",
        "capability_alias",
        "ui_or_web_standard",
        "watchlist",
        "excluded"
      ],
      "title": "Verification State",
      "type": "string"
    },
    "installability_tier": {
      "default": "might_work",
      "enum": [
        "tested",
        "might_work",
        "blocked",
        "non_working"
      ],
      "title": "Installability Tier",
      "type": "string"
    },
    "risk_level": {
      "default": "low",
      "enum": [
        "read-only",
        "low",
        "medium",
        "high",
        "safety-critical"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "deployment_mode": {
      "default": "unknown",
      "title": "Deployment Mode",
      "type": "string"
    },
    "platform_support": {
      "additionalProperties": {
        "$ref": "#/$defs/PlatformSupportRecord"
      },
      "title": "Platform Support",
      "type": "object"
    },
    "host_software_required": {
      "items": {
        "type": "string"
      },
      "title": "Host Software Required",
      "type": "array"
    },
    "credentials_required": {
      "items": {
        "type": "string"
      },
      "title": "Credentials Required",
      "type": "array"
    },
    "default_enabled": {
      "default": true,
      "title": "Default Enabled",
      "type": "boolean"
    },
    "approval_gates": {
      "items": {
        "type": "string"
      },
      "title": "Approval Gates",
      "type": "array"
    },
    "validation_result": {
      "$ref": "#/$defs/ValidationSummary"
    },
    "follow_up_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Follow Up Url"
    },
    "install_blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Install Blocked Reason"
    }
  },
  "required": [
    "id",
    "name",
    "vendor",
    "description",
    "domains",
    "transport",
    "command",
    "locality",
    "weight"
  ],
  "title": "CatalogEntry",
  "type": "object"
}
