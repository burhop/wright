{
  "$defs": {
    "CatalogSourceRecord": {
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "kind": {
          "default": "repository",
          "enum": [
            "repository",
            "vendor_docs",
            "package",
            "container",
            "release",
            "directory",
            "evidence",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "primary": {
          "default": true,
          "title": "Primary",
          "type": "boolean"
        },
        "authority": {
          "default": "unknown",
          "enum": [
            "vendor",
            "publisher",
            "community",
            "directory",
            "unknown"
          ],
          "title": "Authority",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "CatalogSourceRecord",
      "type": "object"
    },
    "CurationDecision": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "default": "follow_up",
          "enum": [
            "curated",
            "follow_up",
            "removed"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "default": "Wright qualification has not been reviewed.",
          "maxLength": 2000,
          "title": "Reason",
          "type": "string"
        },
        "owner": {
          "default": "Wright catalog maintainers",
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "review_due": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Due"
        },
        "next_action": {
          "default": "Review sources and qualify a useful workflow through Wright.",
          "maxLength": 2000,
          "title": "Next Action",
          "type": "string"
        },
        "replacement_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Replacement Ids",
          "type": "array"
        },
        "adoption": {
          "default": "unknown",
          "enum": [
            "unknown",
            "publisher_reported",
            "independent_reports",
            "wright_repeat_use"
          ],
          "title": "Adoption",
          "type": "string"
        },
        "adoption_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Adoption Evidence",
          "type": "array"
        },
        "qualifications": {
          "items": {
            "$ref": "#/$defs/QualificationScope"
          },
          "maxItems": 30,
          "title": "Qualifications",
          "type": "array"
        }
      },
      "title": "CurationDecision",
      "type": "object"
    },
    "DependencySpec": {
      "properties": {
        "system": {
          "items": {
            "type": "string"
          },
          "title": "System",
          "type": "array"
        },
        "python": {
          "items": {
            "type": "string"
          },
          "title": "Python",
          "type": "array"
        },
        "node": {
          "items": {
            "type": "string"
          },
          "title": "Node",
          "type": "array"
        }
      },
      "title": "DependencySpec",
      "type": "object"
    },
    "EnvVarDefinition": {
      "description": "Metadata about an environment variable an MCP server needs.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "EnvVarDefinition",
      "type": "object"
    },
    "PlatformSupportRecord": {
      "properties": {
        "status": {
          "default": "unknown",
          "enum": [
            "yes",
            "likely",
            "host-dependent",
            "unknown",
            "no"
          ],
          "title": "Status",
          "type": "string"
        },
        "tested": {
          "default": false,
          "title": "Tested",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "PlatformSupportRecord",
      "type": "object"
    },
    "QualificationScope": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "windows_11_x64",
            "linux_x64",
            "linux_arm64",
            "macos_x64",
            "macos_arm64"
          ],
          "title": "Platform",
          "type": "string"
        },
        "environment": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Environment",
          "type": "string"
        },
        "distribution_mode": {
          "enum": [
            "native",
            "docker"
          ],
          "title": "Distribution Mode",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "workflow": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "wright_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Wright Revision",
          "type": "string"
        },
        "verified_at": {
          "format": "date",
          "title": "Verified At",
          "type": "string"
        },
        "expires_at": {
          "format": "date",
          "title": "Expires At",
          "type": "string"
        },
        "evidence_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence Path",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "protocol": {
          "const": "passed",
          "title": "Protocol",
          "type": "string"
        },
        "backend": {
          "const": "passed",
          "title": "Backend",
          "type": "string"
        },
        "gateway": {
          "const": "passed",
          "title": "Gateway",
          "type": "string"
        },
        "outcome": {
          "const": "passed",
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "environment",
        "distribution_mode",
        "configuration_sha256",
        "workflow",
        "source_revision",
        "wright_revision",
        "verified_at",
        "expires_at",
        "evidence_path",
        "evidence_sha256",
        "protocol",
        "backend",
        "gateway",
        "outcome"
      ],
      "title": "QualificationScope",
      "type": "object"
    },
    "RuntimeRequirements": {
      "properties": {
        "cpu": {
          "default": "standard CPU",
          "title": "Cpu",
          "type": "string"
        },
        "gpu": {
          "default": "not required",
          "title": "Gpu",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "docker": {
          "default": "unknown",
          "enum": [
            "yes",
            "partial",
            "no",
            "unknown"
          ],
          "title": "Docker",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "RuntimeRequirements",
      "type": "object"
    },
    "ValidationSummary": {
      "properties": {
        "status": {
          "default": "not_tested",
          "enum": [
            "passed",
            "dependency_missing",
            "blocked",
            "failed",
            "skipped",
            "not_tested"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "Not yet validated in this environment",
          "title": "Message",
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "missing_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Missing Dependencies",
          "type": "array"
        },
        "validated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validated At"
        },
        "evidence_status": {
          "default": "unverified",
          "enum": [
            "recorded",
            "partial",
            "unverified"
          ],
          "title": "Evidence Status",
          "type": "string"
        }
      },
      "title": "ValidationSummary",
      "type": "object"
    },
    "WindowsQualificationStatus": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": [
            "passed",
            "partial",
            "failed",
            "safety_blocked",
            "obsolete_or_unavailable",
            "not_applicable",
            "not_tested"
          ],
          "title": "Result",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "result",
        "label",
        "reason_code"
      ],
      "title": "WindowsQualificationStatus",
      "type": "object"
    },
    "WindowsQualificationSummary": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "evidence_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence Path",
          "type": "string"
        },
        "evidence_digest": {
          "title": "Evidence Digest",
          "type": "string"
        },
        "current": {
          "default": true,
          "title": "Current",
          "type": "boolean"
        },
        "stale_reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Stale Reasons",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "package_or_registration": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "startup": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "protocol": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "host_or_backend": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "wright_setup": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "gateway": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "cleanup": {
          "$ref": "#/$defs/WindowsQualificationStatus"
        },
        "claim": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim"
        }
      },
      "required": [
        "observed_at",
        "evidence_path",
        "evidence_digest",
        "source",
        "package_or_registration",
        "startup",
        "protocol",
        "host_or_backend",
        "wright_setup",
        "gateway",
        "cleanup"
      ],
      "title": "WindowsQualificationSummary",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "vendor": {
      "title": "Vendor",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "engineering_stages": {
      "items": {
        "enum": [
          "requirements",
          "concept",
          "design",
          "simulation",
          "sourcing",
          "manufacturing",
          "test_quality",
          "release",
          "operations"
        ],
        "type": "string"
      },
      "title": "Engineering Stages",
      "type": "array"
    },
    "integration_kind": {
      "default": "mcp_server",
      "enum": [
        "mcp_server",
        "webmcp_application",
        "protocol_reference",
        "api_candidate",
        "capability_alias",
        "agent_skills"
      ],
      "title": "Integration Kind",
      "type": "string"
    },
    "hardware_standard": {
      "default": "none",
      "enum": [
        "none",
        "hardware_mcp",
        "mhs_preview"
      ],
      "title": "Hardware Standard",
      "type": "string"
    },
    "curation": {
      "$ref": "#/$defs/CurationDecision"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "transport": {
      "enum": [
        "stdio",
        "streamable_http",
        "sse",
        "webmcp"
      ],
      "title": "Transport",
      "type": "string"
    },
    "command": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "string"
        }
      ],
      "title": "Command"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "repository_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Url"
    },
    "package_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Url"
    },
    "container_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Url"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "auth_model": {
      "default": "unknown",
      "enum": [
        "none",
        "api-key",
        "oauth",
        "desktop-session",
        "license-server",
        "local-host",
        "unknown"
      ],
      "title": "Auth Model",
      "type": "string"
    },
    "install_method": {
      "default": "unknown",
      "enum": [
        "packaged-binary",
        "uvx",
        "pip",
        "npm",
        "source",
        "docker",
        "remote-http",
        "desktop-extension",
        "manual",
        "unknown"
      ],
      "title": "Install Method",
      "type": "string"
    },
    "maturity": {
      "default": "community",
      "enum": [
        "official",
        "reference",
        "community",
        "experimental",
        "watchlist",
        "deprecated"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "evidence_class": {
      "anyOf": [
        {
          "enum": [
            "official_production",
            "official_preview",
            "verified_community",
            "community_candidate",
            "user_reported_source_needed",
            "api_wrapper_candidate",
            "documentation_only",
            "blocked_validation",
            "excluded_or_stale"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Class"
    },
    "capability_summary": {
      "items": {
        "type": "string"
      },
      "title": "Capability Summary",
      "type": "array"
    },
    "data_touched": {
      "items": {
        "type": "string"
      },
      "title": "Data Touched",
      "type": "array"
    },
    "examples": {
      "items": {
        "type": "string"
      },
      "title": "Examples",
      "type": "array"
    },
    "source_records": {
      "items": {
        "$ref": "#/$defs/CatalogSourceRecord"
      },
      "title": "Source Records",
      "type": "array"
    },
    "runtime_requirements": {
      "$ref": "#/$defs/RuntimeRequirements"
    },
    "image_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Url"
    },
    "locality": {
      "enum": [
        "local",
        "remote"
      ],
      "title": "Locality",
      "type": "string"
    },
    "weight": {
      "enum": [
        "light",
        "medium",
        "heavy"
      ],
      "title": "Weight",
      "type": "string"
    },
    "env_vars": {
      "items": {
        "$ref": "#/$defs/EnvVarDefinition"
      },
      "title": "Env Vars",
      "type": "array"
    },
    "launch_env": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Launch Env",
      "type": "object"
    },
    "dependencies": {
      "$ref": "#/$defs/DependencySpec"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "verification_state": {
      "default": "user_reported_url_needed",
      "enum": [
        "verified_mcp",
        "verified_docs_mcp",
        "community_mcp",
        "user_reported_url_needed",
        "verified_api_wrapper_candidate",
        "capability_alias",
        "ui_or_web_standard",
        "watchlist",
        "excluded"
      ],
      "title": "Verification State",
      "type": "string"
    },
    "installability_tier": {
      "default": "might_work",
      "enum": [
        "tested",
        "might_work",
        "blocked",
        "non_working"
      ],
      "title": "Installability Tier",
      "type": "string"
    },
    "risk_level": {
      "default": "low",
      "enum": [
        "read-only",
        "low",
        "medium",
        "high",
        "safety-critical"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "deployment_mode": {
      "default": "unknown",
      "title": "Deployment Mode",
      "type": "string"
    },
    "platform_support": {
      "additionalProperties": {
        "$ref": "#/$defs/PlatformSupportRecord"
      },
      "title": "Platform Support",
      "type": "object"
    },
    "host_software_required": {
      "items": {
        "type": "string"
      },
      "title": "Host Software Required",
      "type": "array"
    },
    "credentials_required": {
      "items": {
        "type": "string"
      },
      "title": "Credentials Required",
      "type": "array"
    },
    "default_enabled": {
      "default": true,
      "title": "Default Enabled",
      "type": "boolean"
    },
    "approval_gates": {
      "items": {
        "type": "string"
      },
      "title": "Approval Gates",
      "type": "array"
    },
    "validation_result": {
      "$ref": "#/$defs/ValidationSummary"
    },
    "windows_qualification": {
      "anyOf": [
        {
          "$ref": "#/$defs/WindowsQualificationSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "follow_up_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Follow Up Url"
    },
    "install_blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Install Blocked Reason"
    }
  },
  "required": [
    "id",
    "name",
    "vendor",
    "description",
    "domains",
    "transport",
    "command",
    "locality",
    "weight"
  ],
  "title": "CatalogEntry",
  "type": "object"
}
