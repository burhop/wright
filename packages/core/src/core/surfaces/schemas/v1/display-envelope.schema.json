{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wright.local/schemas/display-envelope-v1.json",
  "title": "Wright Display Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "displayId", "revision", "representations", "accessibility"],
  "properties": {
    "schemaVersion": {"const": 1},
    "displayId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "idempotencyKey": {"type": "string", "minLength": 16, "maxLength": 128},
    "title": {"type": "string", "maxLength": 256},
    "durability": {"enum": ["durable", "session", "ephemeral"], "default": "durable"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "aspectRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 4096},
        "dataTableRepresentation": {"type": "integer", "minimum": 0}
      }
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/representation"}
    },
    "producerMetadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"maxLength": 64},
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
    }
  },
  "$defs": {
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "encoding", "data"],
      "properties": {
        "mediaType": {
          "enum": [
            "text/plain",
            "text/html",
            "image/png",
            "image/jpeg",
            "image/svg+xml",
            "application/vnd.wright.table+json",
            "application/vnd.plotly.v1+json"
          ]
        },
        "encoding": {"enum": ["utf-8", "base64", "json"]},
        "data": {},
        "metadata": {"type": "object", "maxProperties": 32},
        "activeHtml": {"type": "boolean", "default": false},
        "fallbackRank": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "allOf": [
        {
          "if": {"properties": {"encoding": {"const": "base64"}}, "required": ["encoding"]},
          "then": {"properties": {"data": {"type": "string", "contentEncoding": "base64", "maxLength": 16777216}}}
        },
        {
          "if": {"properties": {"encoding": {"const": "utf-8"}}, "required": ["encoding"]},
          "then": {"properties": {"data": {"type": "string", "maxLength": 4194304}}}
        },
        {
          "if": {"properties": {"mediaType": {"const": "text/html"}, "activeHtml": {"const": true}}, "required": ["mediaType", "activeHtml"]},
          "then": {"properties": {"encoding": {"const": "utf-8"}}}
        },
        {
          "if": {"properties": {"mediaType": {"enum": ["image/png", "image/jpeg"]}}, "required": ["mediaType"]},
          "then": {"properties": {"encoding": {"const": "base64"}, "data": {"type": "string", "contentEncoding": "base64", "maxLength": 16777216}}}
        },
        {
          "if": {"properties": {"mediaType": {"enum": ["text/plain", "text/html", "image/svg+xml"]}}, "required": ["mediaType"]},
          "then": {"properties": {"encoding": {"const": "utf-8"}, "data": {"type": "string", "maxLength": 4194304}}}
        },
        {
          "if": {"properties": {"mediaType": {"enum": ["application/vnd.wright.table+json", "application/vnd.plotly.v1+json"]}}, "required": ["mediaType"]},
          "then": {"properties": {"encoding": {"const": "json"}, "data": {"type": ["object", "array"]}}}
        },
        {
          "if": {"not": {"properties": {"mediaType": {"const": "text/html"}}, "required": ["mediaType"]}},
          "then": {"properties": {"activeHtml": {"const": false}}}
        }
      ]
    }
  }
}
