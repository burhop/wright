# Workspace Surfaces rollout (all capabilities are default-off)
WRIGHT_SURFACES_ENABLED=0
VITE_WORKSPACE_SURFACES_ENABLED=0
WRIGHT_SURFACES_DISPLAY_ENABLED=0
WRIGHT_SURFACES_LIVE_APPS_ENABLED=0
WRIGHT_SURFACES_MCP_APPS_ENABLED=0
WRIGHT_SURFACES_WEBMCP_ENABLED=0

# Isolated preview origins. Hosted deployments must provide a wildcard domain.
WRIGHT_SURFACE_PREVIEW_SCHEME=http
WRIGHT_SURFACE_PREVIEW_BIND_HOST=127.0.0.1
WRIGHT_SURFACE_PREVIEW_DOMAIN=localhost
WRIGHT_SURFACE_PREVIEW_PORT=8000

# Workspace Surfaces contract-version 1 fallback policy
WRIGHT_SURFACE_MAX_APPS=8
WRIGHT_SURFACE_MAX_STARTS=2
WRIGHT_SURFACE_MAX_PROCESSES=32
WRIGHT_SURFACE_CPU_CORES=2.0
WRIGHT_SURFACE_MEMORY_MIB=2048
WRIGHT_SURFACE_RESTART_ATTEMPTS=2
WRIGHT_SURFACE_RESTART_WINDOW_SECONDS=300
WRIGHT_SURFACE_STARTUP_TIMEOUT_SECONDS=30
WRIGHT_SURFACE_GRACEFUL_STOP_SECONDS=5
WRIGHT_SURFACE_CLEANUP_SECONDS=5
WRIGHT_SURFACE_STOP_TIMEOUT_SECONDS=10
WRIGHT_SURFACE_MAX_HEADER_COUNT=100
WRIGHT_SURFACE_MAX_HEADER_BYTES=65536
WRIGHT_SURFACE_MAX_REQUEST_BYTES=16777216
WRIGHT_SURFACE_MAX_RESPONSE_BYTES=67108864
WRIGHT_SURFACE_MAX_DECODED_BYTES=67108864
WRIGHT_SURFACE_MAX_DECOMPRESSION_RATIO=8
WRIGHT_SURFACE_MAX_BUFFERED_BYTES=4194304
WRIGHT_SURFACE_MAX_CONNECTIONS=128
WRIGHT_SURFACE_REQUESTS_PER_MINUTE=300
WRIGHT_SURFACE_REQUEST_BURST=60
WRIGHT_SURFACE_STREAM_BYTES_PER_SECOND=8388608
WRIGHT_SURFACE_STREAM_BURST_BYTES=16777216
WRIGHT_SURFACE_BRIDGE_MESSAGES_PER_MINUTE=60
WRIGHT_SURFACE_BRIDGE_MESSAGE_BURST=20
WRIGHT_SURFACE_WS_MESSAGE_BYTES=4194304
WRIGHT_SURFACE_WS_MESSAGES_PER_SECOND=100
WRIGHT_SURFACE_WS_MESSAGE_BURST=200
WRIGHT_SURFACE_FIRST_BYTE_SECONDS=30
WRIGHT_SURFACE_HTTP_IDLE_SECONDS=60
WRIGHT_SURFACE_STREAM_IDLE_SECONDS=90
WRIGHT_SURFACE_CONNECTION_LIFETIME_SECONDS=28800
WRIGHT_SURFACE_CAPTURED_LOG_BYTES=10485760
WRIGHT_SURFACE_LOG_BYTES_PER_SECOND=262144
WRIGHT_SURFACE_LOG_BURST_BYTES=1048576
WRIGHT_SURFACE_DISPLAY_REPRESENTATIONS=12
