# Force LF line endings for shell scripts so they run correctly in bash/Docker
*.sh text eol=lf
docker/mcp/brep-mcp-launcher.cjs text eol=lf

# Versioned Workspace Surface contracts are byte-hashed. Keep their source and
# packaged copies identical on Windows and POSIX checkouts.
specs/053-workspace-surfaces/contracts/** text eol=lf
packages/core/src/core/surfaces/schemas/** text eol=lf

# Validator baselines are byte-hashed and copied into installed runtime profiles.
packages/workspace_service/src/workspace_service/process_validation/baselines/*.json text eol=lf
packages/workspace_service/src/workspace_service/process_validation/profiles/*.md text eol=lf
packages/workspace_service/src/workspace_service/process_validation/profiles/*.json text eol=lf
tests/datasets/process-validation/** text eol=lf
specs/082-output-content-validation/contracts/schemas/*.json text eol=lf

# Retained process-validation demonstrations carry their own byte manifests.
# Store and check out every evidence file exactly as hashed by the runner.
artifacts/process-validation/** -text -whitespace

# Exact native CAD/solver outputs and their recorded hashes are proof evidence.
# Preserve original bytes, including the native STEP writer's whitespace.
artifacts/process-interfaces/083/20261002-live-heat-analysis/** -text -whitespace
artifacts/process-interfaces/083/20261002-live-heat-interface/** -text -whitespace

# Process-definition contracts are byte-hashed and installed byte-for-byte.
specs/078-process-definition-view/contracts/*.json text eol=lf
src/wright_engineering/static/process-definitions/*.json text eol=lf

# Dataset manifests and text inputs below are protected by recorded SHA-256
# identities. Prevent checkout policy from changing their bytes on Windows.
tests/fixtures/blender_mcp_5f8ddaf6/src/blender_mcp/safe_mode.py text eol=lf
tests/datasets/engineering-workflows/scenarios/sheet-metal-supplier-handoff/**/*.csv text eol=lf
tests/datasets/engineering-workflows/scenarios/sheet-metal-supplier-handoff/**/*.json text eol=lf
tests/datasets/engineering-workflows/scenarios/sheet-metal-supplier-handoff/**/*.md text eol=lf
tests/datasets/engineering-workflows/scenarios/sheet-metal-supplier-handoff/**/*.svg text eol=lf
tests/datasets/engineering-workflows/scenarios/sheet-metal-supplier-handoff/**/*.txt text eol=lf
tests/datasets/engineering-workflows/revisions/2026-09-12-sheet-capabilities-r4/**/*.json text eol=lf

# Qualification evidence is byte-addressed by the catalog. Preserve the
# canonical UTF-8/LF bytes used to calculate each recorded evidence digest.
docs/mcp-catalog/evidence/** text eol=lf

# Browser verification screenshots are binary evidence and must not be
# normalized by the text rule above.
docs/mcp-catalog/evidence/**/*.png binary

# Office deliverables are ZIP packages. Keep them byte-for-byte intact even
# when they live beside canonical text evidence.
docs/mcp-catalog/evidence/**/deliverables/*.docx binary
docs/mcp-catalog/evidence/**/deliverables/*.pptx binary

# Generated Vite bundles are byte-addressed release inputs. Preserve their exact
# bytes across platforms; shader source also contains significant whitespace.
src/wright_engineering/static/web/** -text -whitespace

# The pinned Rivet 2 bundle is verified byte-for-byte. Monaco language data uses
# significant trailing spaces inside generated JavaScript template literals.
integrations/rivet/editor/dist/** -text -whitespace

# The pinned Rivet runner is likewise verified byte-for-byte during packaging.
# Its generated dependencies contain significant whitespace.
integrations/rivet/runner/dist/** -text -whitespace

# Rivet patches and Wright's editor wrapper are also covered by the pinned
# manifest. Force their canonical LF bytes on every platform so a Windows
# checkout and the packaged wheel verify against the same recorded digests.
# Unified-diff blank context lines intentionally contain one leading space.
integrations/rivet/editor/patches/** text eol=lf -whitespace
integrations/rivet/editor/wrapper/** text eol=lf
integrations/rivet/runner/src/** text eol=lf

# Captured native qualification files are hash-bound; do not normalize bytes.
artifacts/campaign-example-renewal/qualification/harness-native-20260922/** -text whitespace=cr-at-eol
artifacts/engineering-workflow-datasets/retry-evidence/heat01-aluminum-scope-902.json -text whitespace=cr-at-eol

# Private digital-process proof records retain their captured byte identities.
artifacts/process-interfaces/083/20261002-wheel-preparation-review/** -text -whitespace
artifacts/process-interfaces/083/20261002-wheel-native-capability-recovery/** -text -whitespace
artifacts/process-interfaces/083/20261002-wheel-retained-native-export/** -text -whitespace
artifacts/process-interfaces/083/20261002-wheel-ai-file-handoff/** -text -whitespace
artifacts/process-interfaces/083/20261002-shared-working-controls/** -text -whitespace
