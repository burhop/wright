      "name": "Wright qualification coupon 2026-10-11",
      "kind": "part",
      "code": "\"\"\"Gateway qualification coupon; not a load-qualified equipment mount.\nDimensions are mm: 50 x 30 x 3 plate, four 4.5 mm through holes at +/-18, +/-8.\n\"\"\"\nfrom steve import Model\nlength = 50  # mm Plate length\nwidth = 30  # mm Plate width\nthickness = 3  # mm Plate thickness\nhole_diameter = 4.5  # mm Through-hole diameter\nmodel = Model()\nwith model.sketch(\"outline\", on=\"XY\", name=\"Coupon outline\") as s:\n    s.rect(\"r1\", (-length/2, -width/2), (length/2, width/2))\nmodel.extrude(\"plate\", \"outline\", distance=thickness)\nmodel.hole(\"mount_holes\", on=\"plate.end\", points=[(-18,-8),(-18,8),(18,-8),(18,8)], diameter=hole_diameter)\nresult = model.result()\n"
    }
