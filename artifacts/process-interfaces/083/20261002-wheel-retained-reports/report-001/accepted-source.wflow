workflow retained_report_001
  name: "Retained focus-wheel preparation report"
  purpose: "Independent report of actual retained tool outputs; no construction, repair, slice, acceptance or transfer."
  discipline: "additive.manufacturing"
  reviewed_ai_suggestions: true
end

