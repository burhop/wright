  outputs: [{"key":"summarize_preparation_retained_consumer_002_result","name":"summarize preparation retained consumer 002 result","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"}]
  settings: {"output_format":"json","save_output":true,"output_filename":"process-proofs/printed-replacement-part/retained-consumer-002/outputs/source-report.json","file_policy":"overwrite","authoring_template":"mcp-task","mcp_server":"wright-workspace-files","max_tool_calls":8,"timeout_seconds":180,"expected_files":"","task_guidance":"Use only actual selected tools; retain raw failures and observations. Never fabricate files, measurements, reviews or provider approval."}
  tool: null
  reusable_step: null
  prompt: "Use inspect_file to read the actual geometry reports, slice evidence and recorded package/mesh hashes. Summarize construction, socket interpretation, repair, orientation/support consequences, exact PETG settings and nominal toolpaths. Separate design values from measured dimensions and future physical fit. The preview is nominal toolpath data, not completed printing. Retain all original mandatory limits and unresolved review requirements. Do not invent measurements, successful printing, fit, strength or a critic/human verdict. Construction belongs to the supplied retained producer, not this consumer. Describe its exact run/source/artifact lineage and terminal status without claiming the failed producer completed. This run performs new repair/slicing and full original assessment; input origin records are supplied evidence, not authenticated engineering acceptance. The repair operation must actually import the retained STL and export the unmodified imported geometry as this consumer's source_mesh.stl before repair. That native export is derived geometry, not byte identity with the retained STL."
end

