workflow external_mesh_qualification
  name: "Independent geometry-to-slice runtime qualification"
  purpose: "Qualify actual handoffs through the accepted source runtime without physical dispatch or engineering-assignment acceptance"
  discipline: "engineering.integration"
  reviewed_ai_suggestions: true
end

