  settings: {"output_format":"json","save_output":true,"output_filename":"process-proofs/printed-replacement-part/mixed-default-071/outputs/{{wright.run_id}}/source-report.json","file_policy":"overwrite","run_path_template":"wright.run-path/1","authoring_template":"mcp-task","mcp_server":"wright-workspace-files","max_tool_calls":2,"timeout_seconds":360,"expected_files":"","task_guidance":"Use only actual selected tools; retain raw failures and observations. Never fabricate files, measurements, reviews or provider approval.","mcp_task_tools":["inspect_file"]}
