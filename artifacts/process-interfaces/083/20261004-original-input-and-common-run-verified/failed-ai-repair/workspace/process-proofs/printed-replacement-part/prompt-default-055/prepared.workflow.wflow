  outputs: [{"key":"summarize_preparation_prompt_default_055_result","name":"summarize preparation prompt default 055 result","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"}]
  settings: {"output_format":"json","save_output":true,"output_filename":"process-proofs/printed-replacement-part/prompt-default-055/outputs/{{wright.run_id}}/source-report.json","file_policy":"overwrite","run_path_template":"wright.run-path/1","authoring_template":"mcp-task","mcp_server":"wright-workspace-files","max_tool_calls":2,"timeout_seconds":360,"expected_files":"","task_guidance":"Use only actual selected tools; retain raw failures and observations. Never fabricate files, measurements, reviews or provider approval.","mcp_task_tools":["inspect_file"]}
  tool: null
  reusable_step: null
  prompt: "The connected construction and repair results and original requirements are supplied reference material. Read those results directly; do not guess report filenames or reread supplied content. Use inspect_file exactly once for each connected slice_evidence and toolpath_summary workspace-file reference, using its verified relative path with includeText=true and maxTextBytes=65536. Those bounded records contain the actual package/mesh identity and profile observations; do not read raw profiles, G-code or the full support preview. Return the report after those two inspections; Wright saves it, so do not call a writing tool. Summarize construction, socket interpretation, repair, orientation/support consequences, exact PETG settings and nominal toolpaths. Separate design values from measured dimensions and future physical fit. The preview is nominal toolpath data, not completed printing. Retain all original mandatory limits and unresolved review requirements. Do not invent measurements, successful printing, fit, strength or a critic/human verdict. Return one compact JSON object under 6000 characters, with artifact_lineage, geometry_observations, preparation_observations, outstanding_requirements, limitations and engineering_acceptance=false."
end

