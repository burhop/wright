  performed_by: "ai_assisted"
  inputs: [{"key":"define_geometry_basis_prompt_default_055_supplied_geometry_basis","name":"define geometry basis prompt default 055 supplied geometry basis","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"},{"key":"define_geometry_basis_prompt_default_055_concept_png","name":"define geometry basis prompt default 055 concept png","kind":"reference_images","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"},{"key":"define_geometry_basis_prompt_default_055_concept_svg","name":"define geometry basis prompt default 055 concept svg","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"},{"key":"define_geometry_basis_prompt_default_055_context_md","name":"define geometry basis prompt default 055 context md","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"},{"key":"define_geometry_basis_prompt_default_055_prompt_txt","name":"define geometry basis prompt default 055 prompt txt","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"},{"key":"define_geometry_basis_prompt_default_055_scenario_json","name":"define geometry basis prompt default 055 scenario json","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"},{"key":"define_geometry_basis_prompt_default_055_user_profile_md","name":"define geometry basis prompt default 055 user profile md","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"},{"key":"define_geometry_basis_prompt_default_055_mandatory_requirements","name":"define geometry basis prompt default 055 mandatory requirements","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"}]
  outputs: [{"key":"define_geometry_basis_prompt_default_055_result","name":"define geometry basis prompt default 055 result","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Original input or exact same-run evidence"}]
  settings: {"output_format":"json","save_output":true,"output_filename":"process-proofs/printed-replacement-part/prompt-default-055/outputs/{{wright.run_id}}/geometry-basis.json","file_policy":"overwrite","run_path_template":"wright.run-path/1"}
  tool: null
  reusable_step: null
  prompt: "Prepare a complete proposed digital geometry design for the next declared review, separating supplied requirements from your proposed construction choices. Preserve the 38 mm maximum diameter, 18 mm overall height including 2 mm front hub, six equally spaced shallow scallops, >=33 mm minimum grip, nominal 1 mm exposed rounds and subtle grip dots. The D socket uses the 6.00 mm round boundary and 5.20 mm across-flat shaft with 0.20 mm radial and flat clearance, 10 mm blind depth and >=3 mm material above it. No insert, set screw, taper or keyway. Preserve PETG/P1S 0.4/0.20 mm/four walls/35% profiles, proposed +/-0.25 mm non-mating tolerance and original human-review requirements. Propose explicit numeric scallop profile/depth/phase, hub diameter, dot count/dimensions/placement and exposed-edge treatment within the original limits; derive and record the D-boundary/flat construction and depth direction. These are design proposals, not additional requirements or verified fit. Distinguish decisions that must be resolved at this declared basis review from later inspection of actual geometry, supports and final package. Do not leave a predictable construction choice to a later unattended question. No geometry, fit, strength, standards or print-success claim yet. Do not ask runtime questions; output one complete proposal for the declared review. Keep the entire response below 3000 characters. Return only one valid JSON object, with no markdown, comments or trailing commas. Use these keys: supplied_requirements (short object), proposed_geometry (numeric dimensions plus short construction descriptions for scallops, hub, dots, rounds, socket and orientation), basis_review (short list of proposed choices requiring this review), remaining_verification (short list), engineering_acceptance (false). Expressions must be JSON strings; do not put equations in numeric values. Do not repeat input documents or provide lengthy rationale. This run supplies an explicit prior proposed geometry basis. Retain its numeric construction choices exactly instead of proposing replacements. It remains a proposal for this run's declared review, not engineering acceptance. Actual geometry and all original mandatory checks still follow."
end

