workflow external_slice_qualification
  name: "Independent slice runtime qualification"
  purpose: "Qualify actual tool handoffs through the accepted source runtime without physical dispatch"
  discipline: "engineering.integration"
  reviewed_ai_suggestions: true
end

task qualified_geometry
  name: "Create isolated qualification geometry"
  purpose: "Actual small native geometry for stage integration; not the engineering assignment"
  step_type: "work"
  group: null
  performed_by: "configured_tool"
  inputs: []
  outputs: [{"key":"geometry_result","name":"geometry result","kind":"engineering_document","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"},{"key":"source_mesh","name":"source mesh","kind":"workspace_file","item":null,"required":true,"quantity":"one","description":"Campaign input or same-run output"}]
  prompt: ""
  tool: null
  reusable_step: null
  settings: {"authoring_template":"mcp-tool","mcp_server":"qualification-083-runtime-geometry","mcp_tool":"qualification-083-runtime-geometry__execute_blender_code","mcp_schema_digest":"6cd14e6d7c0b7e324888aca1b0864feed02eadc836fca9c709dedb06c16b1003","mcp_arguments":"{\"code\": \"import bpy\\nbpy.ops.mesh.primitive_cube_add(size=1)\\nobj=bpy.context.object\\nobj.name='RuntimeQualificationCube'\\nobj.dimensions=(10,8,6)\\nbpy.ops.object.transform_apply(location=False,rotation=False,scale=True)\\nbpy.ops.wm.stl_export(filepath='/workspace/qualification/artifacts/source_mesh.stl',export_selected_objects=True)\\nprint('Actual qualification geometry exported: 10 x 8 x 6 model units')\\n\", \"user_prompt\": \"resume\"}","output_format":"json","save_output":true,"output_filename":"qualification/artifacts/geometry-response.json","file_policy":"overwrite","expected_files":"qualification/artifacts/source_mesh.stl","expected_file_ports":{"source_mesh":"qualification/artifacts/source_mesh.stl"},"timeout_seconds":600}
end

